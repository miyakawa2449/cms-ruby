<% content_for :title, "#{@category[:name]} - Technical Blog" %>

<div class="bg-gray-50">
  <!-- Custom Header for Category Page -->
  <header class="fixed top-0 w-full bg-white/90 backdrop-blur-sm border-b border-gray-200 z-50">
    <nav class="container mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-8">
          <%= link_to blog_path, class: "flex items-center space-x-2 text-blue-600 hover:text-blue-800 transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>ブログトップ</span>
          <% end %>
          <div class="text-xl font-bold text-gray-900">
            Technical Blog
          </div>
        </div>
        <div class="hidden md:flex items-center space-x-6">
          <%= link_to 'AI・機械学習', blog_category_path('ai-ml'), class: "text-gray-700 hover:text-blue-600 transition-colors" %>
          <%= link_to 'Ruby/Rails', blog_category_path('ruby-rails'), class: "text-gray-700 hover:text-blue-600 transition-colors" %>
          <%= link_to '要件定義・設計', blog_category_path('requirements'), class: "text-gray-700 hover:text-blue-600 transition-colors" %>
          <%= link_to 'インフラ・デプロイ', blog_category_path('infrastructure'), class: "text-gray-700 hover:text-blue-600 transition-colors" %>
        </div>
        <div class="flex items-center space-x-4">
          <div class="relative">
            <input type="search" placeholder="カテゴリ内を検索..." class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent w-64">
            <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>
      </div>
    </nav>
  </header>

  <!-- Hero Section -->
  <section class="category-hero text-white pt-20">
    <div class="container mx-auto px-6 py-16 text-center">
      <div class="max-w-4xl mx-auto">
        <div class="text-6xl mb-6"><%= @category[:icon] %></div>
        <h1 class="text-4xl md:text-5xl font-bold mb-6">
          <%= @category[:name] %>
        </h1>
        <p class="text-xl text-purple-100 mb-8 leading-relaxed">
          <%= @category[:description] %><br>
          30年のキャリアで培った実戦的な技術情報をお届け
        </p>
        <div class="flex justify-center items-center space-x-8 text-purple-100">
          <div class="text-center">
            <div class="text-2xl font-bold"><%= @category[:article_count] %></div>
            <div class="text-sm">記事数</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold">5.2k</div>
            <div class="text-sm">月間PV</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold">4.7</div>
            <div class="text-sm">平均評価</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter & Sort -->
  <section class="bg-white border-b py-6">
    <div class="container mx-auto px-6">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between space-y-4 md:space-y-0">
          <div class="flex flex-wrap gap-2">
            <button class="filter-button active px-4 py-2 rounded-full border transition-colors">
              すべて (<%= @category[:article_count] %>)
            </button>
            <% if @slug == 'ai-ml' %>
              <button class="filter-button px-4 py-2 rounded-full border border-purple-200 text-purple-600 hover:bg-purple-50">
                ChatGPT API (8)
              </button>
              <button class="filter-button px-4 py-2 rounded-full border border-purple-200 text-purple-600 hover:bg-purple-50">
                機械学習 (5)
              </button>
              <button class="filter-button px-4 py-2 rounded-full border border-purple-200 text-purple-600 hover:bg-purple-50">
                業務効率化 (3)
              </button>
            <% elsif @slug == 'ruby-rails' %>
              <button class="filter-button px-4 py-2 rounded-full border border-red-200 text-red-600 hover:bg-red-50">
                パフォーマンス (10)
              </button>
              <button class="filter-button px-4 py-2 rounded-full border border-red-200 text-red-600 hover:bg-red-50">
                セキュリティ (8)
              </button>
              <button class="filter-button px-4 py-2 rounded-full border border-red-200 text-red-600 hover:bg-red-50">
                テスト (6)
              </button>
            <% end %>
          </div>

          <div class="flex items-center space-x-4">
            <span class="text-gray-600 text-sm">並び順:</span>
            <select class="border border-gray-300 rounded-md px-3 py-1 text-sm focus:ring-2 focus:ring-purple-500">
              <option value="latest">最新順</option>
              <option value="popular">人気順</option>
              <option value="views">閲覧数順</option>
              <option value="comments">コメント数順</option>
            </select>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Articles Grid -->
  <section class="py-16">
    <div class="container mx-auto px-6">
      <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-8">
        
        <!-- Article 1 -->
        <article class="article-card bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
          <div class="h-48 bg-gray-200 flex items-center justify-center">
            <span class="text-gray-500">アイキャッチ画像</span>
          </div>
          <div class="p-6">
            <div class="flex items-center space-x-2 mb-3">
              <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded text-sm">#ChatGPT API</span>
              <span class="bg-pink-100 text-pink-800 px-2 py-1 rounded text-sm">#Rails</span>
              <span class="text-gray-500 text-sm">2024.11.20</span>
            </div>
            <h3 class="text-xl font-bold mb-3 hover:text-blue-600 cursor-pointer">
              ChatGPT APIとRailsで作る自動記事要約システム
            </h3>
            <p class="text-gray-600 mb-4 leading-relaxed">
              SE/PM経験を活かした要件定義から、Rails実装、ChatGPT API連携まで。
              実際の業務で使える記事要約システムの構築手順を詳しく解説...
            </p>
            <div class="flex items-center justify-between">
              <div class="text-sm text-gray-500">読了: 約12分</div>
              <div class="flex items-center space-x-4">
                <span class="text-sm text-gray-500">👍 45</span>
                <span class="text-sm text-gray-500">💬 8</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Article 2 -->
        <article class="article-card bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
          <div class="h-48 bg-gray-200 flex items-center justify-center">
            <span class="text-gray-500">アイキャッチ画像</span>
          </div>
          <div class="p-6">
            <div class="flex items-center space-x-2 mb-3">
              <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded text-sm">#AI</span>
              <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-sm">#効率化</span>
              <span class="text-gray-500 text-sm">2024.11.12</span>
            </div>
            <h3 class="text-xl font-bold mb-3 hover:text-blue-600 cursor-pointer">
              開発チームでのChatGPT活用法：生産性を2倍にする実践テクニック
            </h3>
            <p class="text-gray-600 mb-4 leading-relaxed">
              チーム全体でAIツールを導入した結果と課題。
              コードレビュー、ドキュメント作成、バグ調査での活用事例を公開...
            </p>
            <div class="flex items-center justify-between">
              <div class="text-sm text-gray-500">読了: 約10分</div>
              <div class="flex items-center space-x-4">
                <span class="text-sm text-gray-500">👍 52</span>
                <span class="text-sm text-gray-500">💬 18</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Article 3 -->
        <article class="article-card bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
          <div class="h-48 bg-gray-200 flex items-center justify-center">
            <span class="text-gray-500">アイキャッチ画像</span>
          </div>
          <div class="p-6">
            <div class="flex items-center space-x-2 mb-3">
              <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded text-sm">#AI</span>
              <span class="text-gray-500 text-sm">2024.10.28</span>
            </div>
            <h3 class="text-xl font-bold mb-3 hover:text-blue-600 cursor-pointer">
              機械学習モデルのデプロイ：PythonからRailsへの統合
            </h3>
            <p class="text-gray-600 mb-4 leading-relaxed">
              訓練済みモデルをRailsアプリケーションに組み込む手順。
              API設計からパフォーマンス最適化まで実践的なノウハウを共有...
            </p>
            <div class="flex items-center justify-between">
              <div class="text-sm text-gray-500">読了: 約18分</div>
              <div class="flex items-center space-x-4">
                <span class="text-sm text-gray-500">👍 38</span>
                <span class="text-sm text-gray-500">💬 12</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Article 4 -->
        <article class="article-card bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
          <div class="h-48 bg-gray-200 flex items-center justify-center">
            <span class="text-gray-500">アイキャッチ画像</span>
          </div>
          <div class="p-6">
            <div class="flex items-center space-x-2 mb-3">
              <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded text-sm">#ChatGPT</span>
              <span class="bg-yellow-100 text-yellow-800 px-2 py-1 rounded text-sm">#プロンプト</span>
              <span class="text-gray-500 text-sm">2024.10.15</span>
            </div>
            <h3 class="text-xl font-bold mb-3 hover:text-blue-600 cursor-pointer">
              ChatGPTで業務効率化：実践的なプロンプトエンジニアリング
            </h3>
            <p class="text-gray-600 mb-4 leading-relaxed">
              効果的なプロンプトの書き方から、業務別の活用事例まで。
              30年の経験を活かしたAI活用のベストプラクティスを解説...
            </p>
            <div class="flex items-center justify-between">
              <div class="text-sm text-gray-500">読了: 約14分</div>
              <div class="flex items-center space-x-4">
                <span class="text-sm text-gray-500">👍 156</span>
                <span class="text-sm text-gray-500">💬 32</span>
              </div>
            </div>
          </div>
        </article>

      </div>

      <div class="text-center mt-12">
        <button class="bg-purple-600 text-white px-8 py-3 rounded-lg hover:bg-purple-700 transition-colors">
          もっと見る
        </button>
      </div>
    </div>
  </section>

  <!-- Related Categories -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-6">
      <h2 class="text-2xl font-bold text-center mb-12">他のカテゴリも見る</h2>
      <div class="max-w-4xl mx-auto grid md:grid-cols-3 gap-6">
        <% if @slug != 'ruby-rails' %>
          <%= link_to blog_category_path('ruby-rails'), class: "category-card bg-gradient-to-br from-red-50 to-orange-50 border-2 border-red-200 rounded-xl p-6 text-center hover:border-red-400 hover:shadow-lg transition-all" do %>
            <div class="text-4xl mb-3">⚙️</div>
            <h3 class="font-bold mb-1">Ruby/Rails</h3>
            <p class="text-sm text-gray-600">24記事</p>
          <% end %>
        <% end %>
        
        <% if @slug != 'requirements' %>
          <%= link_to blog_category_path('requirements'), class: "category-card bg-gradient-to-br from-blue-50 to-cyan-50 border-2 border-blue-200 rounded-xl p-6 text-center hover:border-blue-400 hover:shadow-lg transition-all" do %>
            <div class="text-4xl mb-3">🏗️</div>
            <h3 class="font-bold mb-1">要件定義・設計</h3>
            <p class="text-sm text-gray-600">15記事</p>
          <% end %>
        <% end %>
        
        <% if @slug != 'infrastructure' %>
          <%= link_to blog_category_path('infrastructure'), class: "category-card bg-gradient-to-br from-green-50 to-emerald-50 border-2 border-green-200 rounded-xl p-6 text-center hover:border-green-400 hover:shadow-lg transition-all" do %>
            <div class="text-4xl mb-3">🚀</div>
            <h3 class="font-bold mb-1">インフラ・デプロイ</h3>
            <p class="text-sm text-gray-600">12記事</p>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <%= render 'shared/footer', variant: 'blog' %>
</div>
