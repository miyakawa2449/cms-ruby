<% content_for :title, "Technical Blog - Miyakawa Codes" %>

<div class="bg-gray-50">
  <%= render 'shared/header', variant: 'blog', show_search: true %>

  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-violet-500 via-purple-500 to-fuchsia-500 text-white pt-20">
    <div class="container mx-auto px-6 py-20 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">
        📝 Technical Blog
      </h1>
      <p class="text-xl md:text-2xl mb-6 text-purple-100">
        SE/PM × プログラミング × AI活用の技術発信
      </p>
      <p class="text-lg text-purple-100 max-w-3xl mx-auto">
        30年のキャリアで培った実践的な技術知識とノウハウを共有。
        要件定義からAI活用まで、現場で使える情報をお届けします。
      </p>
    </div>
  </section>

  <!-- Categories Section -->
  <section id="categories" class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-12">カテゴリ</h2>
      <div class="grid md:grid-cols-4 gap-6 max-w-6xl mx-auto">
        <%= link_to blog_category_path('ruby-rails'), class: "category-card bg-gradient-to-br from-red-50 to-orange-50 border-2 border-red-200 rounded-2xl p-8 text-center cursor-pointer hover:border-red-400 hover:shadow-xl hover:scale-105 transition-all" do %>
          <div class="text-5xl mb-4">⚙️</div>
          <h3 class="text-xl font-bold mb-2 text-gray-900">Ruby/Rails</h3>
          <p class="text-gray-600 text-sm mb-4">Web開発・フレームワーク</p>
          <div class="text-red-600 font-semibold">24記事</div>
        <% end %>
        
        <%= link_to blog_category_path('ai-ml'), class: "category-card bg-gradient-to-br from-purple-50 to-pink-50 border-2 border-purple-200 rounded-2xl p-8 text-center cursor-pointer hover:border-purple-400 hover:shadow-xl hover:scale-105 transition-all" do %>
          <div class="text-5xl mb-4">🤖</div>
          <h3 class="text-xl font-bold mb-2 text-gray-900">AI・機械学習</h3>
          <p class="text-gray-600 text-sm mb-4">ChatGPT・開発効率化</p>
          <div class="text-purple-600 font-semibold">18記事</div>
        <% end %>
        
        <%= link_to blog_category_path('requirements'), class: "category-card bg-gradient-to-br from-blue-50 to-cyan-50 border-2 border-blue-200 rounded-2xl p-8 text-center cursor-pointer hover:border-blue-400 hover:shadow-xl hover:scale-105 transition-all" do %>
          <div class="text-5xl mb-4">🏗️</div>
          <h3 class="text-xl font-bold mb-2 text-gray-900">要件定義・設計</h3>
          <p class="text-gray-600 text-sm mb-4">上流工程・PM</p>
          <div class="text-blue-600 font-semibold">15記事</div>
        <% end %>
        
        <%= link_to blog_category_path('infrastructure'), class: "category-card bg-gradient-to-br from-green-50 to-emerald-50 border-2 border-green-200 rounded-2xl p-8 text-center cursor-pointer hover:border-green-400 hover:shadow-xl hover:scale-105 transition-all" do %>
          <div class="text-5xl mb-4">🚀</div>
          <h3 class="text-xl font-bold mb-2 text-gray-900">インフラ・デプロイ</h3>
          <p class="text-gray-600 text-sm mb-4">AWS・Docker・CI/CD</p>
          <div class="text-green-600 font-semibold">12記事</div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Featured Article -->
  <section class="py-16 bg-gradient-to-r from-blue-50 to-purple-50">
    <div class="container mx-auto px-6">
      <div class="text-center mb-12">
        <div class="inline-block bg-yellow-300 text-gray-900 px-4 py-2 rounded-full text-sm font-semibold mb-4">⭐ 注目記事</div>
        <h2 class="text-3xl font-bold">今週のピックアップ</h2>
      </div>
      <div class="max-w-4xl mx-auto bg-white rounded-xl shadow-lg overflow-hidden">
        <div class="md:flex">
          <div class="md:w-1/2">
            <div class="h-64 bg-gray-200 flex items-center justify-center">
              <span class="text-gray-500">アイキャッチ画像</span>
            </div>
          </div>
          <div class="md:w-1/2 p-8">
            <div class="flex items-center space-x-2 mb-4">
              <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded text-sm">#AI</span>
              <span class="bg-red-100 text-red-800 px-2 py-1 rounded text-sm">#Rails</span>
              <span class="text-gray-500 text-sm">2024.11.20</span>
            </div>
            <h3 class="text-2xl font-bold mb-4 hover:text-blue-600 cursor-pointer">
              ChatGPT APIとRailsで作る自動記事要約システム
            </h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              SE/PM経験を活かした要件定義から、Rails実装、ChatGPT API連携まで。
              実際の業務で使える記事要約システムの構築手順を詳しく解説します。
              コード例付きで初心者にも分かりやすく説明。
            </p>
            <div class="flex items-center justify-between">
              <div class="text-sm text-gray-500">読了時間: 約12分</div>
              <%= link_to '続きを読む', blog_article_path('chatgpt-rails-summary'), class: "bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Articles -->
  <section id="latest" class="py-16 bg-white">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-12">最新記事</h2>
      <div class="max-w-4xl mx-auto space-y-8">
        
        <article class="article-card border border-gray-200 rounded-lg p-6 hover:shadow-lg transition-shadow">
          <div class="flex items-start space-x-4">
            <div class="w-32 h-32 bg-gray-200 rounded flex-shrink-0 flex items-center justify-center">
              <span class="text-gray-500 text-xs">サムネイル</span>
            </div>
            <div class="flex-1">
              <div class="flex items-center space-x-2 mb-3">
                <span class="bg-red-100 text-red-800 px-2 py-1 rounded text-sm">#Rails</span>
                <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">#パフォーマンス</span>
                <span class="text-gray-500 text-sm">2024.11.18</span>
              </div>
              <h3 class="text-xl font-bold mb-3 hover:text-blue-600 cursor-pointer">
                Rails 8.0の新機能解説とパフォーマンス改善手法
              </h3>
              <p class="text-gray-600 mb-4 leading-relaxed">
                Rails 8.0の注目機能を実際のプロジェクトで検証。
                パフォーマンス改善の実測値とベストプラクティスをSE経験を交えて解説...
              </p>
              <div class="flex items-center justify-between">
                <div class="text-sm text-gray-500">読了時間: 約8分</div>
                <div class="flex items-center space-x-4">
                  <span class="text-sm text-gray-500">👍 24</span>
                  <span class="text-sm text-gray-500">💬 5</span>
                </div>
              </div>
            </div>
          </div>
        </article>

        <article class="article-card border border-gray-200 rounded-lg p-6 hover:shadow-lg transition-shadow">
          <div class="flex items-start space-x-4">
            <div class="w-32 h-32 bg-gray-200 rounded flex-shrink-0 flex items-center justify-center">
              <span class="text-gray-500 text-xs">サムネイル</span>
            </div>
            <div class="flex-1">
              <div class="flex items-center space-x-2 mb-3">
                <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">#要件定義</span>
                <span class="bg-gray-100 text-gray-800 px-2 py-1 rounded text-sm">#PM</span>
                <span class="text-gray-500 text-sm">2024.11.15</span>
              </div>
              <h3 class="text-xl font-bold mb-3 hover:text-blue-600 cursor-pointer">
                要件定義書の書き方：16年のPM経験から学んだベストプラクティス
              </h3>
              <p class="text-gray-600 mb-4 leading-relaxed">
                失敗プロジェクトを減らすための要件定義のコツ。
                ステークホルダーとの合意形成から技術選定まで、実例を交えて詳しく解説...
              </p>
              <div class="flex items-center justify-between">
                <div class="text-sm text-gray-500">読了時間: 約15分</div>
                <div class="flex items-center space-x-4">
                  <span class="text-sm text-gray-500">👍 38</span>
                  <span class="text-sm text-gray-500">💬 12</span>
                </div>
              </div>
            </div>
          </div>
        </article>

        <article class="article-card border border-gray-200 rounded-lg p-6 hover:shadow-lg transition-shadow">
          <div class="flex items-start space-x-4">
            <div class="w-32 h-32 bg-gray-200 rounded flex-shrink-0 flex items-center justify-center">
              <span class="text-gray-500 text-xs">サムネイル</span>
            </div>
            <div class="flex-1">
              <div class="flex items-center space-x-2 mb-3">
                <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded text-sm">#AI</span>
                <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-sm">#効率化</span>
                <span class="text-gray-500 text-sm">2024.11.12</span>
              </div>
              <h3 class="text-xl font-bold mb-3 hover:text-blue-600 cursor-pointer">
                開発チームでのChatGPT活用法：生産性を2倍にする実践テクニック
              </h3>
              <p class="text-gray-600 mb-4 leading-relaxed">
                チーム全体でAIツールを導入した結果と課題。
                コードレビュー、ドキュメント作成、バグ調査での活用事例を公開...
              </p>
              <div class="flex items-center justify-between">
                <div class="text-sm text-gray-500">読了時間: 約10分</div>
                <div class="flex items-center space-x-4">
                  <span class="text-sm text-gray-500">👍 52</span>
                  <span class="text-sm text-gray-500">💬 18</span>
                </div>
              </div>
            </div>
          </div>
        </article>

        <article class="article-card border border-gray-200 rounded-lg p-6 hover:shadow-lg transition-shadow">
          <div class="flex items-start space-x-4">
            <div class="w-32 h-32 bg-gray-200 rounded flex-shrink-0 flex items-center justify-center">
              <span class="text-gray-500 text-xs">サムネイル</span>
            </div>
            <div class="flex-1">
              <div class="flex items-center space-x-2 mb-3">
                <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-sm">#Docker</span>
                <span class="bg-orange-100 text-orange-800 px-2 py-1 rounded text-sm">#AWS</span>
                <span class="text-gray-500 text-sm">2024.11.08</span>
              </div>
              <h3 class="text-xl font-bold mb-3 hover:text-blue-600 cursor-pointer">
                DockerとAWS ECSで実現する本番環境デプロイの完全ガイド
              </h3>
              <p class="text-gray-600 mb-4 leading-relaxed">
                開発環境から本番環境まで一貫したDocker運用。
                ECS、ECR、RDSの構成とCI/CDパイプラインの実装手順を公開...
              </p>
              <div class="flex items-center justify-between">
                <div class="text-sm text-gray-500">読了時間: 約20分</div>
                <div class="flex items-center space-x-4">
                  <span class="text-sm text-gray-500">👍 45</span>
                  <span class="text-sm text-gray-500">💬 8</span>
                </div>
              </div>
            </div>
          </div>
        </article>
      </div>
      
      <div class="text-center mt-12">
        <button class="bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition-colors">
          もっと見る
        </button>
      </div>
    </div>
  </section>

  <!-- Popular Articles -->
  <section id="popular" class="py-16 bg-gray-50">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-12">人気記事</h2>
      <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
          <div class="h-40 bg-gray-200 flex items-center justify-center">
            <span class="text-gray-500">サムネイル</span>
          </div>
          <div class="p-6">
            <div class="flex items-center space-x-2 mb-2">
              <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded text-xs">#AI</span>
              <span class="text-gray-500 text-xs">2024.10.15</span>
            </div>
            <h3 class="font-bold mb-2 hover:text-blue-600 cursor-pointer">
              ChatGPTで業務効率化：実践的なプロンプトエンジニアリング
            </h3>
            <div class="flex items-center space-x-4 text-sm text-gray-500">
              <span>👍 156</span>
              <span>💬 32</span>
            </div>
          </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
          <div class="h-40 bg-gray-200 flex items-center justify-center">
            <span class="text-gray-500">サムネイル</span>
          </div>
          <div class="p-6">
            <div class="flex items-center space-x-2 mb-2">
              <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs">#PM</span>
              <span class="text-gray-500 text-xs">2024.09.20</span>
            </div>
            <h3 class="font-bold mb-2 hover:text-blue-600 cursor-pointer">
              失敗しないプロジェクト管理：SE/PMの現場ノウハウ
            </h3>
            <div class="flex items-center space-x-4 text-sm text-gray-500">
              <span>👍 128</span>
              <span>💬 24</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about-blog" class="py-16 bg-white">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-6">このブログについて</h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-8">
          30年のIT業界経験を持つ宮川 剛が、要件定義からプログラミング、AI活用まで、
          現場で培った実践的な技術知識を発信しています。
          初心者から経験者まで、すべてのエンジニアに役立つ情報をお届けします。
        </p>
        <div class="flex justify-center space-x-4">
          <%= link_to 'ポートフォリオを見る', root_path, class: "bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors" %>
          <%= link_to 'My Story', my_story_path, class: "border-2 border-blue-600 text-blue-600 px-6 py-3 rounded-lg hover:bg-blue-600 hover:text-white transition-colors" %>
        </div>
      </div>
    </div>
  </section>

  <%= render 'shared/footer', variant: 'blog' %>
</div>
