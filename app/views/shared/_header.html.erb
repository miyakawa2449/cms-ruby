<%# Header partial - supports different variants %>

<% variant ||= 'portfolio' %>
<% show_search ||= false %>

<header class="fixed top-0 w-full bg-white border-b border-gray-200 z-50">
  <nav class="container mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-8">
        <div class="flex items-center space-x-3">
          <!-- Logo -->
          <% if variant == 'portfolio' %>
            <%= site_logo(class: 'h-10 w-auto max-w-40') %>
          <% end %>
          <!-- Site Name -->
          <div class="text-xl font-bold text-gray-900">
            <% case variant %>
            <% when 'story' %>
              My Story
            <% when 'blog' %>
              Miyakawa Codes Blog
            <% else %>
              Miyakawa Codes
            <% end %>
          </div>
        </div>
      </div>
      
      <!-- Navigation Links -->
      <% if variant == 'portfolio' %>
        <div class="hidden md:flex space-x-8">
          <a href="#story" class="text-blue-600 font-semibold hover:text-blue-800 transition-colors">💡 My Story</a>
          <a href="#about" class="text-gray-700 hover:text-blue-600 transition-colors">About</a>
          <a href="#services" class="text-gray-700 hover:text-blue-600 transition-colors">Services</a>
          <a href="#works" class="text-gray-700 hover:text-blue-600 transition-colors">Works</a>
          <a href="#blog" class="text-gray-700 hover:text-blue-600 transition-colors">Blog</a>
          <a href="#contact" class="text-gray-700 hover:text-blue-600 transition-colors">Contact</a>
        </div>
      <% end %>
      
      <!-- Search & Mobile Menu -->
      <div class="flex items-center space-x-4" data-controller="mobile-menu">
        <% if show_search %>
          <div class="relative">
            <input 
              type="search" 
              placeholder="<%= variant == 'blog' ? '記事を検索...' : '検索...' %>" 
              class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent w-64"
            />
            <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        <% end %>
        <div class="md:hidden">
          <button type="button"
                  data-action="click->mobile-menu#toggle"
                  data-mobile-menu-target="button"
                  aria-expanded="false"
                  class="rounded-md p-2 hover:bg-gray-100">
            <span class="sr-only">メニュー</span>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
          <div class="fixed inset-0 z-50 hidden"
               data-mobile-menu-target="panel">
            <div class="absolute inset-0 bg-black/30" data-action="click->mobile-menu#close"></div>
            <div class="relative h-full w-full bg-white/95 backdrop-blur-sm">
              <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4">
                <div class="text-base font-semibold text-gray-900">メニュー</div>
                <button type="button"
                        class="rounded-md p-2 hover:bg-gray-100"
                        data-action="click->mobile-menu#close">
                  <span class="sr-only">閉じる</span>
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                </button>
              </div>
              <nav class="px-6 py-4 text-lg text-gray-900">
                <div class="divide-y divide-gray-200 border-y border-gray-200">
                  <% if variant == 'portfolio' %>
                    <a href="#story" class="block bg-white/90 py-4 px-3" data-action="click->mobile-menu#close">💡 My Story</a>
                    <a href="#about" class="block bg-white/90 py-4 px-3" data-action="click->mobile-menu#close">About</a>
                    <a href="#services" class="block bg-white/90 py-4 px-3" data-action="click->mobile-menu#close">Services</a>
                    <a href="#works" class="block bg-white/90 py-4 px-3" data-action="click->mobile-menu#close">Works</a>
                    <a href="#blog" class="block bg-white/90 py-4 px-3" data-action="click->mobile-menu#close">Blog</a>
                    <a href="#contact" class="block bg-white/90 py-4 px-3" data-action="click->mobile-menu#close">Contact</a>
                  <% else %>
                    <%= link_to "ホーム", root_path, class: "block bg-white/90 py-4 px-3", data: { action: "click->mobile-menu#close" } %>
                    <%= link_to "ブログ", blog_path, class: "block bg-white/90 py-4 px-3", data: { action: "click->mobile-menu#close" } %>
                    <%= link_to "My Story", "/#my-story", class: "block bg-white/90 py-4 px-3", data: { action: "click->mobile-menu#close" } %>
                  <% end %>
                </div>
              </nav>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>
