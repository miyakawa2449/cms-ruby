<%# 
  使用方法: <%= render 'shared/header', variant: 'portfolio', show_search: false %>
  variant: 'portfolio' | 'blog' | 'story'
  show_search: true | false
%>

<% variant ||= 'portfolio' %>
<% show_search ||= false %>

<header class="fixed top-0 w-full bg-white/90 backdrop-blur-sm border-b border-gray-200 z-50">
  <nav class="container mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-8">
        <% if variant == 'story' %>
          <%= link_to root_path, class: "flex items-center space-x-2 text-blue-600 hover:text-blue-800 transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>ポートフォリオに戻る</span>
          <% end %>
        <% elsif variant == 'blog' %>
          <%= link_to root_path, class: "flex items-center space-x-2 text-blue-600 hover:text-blue-800 transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>ポートフォリオ</span>
          <% end %>
        <% end %>
        
        <div class="flex items-center space-x-3">
          <!-- Logo -->
          <% if variant == 'portfolio' %>
            <div class="w-10 h-10 bg-gradient-to-br from-blue-900 to-slate-800 rounded-lg flex items-center justify-center shadow-md">
              <span class="text-white font-bold text-xl">M</span>
            </div>
          <% end %>
          <!-- Site Name -->
          <div class="text-xl font-bold text-gray-900">
            <% case variant %>
            <% when 'story' %>
              My Story
            <% when 'blog' %>
              Technical Blog
            <% else %>
              Miyakawa Codes
            <% end %>
          </div>
        </div>
      </div>
      
      <!-- Navigation Links -->
      <% if variant == 'portfolio' %>
        <div class="hidden md:flex space-x-8">
          <a href="#story" class="text-blue-600 font-semibold hover:text-blue-800 transition-colors">💡 My Story</a>
          <a href="#about" class="text-gray-700 hover:text-blue-600 transition-colors">About</a>
          <a href="#service" class="text-gray-700 hover:text-blue-600 transition-colors">Service</a>
          <a href="#works" class="text-gray-700 hover:text-blue-600 transition-colors">Works</a>
          <a href="#blog" class="text-gray-700 hover:text-blue-600 transition-colors">Blog</a>
          <a href="#contact" class="text-gray-700 hover:text-blue-600 transition-colors">Contact</a>
        </div>
      <% elsif variant == 'blog' %>
        <div class="hidden md:flex items-center space-x-6">
          <a href="#latest" class="text-gray-700 hover:text-blue-600 transition-colors">最新記事</a>
          <a href="#categories" class="text-gray-700 hover:text-blue-600 transition-colors">カテゴリ</a>
          <a href="#popular" class="text-gray-700 hover:text-blue-600 transition-colors">人気記事</a>
          <a href="#about-blog" class="text-gray-700 hover:text-blue-600 transition-colors">About</a>
        </div>
      <% end %>
      
      <!-- Search & Mobile Menu -->
      <div class="flex items-center space-x-4">
        <% if show_search %>
          <div class="relative">
            <input 
              type="search" 
              placeholder="<%= variant == 'blog' ? '記事を検索...' : '検索...' %>" 
              class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent w-64"
            />
            <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        <% end %>
        <button class="md:hidden">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>