<% if article.tech_stack.present? %>
  <div class="flex flex-wrap gap-2 <%= local_assigns[:margin_class] || 'mb-4' %>">
    <% if local_assigns[:label].present? %>
      <span class="text-sm font-medium text-gray-600 mr-2"><%= local_assigns[:label] %></span>
    <% end %>
    <% article.tech_stack_list.each do |tech| %>
      <span class="<%= local_assigns[:tag_class] || 'bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded' %>">
        <%= tech %>
      </span>
    <% end %>
  </div>
<% end %>