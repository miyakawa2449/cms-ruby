<%# OGPカード表示用パーシャル（縦型） %>
<%# 引数: ogp_data (OgpFetcherService::OgpData) %>

<div class="ogp-card-wrapper" style="margin: 1.5rem 0;">
  <a href="<%= ogp_data.url %>"
     target="_blank"
     rel="noopener noreferrer"
     style="display: block; text-decoration: none; color: inherit;">
    <div style="border: 1px solid #e5e7eb; border-radius: 0.5rem; overflow: hidden; background: #fff; max-width: 42rem; transition: box-shadow 0.2s;"
         onmouseover="this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)'"
         onmouseout="this.style.boxShadow='none'">

      <%# サムネイル画像 %>
      <% if ogp_data.image.present? %>
        <div style="width: 100%; overflow: hidden; line-height: 0;">
          <img src="<%= ogp_data.image %>"
               alt="<%= ogp_data.title %>"
               style="display: block; width: 100%; height: auto;"
               loading="lazy"
               onerror="this.parentElement.style.display='none'">
        </div>
      <% end %>

      <%# コンテンツ部分 %>
      <div style="padding: 1rem;">
        <%# サイト情報 %>
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
          <% if ogp_data.favicon.present? %>
            <img src="<%= ogp_data.favicon %>"
                 alt=""
                 style="width: 1rem; height: 1rem; flex-shrink: 0;"
                 loading="lazy"
                 onerror="this.style.display='none'">
          <% end %>
          <span style="font-size: 0.75rem; color: #6b7280; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            <%= ogp_data.site_name %>
          </span>
        </div>

        <%# タイトル %>
        <div style="font-size: 1rem; font-weight: 600; color: #111827; margin-bottom: 0.5rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
          <%= ogp_data.title %>
        </div>

        <%# 説明文 %>
        <% if ogp_data.description.present? %>
          <div style="font-size: 0.875rem; color: #4b5563; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 0;">
            <%= ogp_data.description %>
          </div>
        <% end %>

        <%# URL %>
        <div style="margin-top: 0.5rem; font-size: 0.75rem; color: #9ca3af; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
          <%= URI.parse(ogp_data.url).host rescue ogp_data.url %>
        </div>
      </div>
    </div>
  </a>
</div>
