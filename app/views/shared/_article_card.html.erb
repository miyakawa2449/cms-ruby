<%# 記事カード（S1-7 P3-3で4箇所のコピペを統合）
    locals:
      article - 表示する記事（必須）
      variant - :large（ブログ一覧・既定） / :compact（関連記事などのグリッド用）
      query   - 検索キーワードのハイライト用（任意・:largeのみ）
    画像はOGP比率1.91:1で統一し、OGP画像→サムネイルの順で解決する（記事ページのヒーローと同じ）%>
<% variant ||= :large %>
<% query ||= nil %>
<% compact = (variant == :compact) %>

<article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
  <!-- カード画像（OGP比率1.91:1） -->
  <%= link_to blog_article_path(article.slug), class: "block" do %>
    <% if article.card_image %>
      <div class="bg-gray-200 overflow-hidden" style="aspect-ratio: 1200 / 630;">
        <%= lazy_image_tag article.card_image,
            alt: article.title,
            class: "w-full h-full object-cover hover:scale-105 transition-transform duration-300" %>
      </div>
    <% else %>
      <div class="bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center" style="aspect-ratio: 1200 / 630;">
        <svg class="<%= compact ? 'w-8 h-8' : 'w-16 h-16' %> text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
      </div>
    <% end %>
  <% end %>

  <div class="p-6">
    <!-- カテゴリ -->
    <% if article.categories.any? %>
      <div class="flex flex-wrap gap-2 mb-3">
        <% categories = compact ? article.categories.first(1) : article.categories %>
        <% categories.each do |category| %>
          <% if compact %>
            <span class="text-xs font-medium px-2 py-1 rounded text-white"
                  style="background-color: <%= category.color || '#3B82F6' %>;">
              <%= category.name %>
            </span>
          <% else %>
            <%= link_to blog_path(category_id: category.id),
                        class: "text-sm font-medium px-3 py-1 rounded-full transition-colors text-white hover:opacity-80",
                        style: "background-color: #{category.color || '#3B82F6'};" do %>
              <%= category.name %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <!-- タイトル -->
    <% if compact %>
      <h3 class="text-lg font-semibold text-gray-900 mb-2 hover:text-blue-600 transition-colors">
        <%= link_to article.title, blog_article_path(article.slug) %>
      </h3>
    <% else %>
      <h2 class="text-2xl font-bold text-gray-900 mb-3 hover:text-blue-600 transition-colors">
        <%= link_to blog_article_path(article.slug) do %>
          <% if query.present? %>
            <%= highlight_keywords(article.title, query) %>
          <% else %>
            <%= article.title %>
          <% end %>
        <% end %>
      </h2>
    <% end %>

    <!-- 抜粋（軽量プレーンテキスト。Markdownレンダリングは行わない） -->
    <% if compact %>
      <div class="text-gray-600 text-sm mb-3">
        <%= article.plain_text_excerpt(length: 100) %>
      </div>

      <time class="text-xs text-gray-500" datetime="<%= article.published_at&.iso8601 %>">
        <%= article.published_at&.strftime('%Y年%m月%d日') %>
      </time>
    <% else %>
      <div class="text-gray-600 leading-relaxed mb-4">
        <% if query.present? %>
          <%= highlight_keywords(article.plain_text_excerpt, query) %>
        <% else %>
          <%= article.plain_text_excerpt %>
        <% end %>
      </div>

      <!-- 技術スタック -->
      <%= render 'shared/tech_stack', article: article, tag_class: 'bg-green-100 text-green-800 text-sm font-medium px-3 py-1 rounded-full', margin_class: 'mb-4' %>

      <!-- メタ情報 -->
      <div class="flex items-center justify-between text-sm text-gray-500 mb-4">
        <div class="flex items-center space-x-4">
          <time datetime="<%= article.published_at&.iso8601 %>">
            <%= article.published_at&.strftime('%Y年%m月%d日') %>
          </time>
          <span>読了時間: 約<%= article.reading_time_minutes %>分</span>
        </div>
        <%= link_to "続きを読む →", blog_article_path(article.slug),
                    class: "text-blue-600 hover:text-blue-700 font-medium" %>
      </div>

      <!-- タグ -->
      <% if article.tags.any? %>
        <div class="flex flex-wrap gap-2">
          <% article.tags.each do |tag| %>
            <%= link_to blog_path(tag_id: tag.id),
                        class: "bg-gray-200 text-gray-600 text-sm px-2 py-1 rounded hover:bg-gray-300 transition-colors" do %>
              #<%= tag.name %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</article>
