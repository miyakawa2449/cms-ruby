<% content_for :title, "パスキー管理" %>

<div class="max-w-4xl mx-auto py-8 px-4">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">パスキー管理</h1>
    <p class="mt-2 text-sm text-gray-600">
      パスキーはパスワードより安全なログイン方法です。Face ID・Touch ID・画面ロックで認証できます。
    </p>
  </div>

  <%# リカバリー警告（仕様FR-3: 1系統のみは危険） %>
  <% if @passkeys.size == 1 %>
    <div class="mb-6 bg-yellow-50 border border-yellow-300 rounded-md p-4">
      <p class="text-sm text-yellow-800">
        ⚠️ パスキーが1つしか登録されていません。デバイスを紛失するとログインできなくなる恐れがあります。
        <strong>別のプラットフォーム（例: iPhoneに加えてChrome）でもう1つ登録してください。</strong>
      </p>
    </div>
  <% end %>

  <!-- 登録済みパスキー一覧 -->
  <div class="bg-white shadow rounded-lg overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-medium text-gray-900">登録済みのパスキー（<%= @passkeys.size %>/<%= PasskeyCredential::MAX_PER_USER %>）</h2>
    </div>

    <% if @passkeys.any? %>
      <ul class="divide-y divide-gray-200">
        <% @passkeys.each do |passkey| %>
          <li class="px-6 py-4 flex items-center justify-between">
            <div>
              <p class="font-medium text-gray-900"><%= passkey.nickname %></p>
              <p class="text-sm text-gray-500">
                登録: <%= passkey.created_at.strftime("%Y/%m/%d") %> ／
                最終使用: <%= passkey.last_used_at ? passkey.last_used_at.strftime("%Y/%m/%d %H:%M") : "未使用" %>
              </p>
            </div>
            <%= button_to "削除", admin_passkey_path(passkey), method: :delete,
                class: "text-sm text-red-600 hover:text-red-800",
                form: { data: { turbo_confirm: "パスキー「#{passkey.nickname}」を削除しますか？" } } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="px-6 py-8 text-center text-gray-500">
        パスキーはまだ登録されていません
      </div>
    <% end %>
  </div>

  <!-- 新規登録フォーム -->
  <div class="bg-white shadow rounded-lg p-6"
       data-controller="passkey-registration"
       data-passkey-registration-options-url-value="<%= options_admin_passkeys_path %>"
       data-passkey-registration-create-url-value="<%= admin_passkeys_path %>">
    <h2 class="text-lg font-medium text-gray-900 mb-4">新しいパスキーを登録</h2>

    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">デバイス名（例: iPhone、Mac Chrome）</label>
        <input type="text" data-passkey-registration-target="nickname"
               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm"
               placeholder="このパスキーの名前">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">現在のパスワード（本人確認）</label>
        <input type="password" data-passkey-registration-target="password" autocomplete="current-password"
               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm">
      </div>

      <div data-passkey-registration-target="error" class="hidden text-sm text-red-600"></div>

      <button type="button" data-action="passkey-registration#register"
              class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
        🔑 パスキーを登録する
      </button>
    </div>
  </div>
</div>
