<% content_for :page_title, "サイト設定" %>

<!-- ヘッダー -->
<div class="flex justify-between items-center mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">サイト設定</h1>
    <p class="mt-1 text-sm text-gray-600">Favicon、OG画像、サイト情報の設定を管理します。</p>
  </div>
</div>

<%= form_tag admin_site_settings_path, method: :patch, multipart: true, class: "space-y-8" do %>
  
  <!-- Favicon設定 -->
  <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Favicon設定</h2>
      <div class="space-y-4">
        <!-- 現在のFavicon -->
        <% if @favicon.image_value.attached? %>
          <div class="flex items-center space-x-4">
            <div class="w-8 h-8 border border-gray-300 rounded">
              <%= image_tag @favicon.image_value, class: "w-full h-full object-cover" %>
            </div>
            <span class="text-sm text-gray-600">現在のFavicon</span>
          </div>
        <% else %>
          <p class="text-sm text-gray-500">Faviconが設定されていません</p>
        <% end %>

        <!-- Favicon アップロード -->
        <div>
          <%= label_tag "site_setting[favicon]", "新しいFaviconを選択", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= file_field_tag "site_setting[favicon]", 
                              accept: "image/*",
                              class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
          <p class="mt-1 text-sm text-gray-500">推奨サイズ: 32x32px または 16x16px、PNG/ICO形式</p>
        </div>
      </div>
    </div>

  <!-- サイトロゴ設定 -->
  <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">サイトロゴ設定</h2>
      <div class="space-y-4">
        <!-- 現在のロゴ -->
        <% if @logo.image_value.attached? %>
          <div class="flex items-center space-x-4">
            <div class="h-12 max-w-48 border border-gray-300 rounded p-2">
              <%= image_tag @logo.image_value, class: "h-full w-auto object-contain" %>
            </div>
            <span class="text-sm text-gray-600">現在のロゴ</span>
          </div>
        <% else %>
          <p class="text-sm text-gray-500">ロゴが設定されていません</p>
        <% end %>

        <!-- ロゴ アップロード -->
        <div>
          <%= label_tag "site_setting[logo]", "新しいロゴを選択", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= file_field_tag "site_setting[logo]", 
                              accept: "image/*",
                              class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
          <p class="mt-1 text-sm text-gray-500">推奨サイズ: 横200-400px、縦40-100px、PNG/SVG形式（透明背景推奨）</p>
        </div>
      </div>
    </div>

  <!-- OG画像設定 -->
  <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">OG画像設定</h2>
      <div class="space-y-4">
        <!-- 現在のOG画像 -->
        <% if @og_image.image_value.attached? %>
          <div class="flex items-center space-x-4">
            <div class="w-20 h-10 border border-gray-300 rounded">
              <%= image_tag @og_image.image_value, class: "w-full h-full object-cover" %>
            </div>
            <span class="text-sm text-gray-600">現在のOG画像</span>
          </div>
        <% else %>
          <p class="text-sm text-gray-500">OG画像が設定されていません</p>
        <% end %>

        <!-- OG画像 アップロード -->
        <div>
          <%= label_tag "site_setting[og_image]", "新しいOG画像を選択", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= file_field_tag "site_setting[og_image]", 
                              accept: "image/*",
                              class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
          <p class="mt-1 text-sm text-gray-500">推奨サイズ: 1200x630px、PNG/JPG形式</p>
        </div>
      </div>
    </div>

  <!-- サイト情報設定 -->
  <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">サイト情報</h2>
      <div class="space-y-4">
        <!-- サイトタイトル -->
        <div>
          <%= label_tag "site_setting[site_title]", "サイトタイトル", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= text_field_tag "site_setting[site_title]", 
                              @site_title.value,
                              class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
          <p class="mt-1 text-sm text-gray-500">ブラウザのタブやSNSシェア時に表示されるタイトル</p>
        </div>

        <!-- サイト説明文 -->
        <div>
          <%= label_tag "site_setting[site_description]", "サイト説明文", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= text_area_tag "site_setting[site_description]", 
                             @site_description.value,
                             rows: 3,
                             class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
          <p class="mt-1 text-sm text-gray-500">検索結果やSNSシェア時に表示される説明文</p>
        </div>
      </div>
    </div>

  <!-- 保存ボタン -->
  <div class="flex justify-end">
    <%= submit_tag "設定を保存", 
                    class: "bg-blue-600 text-white px-4 py-2 rounded-md font-medium hover:bg-blue-700 transition-colors" %>
  </div>

<% end %>

<!-- 設定情報 -->
<div class="mt-8 bg-white p-6 rounded-lg shadow-sm border border-gray-200">
  <h3 class="text-lg font-semibold text-gray-900 mb-4">設定情報</h3>
  <div class="grid md:grid-cols-2 gap-4 text-sm">
    <div>
      <span class="font-medium text-gray-700">Favicon:</span>
      <span class="text-gray-600">
        <%= @favicon.image_value.attached? ? "設定済み" : "未設定" %>
      </span>
    </div>
    <div>
      <span class="font-medium text-gray-700">ロゴ:</span>
      <span class="text-gray-600">
        <%= @logo.image_value.attached? ? "設定済み" : "未設定" %>
      </span>
    </div>
    <div>
      <span class="font-medium text-gray-700">OG画像:</span>
      <span class="text-gray-600">
        <%= @og_image.image_value.attached? ? "設定済み" : "未設定" %>
      </span>
    </div>
    <div>
      <span class="font-medium text-gray-700">サイトタイトル:</span>
      <span class="text-gray-600">
        <%= @site_title.value.present? ? "設定済み" : "未設定" %>
      </span>
    </div>
    <div>
      <span class="font-medium text-gray-700">サイト説明文:</span>
      <span class="text-gray-600">
        <%= @site_description.value.present? ? "設定済み" : "未設定" %>
      </span>
    </div>
  </div>
</div>