<% content_for :page_title, "セキュリティレポート" %>

<!-- ヘッダー -->
<div class="flex justify-between items-center mb-8">
  <div>
    <p class="text-gray-600 mt-2">週次セキュリティレポートを確認・ダウンロードできます</p>
  </div>

  <!-- 統計情報 -->
  <div class="flex space-x-4">
    <%= render "admin/shared/stat_card", label: "総レポート数", value: SecurityReport.count %>
  </div>
</div>

<!-- レポート一覧 -->
<div class="bg-white rounded-lg shadow-sm border">
  <% if @security_reports.any? %>
    <div class="overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">レポート種別</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">期間</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ステータス</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">生成日時</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @security_reports.each do |report| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                #<%= report.id %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                  <%= case report.report_type
                      when 'weekly' then 'bg-blue-100 text-blue-800'
                      when 'monthly' then 'bg-purple-100 text-purple-800'
                      else 'bg-gray-100 text-gray-800'
                      end %>">
                  <%= report.report_type.titleize %>
                </span>
              </td>

              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= report.period_start.to_date %> 〜 <%= report.period_end.to_date %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                  <%= case report.status
                      when 'completed' then 'bg-green-100 text-green-800'
                      when 'failed' then 'bg-red-100 text-red-800'
                      when 'generating' then 'bg-yellow-100 text-yellow-800'
                      else 'bg-gray-100 text-gray-800'
                      end %>">
                  <%= report.status.titleize %>
                </span>
              </td>

              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= report.generated_at&.strftime('%Y/%m/%d %H:%M') || '-' %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                <%= link_to "詳細", admin_security_report_path(report), class: "text-blue-600 hover:text-blue-900" %>
                <% if report.completed? %>
                  <%= link_to "ダウンロード", download_admin_security_report_path(report), class: "text-green-600 hover:text-green-900" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- ページネーション -->
    <% if @security_reports.total_pages > 1 %>
      <div class="px-6 py-4 border-t">
        <%= paginate @security_reports %>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-12">
      <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <h3 class="text-lg font-medium text-gray-900 mb-2">レポートがありません</h3>
      <p class="text-gray-600">週次レポートが生成されると、ここに表示されます。</p>
    </div>
  <% end %>
</div>
