<%# サムネイル/OGP画像（トリミング付き） locals: form, article %>
<!-- サムネイル画像 -->
<div class="bg-white shadow rounded-lg p-6">
  <h3 class="text-lg font-medium text-gray-900 mb-4">サムネイル画像</h3>

  <div class="space-y-4" data-controller="thumbnail-editor">
    <div>
      <%= form.label :thumbnail_image, "サムネイル画像", class: "block text-sm font-medium text-gray-700" %>
      <%= form.file_field :thumbnail_image,
          data: {
            action: "change->thumbnail-editor#selectFile",
            thumbnail_editor_target: "fileInput"
          },
          class: "mt-1 block w-full text-sm text-gray-500
          file:mr-4 file:py-2 file:px-4
          file:rounded-md file:border-0
          file:text-sm file:font-medium
          file:bg-blue-50 file:text-blue-700
          hover:file:bg-blue-100",
          accept: "image/*" %>
      <%= form.file_field :ogp_image,
          data: { thumbnail_editor_target: "ogpInput" },
          class: "hidden",
          accept: "image/*" %>
      <p class="mt-1 text-sm text-gray-500">
        画像を選択すると、トリミング画面が表示されます。<br>
        選択範囲がそのままサムネイル・OGP画像（SNSシェア用）として保存されます。
      </p>

      <% if article.thumbnail_image.attached? %>
        <div class="mt-4">
          <p class="text-sm font-medium text-gray-700 mb-2">現在の画像:</p>
          <%= image_tag article.thumbnail_image,
              class: "rounded-md shadow-sm max-w-full h-auto",
              style: "max-height: 200px;" %>
        </div>
      <% end %>
      <% if article.ogp_image.attached? %>
        <div class="mt-4">
          <p class="text-sm font-medium text-gray-700 mb-2">現在のOGP画像:</p>
          <%= image_tag article.ogp_image,
              class: "rounded-md shadow-sm max-w-full h-auto",
              style: "max-height: 200px;" %>
        </div>
      <% end %>
    </div>

    <!-- トリミングモーダル -->
    <%= render 'thumbnail_editor_modal' %>
  </div>
</div>
