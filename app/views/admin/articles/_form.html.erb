<%# 記事フォーム（S1-7 P3-7でセクションごとのパーシャルに分割） %>
<%= form_with(model: [:admin, article]) do |form| %>
  <% if article.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded mb-6">
      <h3 class="font-bold">エラーが発生しました:</h3>
      <ul class="mt-2 list-disc list-inside text-sm">
        <% article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6"
       data-controller="ai-assistant"
       data-ai-assistant-article-id-value="<%= article.id || 0 %>"
       data-ai-assistant-base-url-value="<%= admin_root_path.chomp('/') %>">
    <!-- メインコンテンツエリア -->
    <div class="lg:col-span-2 space-y-6">
      <%= render "form_basic_info", form: form, article: article %>
      <%= render "form_content", form: form %>
      <%= render "form_content_images", article: article %>
      <%= render "form_thumbnail", form: form, article: article %>
      <%= render "form_seo", form: form, article: article %>
    </div>

    <!-- サイドバー -->
    <div class="space-y-6">
      <%= render "form_sidebar_ai", article: article %>
      <%= render "form_publishing", form: form %>
      <%= render "form_taxonomy", form: form, article: article, categories: @categories %>
      <%= render "form_works_settings", form: form %>
      <%= render "form_actions", form: form, article: article %>
    </div>
  </div>
<% end %>
