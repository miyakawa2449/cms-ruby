<% content_for :page_title, @article.title %>

<div class="mb-6">
  <div class="flex items-center text-sm text-gray-500">
    <%= link_to "記事管理", admin_articles_path, class: "hover:text-gray-700" %>
    <svg class="h-5 w-5 text-gray-400 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
    <span class="text-gray-900"><%= truncate(@article.title, length: 30) %></span>
  </div>
</div>

<!-- アクションボタン -->
<div class="mb-6 flex justify-between items-center">
  <div class="flex space-x-3">
    <%= link_to "編集", edit_admin_article_path(@article), 
                class: "bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 transition-colors" %>
    
    <% if @article.draft? %>
      <%= link_to "公開", publish_admin_article_path(@article),
                  method: :patch,
                  data: { turbo_method: :patch },
                  class: "bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 transition-colors" %>
    <% elsif @article.published? %>
      <%= link_to "非公開", unpublish_admin_article_path(@article),
                  method: :patch,
                  data: { turbo_method: :patch },
                  class: "bg-yellow-600 text-white px-4 py-2 rounded-md hover:bg-yellow-700 transition-colors" %>
    <% end %>
    
    <%= button_to "削除", admin_article_path(@article), 
                  method: :delete,
                  onclick: "return confirm('本当に「#{j(@article.title)}」を削除しますか？')",
                  class: "bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 transition-colors border-0 cursor-pointer" %>
  </div>
  
  <div class="text-sm text-gray-500">
    作成日: <%= @article.created_at.strftime("%Y年%m月%d日 %H:%M") %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- メインコンテンツ -->
  <div class="lg:col-span-2 space-y-6">
    <!-- 記事情報 -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900"><%= @article.title %></h2>
        <div class="mt-2 flex items-center space-x-4 text-sm text-gray-500">
          <div class="flex items-center">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <%= @article.admin_user.email %>
          </div>
          <div class="flex items-center">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <%= @article.updated_at.strftime("%Y年%m月%d日 %H:%M") %>更新
          </div>
        </div>
      </div>
      
      <!-- 抜粋 -->
      <% if @article.excerpt.present? %>
        <div class="px-6 py-4 bg-gray-50">
          <h3 class="text-sm font-medium text-gray-700 mb-2">抜粋</h3>
          <p class="text-gray-900"><%= @article.excerpt %></p>
        </div>
      <% end %>
      
      <!-- サムネイル画像 -->
      <% if @article.thumbnail_image.attached? %>
        <div class="px-6 py-4 border-t border-gray-200">
          <h3 class="text-sm font-medium text-gray-700 mb-2">サムネイル画像</h3>
          <%= image_tag @article.thumbnail_image, 
              class: "rounded-md shadow-sm max-w-full h-auto",
              style: "max-height: 300px;" %>
        </div>
      <% end %>
      
      <!-- 本文 -->
      <div class="px-6 py-4">
        <h3 class="text-sm font-medium text-gray-700 mb-4">本文</h3>
        <div class="prose max-w-none">
          <pre class="whitespace-pre-wrap bg-gray-50 p-4 rounded-md text-sm"><%= @article.content %></pre>
        </div>
        <p class="mt-2 text-xs text-gray-500">※ Markdownのプレビュー機能は後日実装予定です</p>
      </div>
    </div>

    <!-- SEO情報 -->
    <% if @article.meta_description.present? || @article.meta_keywords.present? || @article.og_title.present? || @article.og_description.present? %>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-medium text-gray-900">SEO設定</h3>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-1 gap-4">
            <% if @article.meta_description.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">メタディスクリプション</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @article.meta_description %></dd>
              </div>
            <% end %>
            
            <% if @article.meta_keywords.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">メタキーワード</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @article.meta_keywords %></dd>
              </div>
            <% end %>
            
            <% if @article.og_title.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">OGタイトル</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @article.og_title %></dd>
              </div>
            <% end %>
            
            <% if @article.og_description.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">OG説明文</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @article.og_description %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      </div>
    <% end %>
  </div>

  <!-- サイドバー -->
  <div class="space-y-6">
    <!-- ステータス -->
    <div class="bg-white shadow rounded-lg p-6">
      <h3 class="text-lg font-medium text-gray-900 mb-4">公開設定</h3>
      
      <div class="space-y-3">
        <div>
          <dt class="text-sm font-medium text-gray-500">ステータス</dt>
          <dd class="mt-1">
            <% case @article.status %>
            <% when 'published' %>
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                公開中
              </span>
            <% when 'draft' %>
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                下書き
              </span>
            <% when 'scheduled' %>
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                予約投稿
              </span>
            <% when 'archived' %>
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                アーカイブ
              </span>
            <% end %>
          </dd>
        </div>
        
        <% if @article.published_at.present? %>
          <div>
            <dt class="text-sm font-medium text-gray-500">公開日時</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= @article.published_at.strftime("%Y年%m月%d日 %H:%M") %>
            </dd>
          </div>
        <% end %>
        
        <div>
          <dt class="text-sm font-medium text-gray-500">URL</dt>
          <dd class="mt-1 text-sm text-gray-900 font-mono">
            /articles/<%= @article.slug %>
          </dd>
        </div>
      </div>
    </div>

    <!-- カテゴリ -->
    <div class="bg-white shadow rounded-lg p-6">
      <h3 class="text-lg font-medium text-gray-900 mb-4">カテゴリ</h3>
      
      <% if @article.categories.any? %>
        <div class="space-y-2">
          <% @article.categories.each do |category| %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
              <%= category.full_name %>
            </span>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">カテゴリが設定されていません</p>
      <% end %>
    </div>

    <!-- タグ -->
    <div class="bg-white shadow rounded-lg p-6">
      <h3 class="text-lg font-medium text-gray-900 mb-4">タグ</h3>
      
      <% if @article.tags.any? %>
        <div class="flex flex-wrap gap-2">
          <% @article.tags.each do |tag| %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
              #<%= tag.name %>
            </span>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">タグが設定されていません</p>
      <% end %>
    </div>
  </div>
</div>