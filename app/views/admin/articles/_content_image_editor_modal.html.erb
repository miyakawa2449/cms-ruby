<div id="contentImageEditorModal"
     class="hidden fixed inset-0 z-50 overflow-y-auto"
     data-content-image-editor-target="modal">
  <div class="flex items-center justify-center min-h-screen px-4">
    <!-- Overlay -->
    <div class="fixed inset-0 bg-black bg-opacity-75"
         data-action="click->content-image-editor#close"></div>

    <!-- Modal Content -->
    <div class="relative bg-white rounded-lg shadow-xl w-full max-w-5xl max-h-[90vh] overflow-hidden">
      <!-- Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b bg-gray-50">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">本文内画像のトリミング</h3>
          <p class="text-sm text-gray-500">出力サイズ: 800x600px（4:3固定）</p>
        </div>
        <button type="button"
                data-action="click->content-image-editor#close"
                class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Content -->
      <div class="p-6 overflow-y-auto" style="max-height: calc(90vh - 220px);">
        <!-- Error Message -->
        <div data-content-image-editor-target="errorMessage"
             class="hidden mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Left: Cropper Area -->
          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3">トリミング範囲を選択</h4>
            <div class="bg-gray-100 rounded-lg overflow-hidden border border-gray-300"
                 style="height: 350px;"
                 data-content-image-editor-target="cropperContainer">
              <div class="flex items-center justify-center h-full text-gray-500">
                画像を読み込み中...
              </div>
            </div>
            <p class="mt-2 text-xs text-gray-500">
              ドラッグで範囲を移動、ハンドルでサイズ調整できます。<br>
              アスペクト比は4:3で固定されています。
            </p>
          </div>

          <!-- Right: Preview & Form -->
          <div class="space-y-4">
            <!-- Preview -->
            <div>
              <h4 class="text-sm font-medium text-gray-700 mb-3">プレビュー（800x600px）</h4>
              <div class="bg-gray-100 rounded-lg overflow-hidden border border-gray-300 flex items-center justify-center" style="min-height: 150px;">
                <img data-content-image-editor-target="preview"
                     class="w-full h-auto"
                     alt="プレビュー"
                     style="max-height: 200px; object-fit: contain; display: none;">
                <span class="text-gray-400 text-sm preview-placeholder">トリミング範囲を選択してください</span>
              </div>
            </div>

            <!-- Alt Text (Required) -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">
                alt属性（必須）
                <span class="text-red-500">*</span>
              </label>
              <input type="text"
                     data-content-image-editor-target="altInput"
                     placeholder="画像の説明を入力してください"
                     class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
              <p class="mt-1 text-xs text-gray-500">
                SEO・アクセシビリティのため、画像の内容を説明するテキストを入力してください。
              </p>
            </div>

            <!-- Caption (Optional) -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">
                キャプション（任意）
              </label>
              <input type="text"
                     data-content-image-editor-target="captionInput"
                     placeholder="画像の下に表示する説明文"
                     class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
              <p class="mt-1 text-xs text-gray-500">
                入力すると画像の下に表示されます。空欄の場合はシンプルなMarkdown形式で挿入されます。
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="flex items-center justify-between px-6 py-4 border-t bg-gray-50">
        <p class="text-sm text-gray-600">
          <span class="inline-flex items-center">
            <kbd class="px-2 py-1 text-xs font-semibold text-gray-800 bg-gray-100 border border-gray-200 rounded">ESC</kbd>
            <span class="ml-2">でキャンセル</span>
          </span>
        </p>
        <div class="flex gap-2">
          <button type="button"
                  data-action="click->content-image-editor#close"
                  class="px-4 py-2 text-sm text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
            キャンセル
          </button>
          <button type="button"
                  data-action="click->content-image-editor#save"
                  data-content-image-editor-target="saveBtn"
                  class="px-4 py-2 text-sm text-white bg-blue-600 rounded-lg hover:bg-blue-700 disabled:bg-gray-400 disabled:cursor-not-allowed">
            保存してMarkdownを挿入
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
