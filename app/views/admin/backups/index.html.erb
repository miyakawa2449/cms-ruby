<% content_for :page_title, "バックアップ管理" %>

<!-- ヘッダー -->
<div class="flex justify-between items-center mb-8">
  <div>
    <p class="text-gray-600 mt-2">S3バックアップの確認・復元ができます</p>
  </div>
  <div class="flex space-x-4">
    <div class="bg-white rounded-lg p-4 shadow-sm border">
      <p class="text-sm text-gray-500">バックアップ件数</p>
      <p class="text-2xl font-bold text-gray-900"><%= @backups.size %></p>
    </div>
    <div class="bg-white rounded-lg p-4 shadow-sm border">
      <p class="text-sm text-gray-500">直近の実行</p>
      <p class="text-2xl font-bold text-blue-600"><%= @backup_logs.first&.started_at&.strftime("%m/%d %H:%M") || "なし" %></p>
    </div>
  </div>
</div>

<!-- フィルター -->
<div class="bg-white rounded-lg shadow-sm border mb-6">
  <div class="p-4">
    <%= form_with url: admin_backups_path, method: :get, local: true, class: "flex flex-wrap gap-4 items-end" do |form| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">バックアップタイプ</label>
        <%= form.select :backup_type,
            options_for_select([
              ["すべて", ""],
              ["日次 (daily)", "daily"],
              ["週次 (weekly)", "weekly"],
              ["月次 (monthly)", "monthly"]
            ], @backup_type),
            {},
            { class: "border border-gray-300 rounded-md px-3 py-2" } %>
      </div>
      <div>
        <%= form.submit "フィルター", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 cursor-pointer" %>
        <%= link_to "リセット", admin_backups_path, class: "bg-gray-500 text-white px-4 py-2 rounded-md hover:bg-gray-600" %>
      </div>
    <% end %>
  </div>
</div>

<!-- S3バックアップ一覧 -->
<div class="bg-white rounded-lg shadow-sm border mb-8">
  <div class="px-6 py-4 border-b">
    <h2 class="text-lg font-semibold text-gray-900">S3バックアップファイル</h2>
  </div>

  <% if @backups.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">日時</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">タイプ</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">カテゴリ</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ファイルサイズ</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">S3キー</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @backups.each_with_index do |backup, i| %>
            <% parts = backup[:key].split("/")
               type = parts[0]
               filename = parts.last
               category = filename.split("_").first %>
            <tr class="<%= i.even? ? 'bg-white' : 'bg-gray-50' %> hover:bg-blue-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= backup[:last_modified]&.in_time_zone("Asia/Tokyo")&.strftime("%Y/%m/%d %H:%M") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% badge_class = case type
                   when "daily" then "bg-green-100 text-green-800"
                   when "weekly" then "bg-blue-100 text-blue-800"
                   when "monthly" then "bg-purple-100 text-purple-800"
                   else "bg-gray-100 text-gray-800"
                   end %>
                <span class="px-2 py-1 text-xs font-medium rounded-full <%= badge_class %>"><%= type %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= category %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                <%= number_to_human_size(backup[:size]) %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-400 font-mono truncate max-w-xs" title="<%= backup[:key] %>">
                <%= backup[:key] %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                <button type="button"
                        onclick="openRestoreModal('<%= j(backup[:key]) %>', '<%= backup[:last_modified]&.in_time_zone('Asia/Tokyo')&.strftime('%Y/%m/%d %H:%M') %>')"
                        class="text-red-600 hover:text-red-900 font-medium">
                  復元
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="px-6 py-12 text-center">
      <p class="text-gray-500">バックアップファイルが見つかりませんでした。</p>
    </div>
  <% end %>
</div>

<!-- バックアップ実行ログ -->
<div class="bg-white rounded-lg shadow-sm border">
  <div class="px-6 py-4 border-b">
    <h2 class="text-lg font-semibold text-gray-900">バックアップ実行ログ（直近20件）</h2>
  </div>
  <% if @backup_logs.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">開始日時</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">タイプ</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ステータス</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">所要時間</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ファイルサイズ</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @backup_logs.each_with_index do |log, i| %>
            <tr class="<%= i.even? ? 'bg-white' : 'bg-gray-50' %>">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= log.started_at.strftime("%Y/%m/%d %H:%M") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= log.backup_type %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% status_class = case log.status
                   when "success" then "bg-green-100 text-green-800"
                   when "failed"  then "bg-red-100 text-red-800"
                   else "bg-yellow-100 text-yellow-800"
                   end %>
                <span class="px-2 py-1 text-xs font-medium rounded-full <%= status_class %>"><%= log.status %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                <% if log.duration %>
                  <%= "#{log.duration.to_i}秒" %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                <%= log.file_size_mb ? "#{log.file_size_mb} MB" : "—" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="px-6 py-12 text-center">
      <p class="text-gray-500">バックアップログがありません。</p>
    </div>
  <% end %>
</div>

<!-- 復元確認モーダル -->
<div id="restore-modal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
  <div class="flex items-center justify-center min-h-screen px-4">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75" onclick="closeRestoreModal()"></div>
    <div class="relative bg-white rounded-lg shadow-xl max-w-lg w-full p-6 z-10">
      <h3 class="text-lg font-semibold text-gray-900 mb-2">復元の確認</h3>
      <div class="bg-red-50 border border-red-200 rounded-md p-4 mb-4">
        <p class="text-sm text-red-700 font-medium">⚠️ 警告: この操作は現在のデータを上書きします</p>
        <p class="text-sm text-red-600 mt-1">復元すると現在のデータベース・ファイルが失われます。本当によろしいですか？</p>
      </div>
      <p class="text-sm text-gray-600 mb-1">復元対象:</p>
      <p id="restore-key" class="text-sm font-mono text-gray-800 bg-gray-100 rounded px-2 py-1 mb-1 break-all"></p>
      <p id="restore-date" class="text-sm text-gray-500 mb-6"></p>

      <%= form_with url: restore_admin_backups_path, method: :post, id: "restore-form", local: true do |f| %>
        <%= f.hidden_field :backup_key, id: "restore-backup-key" %>
        <div class="flex justify-end gap-3">
          <button type="button" onclick="closeRestoreModal()"
                  class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
            キャンセル
          </button>
          <%= f.submit "復元する", class: "px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-md hover:bg-red-700 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  function openRestoreModal(key, date) {
    document.getElementById('restore-key').textContent = key;
    document.getElementById('restore-date').textContent = '日時: ' + date;
    document.getElementById('restore-backup-key').value = key;
    document.getElementById('restore-modal').classList.remove('hidden');
  }

  function closeRestoreModal() {
    document.getElementById('restore-modal').classList.add('hidden');
  }
</script>
