<% content_for :page_title, "タグ管理" %>
<!-- Updated at: <%= Time.current %> -->

<div class="flex justify-between items-center mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">タグ管理</h1>
    <p class="mt-1 text-sm text-gray-600">
      総タグ数: <%= @total_count %>件
    </p>
  </div>
  <%= link_to "新規タグ", new_admin_tag_path, 
              class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors" %>
</div>

<!-- 検索フォーム -->
<div class="bg-white rounded-lg shadow mb-6 p-4">
  <%= form_with url: admin_tags_path, method: :get, local: true, class: "flex items-center space-x-4" do |form| %>
    <div class="flex-1">
      <%= form.text_field :search, 
          value: params[:search],
          placeholder: "タグ名で検索...",
          class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
    </div>
    <div>
      <%= form.submit "検索", class: "bg-gray-600 text-white px-4 py-2 rounded-md hover:bg-gray-700 transition-colors" %>
      <% if params[:search].present? %>
        <%= link_to "リセット", admin_tags_path, class: "text-gray-600 hover:text-gray-800 ml-2" %>
      <% end %>
    </div>
  <% end %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
  <!-- タグ一覧 -->
  <div class="lg:col-span-3">
    <div class="bg-white shadow rounded-lg">
      <% if @tags.any? %>
        <div class="overflow-hidden">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200" style="table-layout: fixed; width: 100%;">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider" style="width: 25%;">
                  タグ名
                </th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider" style="width: 10%;">
                  記事数
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider" style="width: 35%;">
                  URL スラッグ
                </th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider" style="width: 30%;">
                  操作
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @tags.each do |tag| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4" style="width: 25%;">
                    <div class="flex items-center">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 max-w-full truncate">
                        #<%= tag.name %>
                      </span>
                    </div>
                  </td>
                  
                  <td class="px-6 py-4 text-center" style="width: 10%;">
                    <span class="text-sm text-gray-900"><%= tag.article_count %></span>
                  </td>
                  
                  <td class="px-6 py-4" style="width: 35%;">
                    <code class="text-sm text-gray-600 block truncate">/tags/<%= tag.slug %></code>
                  </td>
                  
                  <td class="px-6 py-4 text-right text-sm font-medium" style="width: 30%;">
                    <div class="flex justify-end space-x-2">
                      <%= link_to "詳細", admin_tag_path(tag), 
                                  class: "text-blue-600 hover:text-blue-900" %>
                      <%= link_to "編集", edit_admin_tag_path(tag), 
                                  class: "text-indigo-600 hover:text-indigo-900" %>
                      <%= button_to "削除", admin_tag_path(tag), 
                                    method: :delete,
                                    onclick: "return confirm('本当に「#{j(tag.name)}」を削除しますか？')",
                                    class: "text-red-600 hover:text-red-900 bg-transparent border-0 p-0 font-medium text-sm cursor-pointer" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
            </table>
          </div>
        </div>
      <% else %>
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                  d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">
            <%= params[:search].present? ? "検索結果が見つかりません" : "タグがありません" %>
          </h3>
          <p class="mt-1 text-sm text-gray-500">
            <%= params[:search].present? ? "別のキーワードで検索してください。" : "新しいタグを作成してください。" %>
          </p>
          <% unless params[:search].present? %>
            <div class="mt-6">
              <%= link_to "新規タグ作成", new_admin_tag_path, 
                          class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- サイドバー：人気タグ -->
  <div>
    <div class="bg-white shadow rounded-lg p-6">
      <h3 class="text-lg font-medium text-gray-900 mb-4">人気タグ</h3>
      
      <% if @popular_tags.any? %>
        <div class="space-y-3">
          <% @popular_tags.each_with_index do |tag, index| %>
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <span class="text-xs font-medium text-gray-500 w-4"><%= index + 1 %>.</span>
                <%= link_to admin_tag_path(tag), class: "text-sm text-gray-900 hover:text-blue-600" do %>
                  <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-blue-100 text-blue-800">
                    #<%= tag.name %>
                  </span>
                <% end %>
              </div>
              <span class="text-xs text-gray-500"><%= tag.article_count %>件</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">まだタグがありません</p>
      <% end %>
    </div>
  </div>
</div>