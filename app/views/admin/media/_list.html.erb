<div class="divide-y divide-gray-200">
  <% media.each do |item| %>
    <div class="p-4 flex items-center gap-4 hover:bg-gray-50" data-media-id="<%= item.id %>">
      <!-- チェックボックス -->
      <input type="checkbox"
             data-action="change->media-library#toggleSelection"
             data-id="<%= item.id %>"
             class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">

      <!-- サムネイル -->
      <div class="flex-shrink-0 w-16 h-16 bg-gray-100 rounded-lg overflow-hidden cursor-pointer"
           data-action="click->media-library#showDetail"
           data-id="<%= item.id %>">
        <% if item.blob&.image? %>
          <%= image_tag url_for(item.blob.variant(resize_to_limit: [100, 100])),
                        class: "w-full h-full object-cover",
                        loading: "lazy",
                        alt: item.alt_text || item.filename %>
        <% else %>
          <div class="w-full h-full flex items-center justify-center text-gray-400">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        <% end %>
      </div>

      <!-- ファイル情報 -->
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium text-gray-900 truncate">
          <%= item.filename %>
        </p>
        <p class="text-sm text-gray-500">
          <%= item.dimensions %> | <%= item.human_file_size %> | <%= item.created_at.strftime('%Y-%m-%d %H:%M') %>
        </p>
        <div class="flex items-center gap-2 mt-1">
          <% if item.used? %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
              <%= item.usage_count %>件の記事で使用中
            </span>
          <% else %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">
              未使用
            </span>
          <% end %>
          <% if item.alt_text.present? %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800" title="<%= item.alt_text %>">
              alt設定済み
            </span>
          <% end %>
        </div>
      </div>

      <!-- アクション -->
      <div class="flex items-center gap-2">
        <button type="button"
                data-action="click->media-library#showDetail"
                data-id="<%= item.id %>"
                class="px-3 py-1.5 text-sm text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
          詳細
        </button>
        <% unless item.used? %>
          <%= button_to admin_medium_path(item),
                        method: :delete,
                        data: { turbo_confirm: "この画像を削除しますか？" },
                        class: "px-3 py-1.5 text-sm text-red-600 bg-red-50 rounded-lg hover:bg-red-100 transition-colors" do %>
            削除
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
