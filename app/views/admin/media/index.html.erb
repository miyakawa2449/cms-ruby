<% content_for :page_title, "メディアライブラリ" %>

<div class="space-y-6" data-controller="media-library" data-media-library-view-value="<%= @view_mode %>" data-media-library-detail-url-value="<%= admin_media_path %>">
  <!-- ヘッダーアクション -->
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <!-- アップロードボタン -->
      <button type="button"
              data-action="click->media-library#openUploadModal"
              class="inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        アップロード
      </button>

      <!-- 一括削除ボタン -->
      <button type="button"
              data-action="click->media-library#bulkDelete"
              data-media-library-target="bulkDeleteBtn"
              class="hidden inline-flex items-center px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        一括削除
      </button>
    </div>

    <!-- 表示切替 -->
    <div class="flex items-center gap-2">
      <button type="button"
              data-action="click->media-library#switchView"
              data-view="grid"
              class="p-2 rounded-lg <%= @view_mode == 'grid' ? 'bg-gray-200 text-gray-900' : 'text-gray-500 hover:bg-gray-100' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
        </svg>
      </button>
      <button type="button"
              data-action="click->media-library#switchView"
              data-view="list"
              class="p-2 rounded-lg <%= @view_mode == 'list' ? 'bg-gray-200 text-gray-900' : 'text-gray-500 hover:bg-gray-100' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- 検索・フィルター -->
  <div class="bg-white rounded-lg shadow p-4">
    <%= form_with url: admin_media_path, method: :get, local: true, class: "space-y-4" do |f| %>
      <div class="flex flex-wrap gap-4">
        <!-- 検索ボックス -->
        <div class="flex-1 min-w-[200px]">
          <div class="relative">
            <input type="text" name="q" value="<%= params[:q] %>"
                   placeholder="ファイル名で検索..."
                   class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
            <svg class="absolute left-3 top-2.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>

        <!-- 使用状況フィルタ -->
        <div>
          <select name="filter[usage]" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <option value="">すべて</option>
            <option value="used" <%= 'selected' if params.dig(:filter, :usage) == 'used' %>>使用中</option>
            <option value="unused" <%= 'selected' if params.dig(:filter, :usage) == 'unused' %>>未使用</option>
          </select>
        </div>

        <!-- 並び替え -->
        <div>
          <select name="sort" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <option value="created_at_desc" <%= 'selected' if params[:sort].blank? || params[:sort] == 'created_at_desc' %>>新しい順</option>
            <option value="size_desc" <%= 'selected' if params[:sort] == 'size_desc' %>>サイズ大きい順</option>
            <option value="size_asc" <%= 'selected' if params[:sort] == 'size_asc' %>>サイズ小さい順</option>
            <option value="name_asc" <%= 'selected' if params[:sort] == 'name_asc' %>>名前順</option>
          </select>
        </div>

        <!-- 検索ボタン -->
        <button type="submit" class="px-4 py-2 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition-colors">
          検索
        </button>

        <% if params[:q].present? || params.dig(:filter, :usage).present? %>
          <%= link_to "クリア", admin_media_path, class: "px-4 py-2 text-gray-600 hover:text-gray-800" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- 画像一覧 -->
  <% if @media.any? %>
    <div class="bg-white rounded-lg shadow">
      <% if @view_mode == 'grid' %>
        <%= render 'grid', media: @media %>
      <% else %>
        <%= render 'list', media: @media %>
      <% end %>
    </div>

    <!-- ページネーション -->
    <div class="flex justify-center mt-6">
      <%= paginate @media %>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow p-12 text-center">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <h3 class="mt-4 text-lg font-medium text-gray-900">画像がありません</h3>
      <p class="mt-2 text-gray-500">アップロードボタンから画像を追加してください</p>
    </div>
  <% end %>

  <!-- アップロードモーダル -->
  <%= render 'upload_modal' %>

  <!-- 詳細モーダル -->
  <div id="detailModal" class="hidden fixed inset-0 z-50 overflow-y-auto" data-media-library-target="detailModal">
    <div class="flex items-center justify-center min-h-screen px-4">
      <div class="fixed inset-0 bg-black bg-opacity-50" data-action="click->media-library#closeDetailModal"></div>
      <div class="relative bg-white rounded-lg shadow-xl max-w-3xl w-full" data-media-library-target="detailContent">
        <!-- Content will be loaded dynamically -->
      </div>
    </div>
  </div>
</div>
