<%= form_with(model: [:admin, category]) do |form| %>
  <% if category.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded mb-6">
      <h3 class="font-bold">エラーが発生しました:</h3>
      <ul class="mt-2 list-disc list-inside text-sm">
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white shadow rounded-lg p-6">
    <div class="space-y-6">
      <!-- 基本情報 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= form.label :name, "カテゴリ名", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :name, 
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
              placeholder: "例: プログラミング" %>
        </div>

        <div>
          <%= form.label :slug, "URL スラッグ", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :slug, 
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
              placeholder: "例: programming" %>
          <p class="mt-1 text-sm text-gray-500">URLで使用される部分です。英数字とハイフンのみ使用可能。</p>
        </div>
      </div>

      <!-- 親カテゴリ選択 -->
      <div>
        <%= form.label :parent_id, "親カテゴリ", class: "block text-sm font-medium text-gray-700" %>
        <%= form.select :parent_id, 
            options_from_collection_for_select(@parent_categories, :id, :name, category.parent_id),
            { prompt: "なし（親カテゴリとして作成）" },
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
        <p class="mt-1 text-sm text-gray-500">子カテゴリとして作成する場合は親カテゴリを選択してください。</p>
      </div>

      <!-- 説明 -->
      <div>
        <%= form.label :description, "説明", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_area :description, 
            rows: 3,
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
            placeholder: "カテゴリの説明を入力してください" %>
      </div>

      <!-- 表示設定 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <%= form.label :icon, "アイコン", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :icon, 
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
              placeholder: "🚀" %>
          <p class="mt-1 text-sm text-gray-500">絵文字または短いテキスト</p>
        </div>

        <div>
          <%= form.label :color, "カテゴリ色", class: "block text-sm font-medium text-gray-700" %>
          <%= form.color_field :color, 
              class: "mt-1 block w-full h-10 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
              value: category.color.present? ? category.color : "#3B82F6" %>
        </div>

        <div>
          <%= form.label :position, "表示順", class: "block text-sm font-medium text-gray-700" %>
          <%= form.number_field :position, 
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
              min: 0,
              value: category.position.present? ? category.position : 0 %>
          <p class="mt-1 text-sm text-gray-500">数値が小さいほど上に表示</p>
        </div>
      </div>
    </div>

    <div class="mt-6 flex justify-end space-x-3">
      <%= link_to "キャンセル", admin_categories_path, 
                  class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <%= form.submit category.persisted? ? "更新する" : "作成する", 
                      class: "bg-blue-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    </div>
  </div>
<% end %>