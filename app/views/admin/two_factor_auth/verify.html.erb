<% content_for :page_title, t('two_factor_auth.verify_title') %>

<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
        <%= t('two_factor_auth.verify_title') %>
      </h2>
      <p class="mt-2 text-center text-sm text-gray-600">
        <%= t('two_factor_auth.verify_description') %>
      </p>
    </div>

    <div class="bg-white shadow rounded-lg p-6" data-controller="two-factor-verify">
      <% if flash[:alert] %>
        <div class="mb-4 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with url: verify_admin_two_factor_auth_path,
                    method: :post,
                    local: true,
                    data: { turbo: false },
                    id: "two-factor-form" do |f| %>
        <!-- Authenticator Code Tab -->
        <div id="authenticator-tab">
          <div class="mb-4">
            <label for="code" class="block text-sm font-medium text-gray-700"><%= t('two_factor_auth.verification_code') %></label>
            <input type="text" name="code" id="code" autocomplete="off" inputmode="numeric" pattern="[0-9]*" maxlength="6"
                   data-two-factor-verify-target="codeInput"
                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-center text-2xl tracking-widest"
                   placeholder="000000" autofocus>
            <p class="mt-1 text-xs text-gray-500"><%= t('two_factor_auth.verification_code_hint') %></p>
          </div>

          <div class="mb-4">
            <label class="flex items-center">
              <input type="checkbox" name="trust_device" value="1" class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
              <span class="ml-2 text-sm text-gray-600"><%= t('two_factor_auth.trust_device') %></span>
            </label>
          </div>

          <input type="hidden" name="use_backup_code" id="use_backup_code" value="0" data-two-factor-verify-target="useBackupCodeInput">

          <div>
            <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
              <%= t('two_factor_auth.verify') %>
            </button>
          </div>
        </div>
      <% end %>

      <!-- Toggle to Backup Code -->
      <div class="mt-4 text-center">
        <button type="button"
                data-two-factor-verify-target="toggleButton"
                data-action="two-factor-verify#toggle"
                class="text-sm text-indigo-600 hover:text-indigo-500">
          <%= t('two_factor_auth.use_backup_code') %>
        </button>
      </div>
    </div>
  </div>
</div>
