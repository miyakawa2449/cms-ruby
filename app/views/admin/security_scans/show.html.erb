<% content_for :page_title, "スキャン詳細 ##{@security_scan.id}" %>

<!-- 戻るリンク -->
<div class="mb-6">
  <%= link_to "← スキャン一覧に戻る", admin_security_scans_path, class: "text-blue-600 hover:text-blue-900" %>
</div>

<!-- スキャン情報 -->
<div class="bg-white rounded-lg shadow-sm border mb-6">
  <div class="px-6 py-4 border-b bg-gray-50">
    <h2 class="text-lg font-medium text-gray-900">スキャン情報</h2>
  </div>
  <div class="p-6">
    <dl class="grid grid-cols-2 gap-4">
      <div>
        <dt class="text-sm font-medium text-gray-500">スキャンID</dt>
        <dd class="mt-1 text-sm text-gray-900">#<%= @security_scan.id %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">スキャン種別</dt>
        <dd class="mt-1">
          <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
            <%= @security_scan.brakeman? ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800' %>">
            <%= @security_scan.scan_type.titleize %>
          </span>
        </dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">ステータス</dt>
        <dd class="mt-1">
          <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
            <%= case @security_scan.status
                when 'completed' then 'bg-green-100 text-green-800'
                when 'failed' then 'bg-red-100 text-red-800'
                when 'running' then 'bg-yellow-100 text-yellow-800'
                else 'bg-gray-100 text-gray-800'
                end %>">
            <%= @security_scan.status.titleize %>
          </span>
        </dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">スキャン日時</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @security_scan.scanned_at.strftime('%Y/%m/%d %H:%M:%S') %></dd>
      </div>
    </dl>

    <% if @security_scan.error_message.present? %>
    <div class="mt-4 p-4 bg-red-50 rounded-lg">
      <dt class="text-sm font-medium text-red-800">エラーメッセージ</dt>
      <dd class="mt-1 text-sm text-red-700"><%= @security_scan.error_message %></dd>
    </div>
    <% end %>
  </div>
</div>

<!-- サマリー -->
<div class="bg-white rounded-lg shadow-sm border mb-6">
  <div class="px-6 py-4 border-b bg-gray-50">
    <h2 class="text-lg font-medium text-gray-900">脆弱性サマリー</h2>
  </div>
  <div class="p-6">
    <% summary = @security_scan.summary %>
    <div class="grid grid-cols-5 gap-4">
      <div class="bg-red-50 rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-red-600"><%= summary[:critical] %></p>
        <p class="text-sm text-red-800">Critical</p>
      </div>
      <div class="bg-orange-50 rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-orange-600"><%= summary[:high] %></p>
        <p class="text-sm text-orange-800">High</p>
      </div>
      <div class="bg-yellow-50 rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-yellow-600"><%= summary[:medium] %></p>
        <p class="text-sm text-yellow-800">Medium</p>
      </div>
      <div class="bg-blue-50 rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-blue-600"><%= summary[:low] %></p>
        <p class="text-sm text-blue-800">Low</p>
      </div>
      <div class="bg-gray-50 rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-gray-600"><%= summary[:total] %></p>
        <p class="text-sm text-gray-800">合計</p>
      </div>
    </div>
  </div>
</div>

<!-- 脆弱性一覧 -->
<div class="bg-white rounded-lg shadow-sm border">
  <div class="px-6 py-4 border-b bg-gray-50">
    <h2 class="text-lg font-medium text-gray-900">検出された脆弱性</h2>
  </div>

  <% if @vulnerabilities.any? %>
    <div class="overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">深刻度</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">タイトル</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">詳細</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ステータス</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @vulnerabilities.each do |vuln| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                  <%= case vuln.severity
                      when 'critical' then 'bg-red-100 text-red-800'
                      when 'high' then 'bg-orange-100 text-orange-800'
                      when 'medium' then 'bg-yellow-100 text-yellow-800'
                      when 'low' then 'bg-blue-100 text-blue-800'
                      else 'bg-gray-100 text-gray-800'
                      end %>">
                  <%= vuln.severity.upcase %>
                </span>
              </td>

              <td class="px-6 py-4">
                <div class="text-sm font-medium text-gray-900"><%= vuln.title %></div>
                <% if vuln.cve_id.present? %>
                  <div class="text-xs text-gray-500">CVE: <%= vuln.cve_id %></div>
                <% end %>
              </td>

              <td class="px-6 py-4">
                <div class="text-sm text-gray-900"><%= truncate(vuln.description, length: 100) %></div>
                <% if vuln.file_path.present? %>
                  <div class="text-xs text-gray-500 mt-1">
                    ファイル: <%= vuln.file_path %><%= ":#{vuln.line_number}" if vuln.line_number %>
                  </div>
                <% end %>
                <% if vuln.gem_name.present? %>
                  <div class="text-xs text-gray-500 mt-1">
                    Gem: <%= vuln.gem_name %> (<%= vuln.gem_version %>)
                    <% if vuln.patched_versions.present? %>
                      → <%= vuln.patched_versions %>
                    <% end %>
                  </div>
                <% end %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap">
                <% if vuln.fixed? %>
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                    修正済み
                  </span>
                  <div class="text-xs text-gray-500 mt-1">
                    <%= vuln.fixed_at&.strftime('%Y/%m/%d') %>
                  </div>
                <% else %>
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                    未修正
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- ページネーション -->
    <% if @vulnerabilities.total_pages > 1 %>
      <div class="px-6 py-4 border-t">
        <%= paginate @vulnerabilities %>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-12">
      <svg class="mx-auto h-12 w-12 text-green-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      <h3 class="text-lg font-medium text-gray-900 mb-2">脆弱性は検出されませんでした</h3>
      <p class="text-gray-600">このスキャンでは問題が見つかりませんでした。</p>
    </div>
  <% end %>
</div>
