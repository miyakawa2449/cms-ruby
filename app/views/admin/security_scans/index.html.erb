<% content_for :page_title, "セキュリティスキャン" %>

<!-- ヘッダー -->
<div class="flex justify-between items-center mb-8">
  <div>
    <p class="text-gray-600 mt-2">Brakemanとbundler-auditのスキャン結果を確認できます</p>
  </div>

  <!-- 統計情報 -->
  <div class="flex space-x-4">
    <%= render "admin/shared/stat_card", label: "総スキャン数", value: SecurityScan.count %>
    <%= render "admin/shared/stat_card", label: "未修正脆弱性", value: Vulnerability.unfixed.count, value_class: "text-red-600" %>
  </div>
</div>

<!-- スキャン一覧 -->
<div class="bg-white rounded-lg shadow-sm border">
  <% if @security_scans.any? %>
    <div class="overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">スキャン種別</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ステータス</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">脆弱性</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">スキャン日時</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @security_scans.each do |scan| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                #<%= scan.id %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                  <%= scan.brakeman? ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800' %>">
                  <%= scan.scan_type.titleize %>
                </span>
              </td>

              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                  <%= case scan.status
                      when 'completed' then 'bg-green-100 text-green-800'
                      when 'failed' then 'bg-red-100 text-red-800'
                      when 'running' then 'bg-yellow-100 text-yellow-800'
                      else 'bg-gray-100 text-gray-800'
                      end %>">
                  <%= scan.status.titleize %>
                </span>
              </td>

              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center space-x-2">
                  <% summary = scan.summary %>
                  <% if summary[:critical] > 0 %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                      Critical: <%= summary[:critical] %>
                    </span>
                  <% end %>
                  <% if summary[:high] > 0 %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-orange-100 text-orange-800">
                      High: <%= summary[:high] %>
                    </span>
                  <% end %>
                  <% if summary[:medium] > 0 %>
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                      Medium: <%= summary[:medium] %>
                    </span>
                  <% end %>
                  <% if summary[:total] == 0 %>
                    <span class="text-sm text-green-600">問題なし</span>
                  <% end %>
                </div>
              </td>

              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= scan.scanned_at.strftime('%Y/%m/%d %H:%M') %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <%= link_to "詳細", admin_security_scan_path(scan), class: "text-blue-600 hover:text-blue-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- ページネーション -->
    <% if @security_scans.total_pages > 1 %>
      <div class="px-6 py-4 border-t">
        <%= paginate @security_scans %>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-12">
      <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
      </svg>
      <h3 class="text-lg font-medium text-gray-900 mb-2">スキャン結果がありません</h3>
      <p class="text-gray-600">セキュリティスキャンが実行されると、ここに表示されます。</p>
    </div>
  <% end %>
</div>
