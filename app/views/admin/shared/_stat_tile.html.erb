<%# 色付き統計タイル（値が上・中央寄せ）。color は Admin::StatsHelper::STAT_TILE_COLORS のキー %>
<% colors = stat_tile_colors(color) %>
<div class="<%= colors[:bg] %> rounded-lg p-4 text-center">
  <p class="text-2xl font-bold <%= colors[:value] %>"><%= value %></p>
  <p class="text-sm <%= colors[:label] %>"><%= label %></p>
</div>
