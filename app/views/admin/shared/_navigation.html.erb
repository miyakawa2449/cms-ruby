    <%= link_to admin_backups_path,
                class: "flex items-center px-4 py-2 text-sm font-medium rounded-md #{controller_name == 'backups' ? 'bg-gray-800 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" do %>
