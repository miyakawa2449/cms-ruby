<% content_for :page_title, @section.display_name %>

<div class="mb-6">
  <div class="flex items-center text-sm text-gray-500">
    <%= link_to "セクション管理", admin_sections_path, class: "hover:text-gray-700" %>
    <svg class="h-5 w-5 text-gray-400 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
    <span class="text-gray-900"><%= @section.display_name %></span>
  </div>
</div>

<!-- セクション情報 -->
<div class="bg-white shadow rounded-lg mb-6">
  <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
    <h2 class="text-lg font-medium text-gray-900">セクション情報</h2>
    <%= link_to "編集", edit_admin_section_path(@section), 
                class: "text-blue-600 hover:text-blue-900" %>
  </div>
  <div class="px-6 py-4">
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <dt class="text-sm font-medium text-gray-500">セクション名</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @section.name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">表示名</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @section.display_name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">公開状態</dt>
        <dd class="mt-1">
          <% if @section.is_visible? %>
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
              公開中
            </span>
          <% else %>
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
              非公開
            </span>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">表示順</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @section.position %></dd>
      </div>
    </dl>
  </div>
</div>

<!-- コンテンツ一覧 -->
<div class="bg-white shadow rounded-lg">
  <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
    <h2 class="text-lg font-medium text-gray-900">コンテンツバージョン</h2>
    <%= link_to "新規コンテンツ", new_admin_section_section_content_path(@section), 
                class: "bg-blue-600 text-white px-4 py-2 rounded-md text-sm hover:bg-blue-700 transition-colors" %>
  </div>
  
  <% if @section_contents.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              バージョン
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              公開状態
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              公開者
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              作成日時
            </th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
              操作
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @section_contents.each do |content| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">
                  バージョン <%= content.version %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if content.is_active? %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    公開中
                  </span>
                <% else %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                    非公開
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900">
                  <%= content.publisher&.email || "-" %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-500">
                  <%= content.created_at.strftime("%Y年%m月%d日 %H:%M") %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex justify-end space-x-2">
                  <% unless content.is_active? %>
                    <%= link_to "公開", activate_admin_section_section_content_path(@section, content),
                                method: :patch,
                                data: { turbo_method: :patch },
                                class: "text-green-600 hover:text-green-900" %>
                  <% end %>
                  <%= link_to "編集", edit_admin_section_section_content_path(@section, content), 
                              class: "text-indigo-600 hover:text-indigo-900" %>
                  <%= link_to "削除", admin_section_section_content_path(@section, content), 
                              method: :delete,
                              data: { 
                                turbo_method: :delete,
                                turbo_confirm: "本当に削除しますか？" 
                              },
                              class: "text-red-600 hover:text-red-900" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">コンテンツがありません</h3>
      <p class="mt-1 text-sm text-gray-500">新しいコンテンツを作成してください。</p>
      <div class="mt-6">
        <%= link_to "新規コンテンツ作成", new_admin_section_section_content_path(@section), 
                    class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
      </div>
    </div>
  <% end %>
</div>