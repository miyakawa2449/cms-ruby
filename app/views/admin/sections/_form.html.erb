<%= form_with(model: [:admin, section]) do |form| %>
  <% if section.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded mb-6">
      <h3 class="font-bold">エラーが発生しました:</h3>
      <ul class="mt-2 list-disc list-inside text-sm">
        <% section.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white shadow rounded-lg p-6">
    <div class="space-y-6">
      <div>
        <%= form.label :name, "セクション名（システム用）", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :name, 
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
            placeholder: "例: hero, about, services" %>
        <p class="mt-1 text-sm text-gray-500">英数字とアンダースコアのみ使用可能</p>
      </div>

      <div>
        <%= form.label :display_name, "表示名", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :display_name, 
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
            placeholder: "例: ヒーローセクション" %>
      </div>

      <div>
        <%= form.label :position, "表示順", class: "block text-sm font-medium text-gray-700" %>
        <%= form.number_field :position, 
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
            min: 0 %>
        <p class="mt-1 text-sm text-gray-500">数値が小さいほど上に表示されます</p>
      </div>

      <div>
        <div class="flex items-start">
          <div class="flex items-center h-5">
            <%= form.check_box :is_visible, 
                class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 rounded" %>
          </div>
          <div class="ml-3 text-sm">
            <%= form.label :is_visible, "公開する", class: "font-medium text-gray-700" %>
            <p class="text-gray-500">チェックを入れると、このセクションが公開されます</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 flex justify-end space-x-3">
      <%= link_to "キャンセル", admin_sections_path, 
                  class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <%= form.submit section.persisted? ? "更新する" : "作成する", 
                      class: "bg-blue-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    </div>
  </div>
<% end %>