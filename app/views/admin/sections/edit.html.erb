<% content_for :page_title, "セクション編集" %>

<div class="mb-6">
  <div class="flex items-center text-sm text-gray-500">
    <%= link_to "セクション管理", admin_sections_path, class: "hover:text-gray-700" %>
    <svg class="h-5 w-5 text-gray-400 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
    <%= link_to @section.display_name, admin_section_path(@section), class: "hover:text-gray-700" %>
    <svg class="h-5 w-5 text-gray-400 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
    <span class="text-gray-900">編集</span>
  </div>
</div>

<%= render 'form', section: @section %>