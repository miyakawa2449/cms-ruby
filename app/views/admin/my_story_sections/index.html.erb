<% content_for :title, "My Story セクション管理" %>
<% content_for :page_title, "My Story セクション管理" %>

<div class="sm:flex sm:items-center">
  <div class="sm:flex-auto">
    <p class="mt-2 text-sm text-gray-700">
      My Storyページのセクション構成を管理します。
    </p>
  </div>
  <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
    <%= link_to new_admin_my_story_section_path, 
        class: "inline-flex items-center justify-center rounded-md border border-transparent bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 sm:w-auto" do %>
      <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
      </svg>
      新規セクション
    <% end %>
  </div>
</div>

<!-- 統計情報 -->
<div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-3">
  <div class="bg-white overflow-hidden shadow rounded-lg">
    <div class="p-5">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <div class="ml-5 w-0 flex-1">
          <dl>
            <dt class="text-sm font-medium text-gray-500 truncate">
              総セクション数
            </dt>
            <dd class="text-lg font-medium text-gray-900">
              <%= @total_sections %>
            </dd>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white overflow-hidden shadow rounded-lg">
    <div class="p-5">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <svg class="h-6 w-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="ml-5 w-0 flex-1">
          <dl>
            <dt class="text-sm font-medium text-gray-500 truncate">
              アクティブ
            </dt>
            <dd class="text-lg font-medium text-gray-900">
              <%= @active_sections %>
            </dd>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white overflow-hidden shadow rounded-lg">
    <div class="p-5">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="ml-5 w-0 flex-1">
          <dl>
            <dt class="text-sm font-medium text-gray-500 truncate">
              非アクティブ
            </dt>
            <dd class="text-lg font-medium text-gray-900">
              <%= @inactive_sections %>
            </dd>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- セクション一覧 -->
<div class="mt-8 bg-white shadow overflow-hidden sm:rounded-lg">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-300">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">
                順序
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">
                セクション
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide w-80">
                タイトル
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">
                画像
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">
                ステータス
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">
                更新日時
              </th>
              <th scope="col" class="relative px-6 py-3">
                <span class="sr-only">アクション</span>
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @my_story_sections.each do |section| %>
              <tr class="<%= 'bg-gray-50' unless section.is_active? %>">
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <div class="flex items-center space-x-2">
                    <span class="font-medium"><%= section.position %></span>
                    <div class="flex flex-col space-y-1">
                      <%= link_to move_up_admin_my_story_section_path(section), 
                          data: { turbo_method: :patch }, 
                          class: "text-blue-600 hover:text-blue-800 text-xs",
                          title: "上に移動" do %>
                        ↑
                      <% end %>
                      <%= link_to move_down_admin_my_story_section_path(section), 
                          data: { turbo_method: :patch }, 
                          class: "text-blue-600 hover:text-blue-800 text-xs",
                          title: "下に移動" do %>
                        ↓
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <div>
                    <div class="font-medium text-gray-900"><%= section.section_type_label %></div>
                    <div class="text-gray-500 text-xs"><%= section.section_type %></div>
                  </div>
                </td>
                <td class="px-6 py-4 w-80">
                  <div class="text-sm text-gray-900 font-medium break-words">
                    <%= truncate(strip_tags(section.title.to_s), length: 120) %>
                  </div>
                  <% if section.subtitle.present? %>
                    <div class="text-sm text-gray-500 mt-1">
                      <%= truncate(section.subtitle, length: 80) %>
                    </div>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <div class="flex space-x-1">
                    <% if section.has_background_image? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        背景
                      </span>
                    <% end %>
                    <% if section.has_chapter_image? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        章画像
                      </span>
                    <% end %>
                    <% if section.has_gallery_images? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                        ギャラリー
                      </span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= link_to toggle_active_admin_my_story_section_path(section), 
                      data: { turbo_method: :patch },
                      class: "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium #{section.is_active? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}" do %>
                    <% if section.is_active? %>
                      アクティブ
                    <% else %>
                      非アクティブ
                    <% end %>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= section.updated_at.strftime('%Y/%m/%d %H:%M') %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex justify-end space-x-2">
                    <%= link_to admin_my_story_section_path(section), 
                        class: "text-indigo-600 hover:text-indigo-900" do %>
                      詳細
                    <% end %>
                    <%= link_to edit_admin_my_story_section_path(section), 
                        class: "text-blue-600 hover:text-blue-900" do %>
                      編集
                    <% end %>
                    <%= button_to admin_my_story_section_path(section),
                        method: :delete,
                        data: { turbo_confirm: "セクション「#{section.title}」を削除してもよろしいですか？" },
                        class: "text-red-600 hover:text-red-900 bg-transparent border-0 cursor-pointer",
                        form: { class: "inline" } do %>
                      削除
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
            
            <% if @my_story_sections.empty? %>
              <tr>
                <td colspan="7" class="px-6 py-12 text-center">
                  <div class="text-gray-500">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                    <h3 class="mt-4 text-lg font-medium text-gray-900">セクションが作成されていません</h3>
                    <p class="mt-2 text-sm text-gray-500">最初のMy Storyセクションを作成してください。</p>
                    <div class="mt-6">
                      <%= link_to new_admin_my_story_section_path, 
                          class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" do %>
                        新規セクション作成
                      <% end %>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
    </table>
  </div>
</div>

