<%= form_with model: [:admin, @my_story_section], local: true, multipart: true, class: "space-y-6", data: { controller: "my-story-form" } do |form| %>
  <% if @my_story_section.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.996-.833-2.764 0L3.732 16c-.77.833.192 2.5 1.732 2.5z" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            入力にエラーがあります (<%= @my_story_section.errors.count %>件)
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc list-inside space-y-1">
              <% @my_story_section.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- 基本情報セクション -->
  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg font-medium leading-6 text-gray-900 mb-6">基本情報</h3>
      
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <!-- セクションタイプ -->
        <div class="sm:col-span-1">
          <%= form.label :section_type, "セクションタイプ", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :section_type, 
              options_for_select(@available_section_types, @my_story_section.section_type),
              { prompt: "セクションタイプを選択してください" },
              { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
                data: { my_story_form_target: "sectionType", action: "change->my-story-form#updateFields" } } %>
        </div>

        <!-- 表示順序 -->
        <div class="sm:col-span-1">
          <%= form.label :position, "表示順序", class: "block text-sm font-medium text-gray-700" %>
          <%= form.number_field :position, 
              min: 0, 
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          <p class="mt-1 text-xs text-gray-500">小さい数字ほど上位に表示されます</p>
        </div>

        <!-- タイトル -->
        <div class="sm:col-span-2">
          <%= form.label :title, "タイトル", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :title, 
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
              placeholder: "セクションのタイトルを入力してください" %>
        </div>

        <!-- サブタイトル -->
        <div class="sm:col-span-2">
          <%= form.label :subtitle, "サブタイトル", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :subtitle, 
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
              placeholder: "サブタイトル（任意）" %>
        </div>

        <!-- コンテンツ -->
        <div class="sm:col-span-2">
          <%= form.label :content, "コンテンツ", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_area :content, 
              rows: 8,
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
              placeholder: "セクションのメインコンテンツを入力してください" %>
          <p class="mt-1 text-xs text-gray-500">HTMLタグも利用できます</p>
        </div>
      </div>
    </div>
  </div>

  <!-- 章専用フィールド（Chapter 1-3） -->
  <div class="bg-white shadow sm:rounded-lg" id="chapter-fields" style="display: none;" data-my-story-form-target="chapterFields">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg font-medium leading-6 text-gray-900 mb-6">章の詳細情報</h3>
      
      <div class="space-y-6">
        <!-- スキル -->
        <div>
          <%= form.label :skills, "習得したスキル", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_area :skills, 
              rows: 4,
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
              placeholder: "習得したスキルを改行区切りで入力してください" %>
          <p class="mt-1 text-xs text-gray-500">例: 課題の明確化・分析<br>モチベーション維持・管理</p>
        </div>

        <!-- 実績 -->
        <div>
          <%= form.label :achievements, "主な実績", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_area :achievements, 
              rows: 4,
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
              placeholder: "主な実績や成果を入力してください" %>
          <p class="mt-1 text-xs text-gray-500">この時期の主な実績や貢献について</p>
        </div>

        <!-- 引用文 -->
        <div>
          <%= form.label :quote, "章の引用文", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_area :quote, 
              rows: 3,
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
              placeholder: "この章を象徴する引用文やコメントを入力してください" %>
          <p class="mt-1 text-xs text-gray-500">章の内容を象徴する文章</p>
        </div>
      </div>
    </div>
  </div>

  <!-- 画像アップロードセクション -->
  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg font-medium leading-6 text-gray-900 mb-6">画像</h3>
      
      <div class="grid grid-cols-1 gap-6">
        <!-- 背景画像 -->
        <div>
          <%= form.label :background_image, "背景画像", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md">
            <div class="space-y-1 text-center">
              <% if @my_story_section.has_background_image? %>
                <div class="mb-4">
                  <%= image_tag @my_story_section.background_image, 
                      class: "mx-auto h-32 w-auto object-cover rounded-lg" %>
                  <p class="text-sm text-gray-500 mt-2">現在の背景画像</p>
                </div>
              <% end %>
              <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div class="flex text-sm text-gray-600">
                <%= form.file_field :background_image, 
                    accept: "image/*",
                    class: "sr-only",
                    id: "background_image_upload" %>
                <label for="background_image_upload" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none">
                  <span>ファイルをアップロード</span>
                </label>
                <p class="pl-1">またはドラッグ&ドロップ</p>
              </div>
              <p class="text-xs text-gray-500">
                PNG, JPG, JPEG, WebP ファイル（最大10MB）
              </p>
            </div>
          </div>
        </div>

        <!-- 章画像 -->
        <div>
          <%= form.label :chapter_image, "章画像", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md">
            <div class="space-y-1 text-center">
              <% if @my_story_section.has_chapter_image? %>
                <div class="mb-4">
                  <%= image_tag @my_story_section.chapter_image, 
                      class: "mx-auto h-32 w-auto object-cover rounded-lg" %>
                  <p class="text-sm text-gray-500 mt-2">現在の章画像</p>
                </div>
              <% end %>
              <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div class="flex text-sm text-gray-600">
                <%= form.file_field :chapter_image, 
                    accept: "image/*",
                    class: "sr-only",
                    id: "chapter_image_upload" %>
                <label for="chapter_image_upload" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none">
                  <span>ファイルをアップロード</span>
                </label>
                <p class="pl-1">またはドラッグ&ドロップ</p>
              </div>
              <p class="text-xs text-gray-500">
                PNG, JPG, JPEG, WebP ファイル（最大10MB）
              </p>
            </div>
          </div>
        </div>

        <!-- ギャラリー画像 -->
        <div>
          <%= form.label :gallery_images, "ギャラリー画像", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md">
            <div class="space-y-1 text-center">
              <% if @my_story_section.has_gallery_images? %>
                <div class="mb-4 grid grid-cols-4 gap-2">
                  <% @my_story_section.gallery_images.each do |image| %>
                    <%= image_tag image, class: "h-20 w-20 object-cover rounded-lg" %>
                  <% end %>
                </div>
                <p class="text-sm text-gray-500 mt-2">現在のギャラリー画像（<%= @my_story_section.gallery_images.count %>枚）</p>
              <% end %>
              <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div class="flex text-sm text-gray-600">
                <%= form.file_field :gallery_images, 
                    multiple: true,
                    accept: "image/*",
                    class: "sr-only",
                    id: "gallery_images_upload" %>
                <label for="gallery_images_upload" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none">
                  <span>複数ファイルをアップロード</span>
                </label>
                <p class="pl-1">またはドラッグ&ドロップ</p>
              </div>
              <p class="text-xs text-gray-500">
                PNG, JPG, JPEG, WebP ファイル（最大10MB × 複数可）
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 設定セクション -->
  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg font-medium leading-6 text-gray-900 mb-6">設定</h3>
      
      <div class="space-y-4">
        <!-- アクティブ状態 -->
        <div class="relative flex items-start">
          <div class="flex items-center h-5">
            <%= form.check_box :is_active, 
                class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 rounded" %>
          </div>
          <div class="ml-3 text-sm">
            <%= form.label :is_active, class: "font-medium text-gray-700" do %>
              アクティブ状態
            <% end %>
            <p class="text-gray-500">チェックを入れると公開ページに表示されます</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 追加データ（JSONB）セクション -->
  <div class="bg-white shadow sm:rounded-lg" id="additional-data-section">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg font-medium leading-6 text-gray-900 mb-6">追加データ</h3>
      <p class="text-sm text-gray-600 mb-4">
        セクションタイプに応じて必要な追加情報を設定できます。
      </p>
      
      <!-- 動的コンテンツがJavaScriptで追加される -->
      <div id="dynamic-additional-fields" data-my-story-form-target="dynamicFields">
        <p class="text-sm text-gray-500 italic">
          セクションタイプを選択すると、対応する追加フィールドが表示されます。
        </p>
      </div>
    </div>
  </div>

  <!-- アクションボタン -->
  <div class="flex justify-end space-x-4">
    <%= link_to admin_my_story_sections_path, 
        class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
      キャンセル
    <% end %>
    <%= form.submit (@my_story_section.new_record? ? "セクションを作成" : "セクションを更新"), 
        class: "ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
  </div>
<% end %>

