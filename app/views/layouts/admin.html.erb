<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>管理画面 - Portfolio CMS</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-gray-50">
    <div class="min-h-screen flex">
      <!-- サイドバー -->
      <div class="bg-gray-900 w-64 flex-shrink-0">
        <div class="flex flex-col h-full">
          <!-- ロゴ -->
          <div class="px-6 py-4 bg-gray-800">
            <h2 class="text-xl font-bold text-white">Portfolio CMS</h2>
            <p class="text-xs text-gray-400 mt-1">管理画面</p>
          </div>
          
          <!-- ナビゲーション -->
          <nav class="flex-1 px-4 py-4 space-y-2 overflow-y-auto">
            <%= render 'admin/shared/navigation' %>
          </nav>
          
          <!-- ユーザー情報 -->
          <div class="px-4 py-4 bg-gray-800 border-t border-gray-700">
            <div class="flex items-center">
              <div class="flex-1">
                <p class="text-sm font-medium text-white"><%= current_admin_user.email %></p>
                <p class="text-xs text-gray-400">管理者</p>
              </div>
              <%= button_to destroy_admin_user_session_path, 
                            method: :delete,
                            data: { 
                              turbo_confirm: "ログアウトしますか？" 
                            },
                            class: "text-gray-400 hover:text-white transition-colors bg-transparent border-0 p-0" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      
      <!-- メインコンテンツ -->
      <div class="flex-1 flex flex-col">
        <!-- ヘッダー -->
        <header class="bg-white shadow-sm">
          <div class="px-6 py-4">
            <h1 class="text-2xl font-semibold text-gray-900">
              <%= content_for?(:page_title) ? yield(:page_title) : "ダッシュボード" %>
            </h1>
          </div>
        </header>
        
        <!-- コンテンツエリア -->
        <main class="flex-1 p-6">
          <% if notice.present? %>
            <div class="mb-4 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded">
              <%= notice %>
            </div>
          <% end %>
          
          <% if alert.present? %>
            <div class="mb-4 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded">
              <%= alert %>
            </div>
          <% end %>

          <%# リカバリー警告（仕様FR-3）: パスキーが1系統のみだとデバイス紛失で締め出しの恐れ %>
          <% if current_admin_user && current_admin_user.passkey_credentials.count == 1 %>
            <div class="mb-4 bg-yellow-50 border border-yellow-300 rounded-md px-4 py-3 text-sm text-yellow-800">
              ⚠️ パスキーが1つしか登録されていません。デバイス紛失に備えて、
              <%= link_to "別のプラットフォームでもう1つ登録", admin_passkeys_path, class: "underline font-medium" %>
              することを強くおすすめします。
            </div>
          <% end %>

          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>