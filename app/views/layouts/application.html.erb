<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  
  <!-- Primary Meta Tags -->
  <title><%= content_for?(:title) ? yield(:title) : "宮川 剛 - Portfolio | シニアエンジニアの技術発信サイト" %></title>
  <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "30年のキャリアを持つシニアエンジニア宮川剛のポートフォリオサイト。要件定義からプログラミングまで一貫対応。Ruby on Rails、AI活用、プロジェクト管理の実践的な技術情報を発信。" %>">
  <meta name="keywords" content="<%= content_for?(:keywords) ? yield(:keywords) : "宮川剛,シニアエンジニア,Ruby on Rails,AI活用,ChatGPT,要件定義,プロジェクト管理,SE,PM,プログラミング" %>">
  <meta name="author" content="宮川 剛">
  <meta name="robots" content="index, follow">
  
  <!-- Canonical URL -->
  <link rel="canonical" href="<%= content_for?(:canonical_url) ? yield(:canonical_url) : request.original_url %>">
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="<%= content_for?(:og_type) ? yield(:og_type) : "website" %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:title" content="<%= content_for?(:og_title) ? yield(:og_title) : (content_for?(:title) ? yield(:title) : "宮川 剛 - Portfolio") %>">
  <meta property="og:description" content="<%= content_for?(:og_description) ? yield(:og_description) : (content_for?(:description) ? yield(:description) : "30年のキャリアを持つシニアエンジニアの技術発信サイト") %>">
  <meta property="og:image" content="<%= content_for?(:og_image) ? yield(:og_image) : asset_url('og-default.jpg') %>">
  <meta property="og:site_name" content="Miyakawa Codes">
  <meta property="og:locale" content="ja_JP">
  
  <!-- Twitter -->
  <meta property="twitter:card" content="<%= content_for?(:twitter_card) ? yield(:twitter_card) : "summary_large_image" %>">
  <meta property="twitter:url" content="<%= request.original_url %>">
  <meta property="twitter:title" content="<%= content_for?(:og_title) ? yield(:og_title) : (content_for?(:title) ? yield(:title) : "宮川 剛 - Portfolio") %>">
  <meta property="twitter:description" content="<%= content_for?(:og_description) ? yield(:og_description) : (content_for?(:description) ? yield(:description) : "30年のキャリアを持つシニアエンジニアの技術発信サイト") %>">
  <meta property="twitter:image" content="<%= content_for?(:twitter_image) ? yield(:twitter_image) : asset_url('twitter-card.jpg') %>">
  
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <%= yield :head %>
  
  <!-- Preconnect to external resources -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet">
  
  <!-- PWA manifest -->
  <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
  
  <!-- Favicon and Touch Icons -->
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">
  
  <!-- Theme Color -->
  <meta name="theme-color" content="#667eea">
  
  <!-- Stylesheets -->
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  
  <!-- JavaScript -->
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  
  <!-- Page-specific JavaScript -->
  <%= yield :javascript %>
  
  <!-- Structured Data -->
  <% if content_for?(:structured_data) %>
    <%= yield(:structured_data) %>
  <% else %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "宮川 剛",
      "jobTitle": "Senior Software Engineer",
      "description": "30年のIT業界経験を持つシニアエンジニア",
      "url": "<%= request.base_url %>"
    }
    </script>
  <% end %>
</head>

<body class="<%= content_for?(:body_class) ? yield(:body_class) : '' %>">
  <%= yield %>
</body>
</html>