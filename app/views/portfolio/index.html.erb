<% content_for :title, SiteSetting.site_title.get_value %>
<% content_for :description, SiteSetting.site_description.get_value %>
<% content_for :meta_tags, portfolio_meta_tags %>

<!-- Header -->
<header class="fixed top-0 w-full bg-white/90 backdrop-blur-sm border-b border-gray-200 z-50">
  <nav class="container mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <!-- Logo -->
        <%= site_logo(class: 'h-10 w-auto max-w-40') %>
        <!-- Site Name -->
        <div class="text-xl font-bold text-gray-900">
          Miyakawa Codes
        </div>
      </div>
      <div class="hidden md:flex space-x-8">
        <a href="#hero" class="text-blue-600 font-semibold hover:text-blue-800 transition-colors">Home</a>
        <a href="#about" class="text-gray-700 hover:text-blue-600 transition-colors">About</a>
        <a href="#service" class="text-gray-700 hover:text-blue-600 transition-colors">Services</a>
        <a href="#my-story" class="text-gray-700 hover:text-blue-600 transition-colors">💡 My Story</a>
        <a href="#works" class="text-gray-700 hover:text-blue-600 transition-colors">Works</a>
        <a href="#blog" class="text-gray-700 hover:text-blue-600 transition-colors">Blog</a>
        <a href="#contact" class="text-gray-700 hover:text-blue-600 transition-colors">Contact</a>
      </div>
      <div class="flex items-center space-x-4">
        <%= form_with url: root_path, method: :get, local: true, class: "relative" do |form| %>
          <%= form.text_field :search, 
              value: params[:search],
              placeholder: "検索...", 
              class: "pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
              onkeydown: "if(event.key==='Enter'){this.form.submit();}" %>
          <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        <% end %>
        <button class="md:hidden">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<!-- Main Content -->
<main class="pt-20">
  <% @sections.each do |section| %>
    <% content_data = @section_data[section.name] || {} %>
    <% 
      # 個別フィールドを使用するセクションはcontent_dataが空でもOK
      individual_field_sections = ['hero', 'about', 'my-story', 'works']
      # active_contentがない場合は、個別フィールドセクション以外はスキップ
      next unless section.active_content || individual_field_sections.include?(section.name)
      next if content_data.empty? && !individual_field_sections.include?(section.name)
    %>
    
    <section id="<%= section.name %>" class="section-spacing">
      <%= render "portfolio/sections/#{section.name}", section: section, content: content_data %>
    </section>
  <% end %>
</main>

<!-- Footer -->
