<div class="py-20 bg-gray-50">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto">
      <!-- ヘッダー -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          <%= content['title'] || 'Works' %>
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          これまで手がけたプロジェクトの一部をご紹介します。要件定義から実装まで一貫して担当した実績です。
        </p>
      </div>
      
      <!-- プロジェクト一覧 -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        <% if content['works'].present? && content['works'].is_a?(Array) %>
          <% content['works'].each do |work| %>
            <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
              <% if work['image'].present? %>
                <div class="h-48 bg-gradient-to-br from-blue-100 to-blue-200">
                  <img src="<%= work['image'] %>" alt="<%= work['title'] %>" class="w-full h-full object-cover">
                </div>
              <% else %>
                <div class="h-48 bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center">
                  <svg class="w-16 h-16 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                  </svg>
                </div>
              <% end %>
              
              <div class="p-6">
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                  <%= work['title'] %>
                </h3>
                
                <p class="text-gray-600 leading-relaxed mb-4">
                  <%= work['description'] %>
                </p>
                
                <% if work['tech'].present? && work['tech'].is_a?(Array) %>
                  <div class="flex flex-wrap gap-2 mb-4">
                    <% work['tech'].each do |tech| %>
                      <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded">
                        <%= tech %>
                      </span>
                    <% end %>
                  </div>
                <% end %>
                
                <% if work['url'].present? %>
                  <a href="<%= work['url'] %>" target="_blank" rel="noopener" 
                     class="text-blue-600 hover:text-blue-700 font-medium flex items-center">
                    詳細を見る
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                  </a>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <!-- デフォルトプロジェクト -->
          <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
            <div class="h-48 bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center">
              <svg class="w-16 h-16 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
              </svg>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-3">ECサイト構築プロジェクト</h3>
              <p class="text-gray-600 leading-relaxed mb-4">
                大規模ECサイトの要件定義から実装まで担当。決済システム連携、在庫管理システムの構築。
              </p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded">Ruby on Rails</span>
                <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded">PostgreSQL</span>
                <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded">AWS</span>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
            <div class="h-48 bg-gradient-to-br from-green-100 to-green-200 flex items-center justify-center">
              <svg class="w-16 h-16 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-3">業務管理システム</h3>
              <p class="text-gray-600 leading-relaxed mb-4">
                中規模企業の業務管理システム開発。ワークフロー設計からAPI実装まで包括的に担当。
              </p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded">Rails API</span>
                <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded">React</span>
                <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded">Docker</span>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
            <div class="h-48 bg-gradient-to-br from-purple-100 to-purple-200 flex items-center justify-center">
              <svg class="w-16 h-16 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-3">教育管理プラットフォーム</h3>
              <p class="text-gray-600 leading-relaxed mb-4">
                オンライン教育プラットフォームの構築。動画配信機能、進捗管理機能の実装。
              </p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="bg-purple-100 text-purple-800 text-xs font-medium px-2.5 py-0.5 rounded">Ruby on Rails</span>
                <span class="bg-purple-100 text-purple-800 text-xs font-medium px-2.5 py-0.5 rounded">Stimulus</span>
                <span class="bg-purple-100 text-purple-800 text-xs font-medium px-2.5 py-0.5 rounded">Redis</span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <!-- 実績サマリー -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-16">
        <div class="text-center">
          <div class="text-4xl font-bold text-blue-600 mb-2">20+</div>
          <p class="text-gray-600">年の経験</p>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-green-600 mb-2">50+</div>
          <p class="text-gray-600">プロジェクト</p>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-purple-600 mb-2">100%</div>
          <p class="text-gray-600">成功率</p>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-orange-600 mb-2">3</div>
          <p class="text-gray-600">フェーズキャリア</p>
        </div>
      </div>
      
      <!-- CTA -->
      <div class="text-center">
        <p class="text-lg text-gray-600 mb-6">
          あなたのプロジェクトも同じ品質で実現できます
        </p>
        <a href="#contact" class="bg-blue-600 text-white font-semibold py-4 px-8 rounded-lg hover:bg-blue-700 transition-colors">
          プロジェクト相談をする
        </a>
      </div>
    </div>
  </div>
</div>