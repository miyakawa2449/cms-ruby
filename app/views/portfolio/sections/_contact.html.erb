<section id="contact" class="py-20 bg-gray-900 text-white">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto">
      <!-- ヘッダー -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">
          <%= content['title'] || 'Contact' %>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          <%= content['description'] || 'プロジェクトのご相談やご質問がございましたら、お気軽にお問い合わせください。' %>
        </p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- 入力フォーム -->
        <div data-controller="contact-form">
          <h3 class="text-2xl font-bold mb-8">入力フォーム</h3>
          
          <!-- メッセージ表示エリア（ここに成功/エラーメッセージが表示される） -->
          <div data-contact-form-target="messageArea"></div>
          
          <form data-contact-form-target="form"
                data-action="submit->contact-form#submit"
                action="/contacts" method="post" class="space-y-6">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

            <%# Honeypot field - ボット対策（人間には見えない） %>
            <div style="position: absolute; left: -9999px;" aria-hidden="true">
              <label for="contact_website">Website</label>
              <input type="text" id="contact_website" name="contact[website]" tabindex="-1" autocomplete="off">
            </div>

            <div>
              <label for="contact_name" class="block text-sm font-medium text-gray-300 mb-2">お名前 *</label>
              <input type="text" id="contact_name" name="contact[name]" required
                     class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-white placeholder-gray-400"
                     placeholder="山田太郎">
            </div>
            
            <div>
              <label for="contact_email" class="block text-sm font-medium text-gray-300 mb-2">メールアドレス *</label>
              <input type="email" id="contact_email" name="contact[email]" required
                     class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-white placeholder-gray-400"
                     placeholder="example@example.com">
            </div>
            
            <div>
              <label for="contact_subject" class="block text-sm font-medium text-gray-300 mb-2">件名 *</label>
              <select id="contact_subject" name="contact[subject]" required
                      class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-white">
                <option value="">件名を選択してください</option>
                <option value="新規開発">新規システム開発</option>
                <option value="既存改修">既存システム改修</option>
                <option value="要件定義">要件定義支援</option>
                <option value="プロジェクト管理">プロジェクト管理支援</option>
                <option value="技術相談">技術相談</option>
                <option value="その他">その他</option>
              </select>
            </div>
            
            <div>
              <label for="contact_message" class="block text-sm font-medium text-gray-300 mb-2">メッセージ *</label>
              <textarea id="contact_message" name="contact[message]" rows="6" required
                        class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-white placeholder-gray-400"
                        placeholder="プロジェクトの詳細やご質問内容をお聞かせください"></textarea>
            </div>
            
            <div class="text-sm text-gray-400">
              送信いただいた情報は、お問い合わせ対応のためのみに使用します。
            </div>
            
            <button type="submit" 
                    data-contact-form-target="button"
                    class="w-full bg-blue-600 text-white font-semibold py-4 px-6 rounded-lg hover:bg-blue-700 transition-all duration-300 transform hover:scale-105">
              メッセージを送信
            </button>
          </form>
        </div>
        
        <!-- 連絡先情報 -->
        <div>
          <h3 class="text-2xl font-bold mb-8">連絡先情報</h3>
          
          <div class="space-y-8">
            <!-- メール -->
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-lg mb-1">メール</h4>
                <p class="text-gray-300 mb-2">お気軽にメールでお問い合わせください</p>
                <% contact_email = ENV.fetch("CONTACT_EMAIL", ENV.fetch("ADMIN_EMAIL", "contact@example.test")) %>
                <a href="mailto:<%= content['email'] || contact_email %>" 
                   class="text-blue-400 hover:text-blue-300 transition-colors">
                  <%= content['email'] || contact_email %>
                </a>
              </div>
            </div>
            
            <!-- 所在地 -->
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-green-600 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-lg mb-1">所在地</h4>
                <p class="text-gray-300">事務所:<br>東京都渋谷区円山町5番3号<br>MIEUX渋谷ビル8階</p>
                <p class="text-gray-300 mt-2">活動拠点: 石川県金沢市</p>
                <p class="text-gray-400 text-sm mt-1">リモートワーク中心で全国対応可能</p>
              </div>
            </div>
            
            <!-- レスポンス時間 -->
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-purple-600 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-lg mb-1">レスポンス時間</h4>
                <p class="text-gray-300">3営業日以内にご返信いたします</p>
                <p class="text-gray-400 text-sm mt-1">営業時間: 月曜〜木曜 10:00-16:00</p>
              </div>
            </div>
          </div>
          
          
          <!-- 追加情報 -->
          <div class="mt-12 p-6 bg-gray-800 rounded-xl">
            <h4 class="font-semibold text-lg mb-3">🚀 プロジェクト開始までの流れ</h4>
            <ol class="space-y-2 text-sm text-gray-300">
              <li class="flex items-center">
                <span class="w-6 h-6 bg-blue-600 text-white text-xs font-bold rounded-full flex items-center justify-center mr-3">1</span>
                お問い合わせフォーム送信
              </li>
              <li class="flex items-center">
                <span class="w-6 h-6 bg-blue-600 text-white text-xs font-bold rounded-full flex items-center justify-center mr-3">2</span>
                ヒアリング（オンライン・無料）
              </li>
              <li class="flex items-center">
                <span class="w-6 h-6 bg-blue-600 text-white text-xs font-bold rounded-full flex items-center justify-center mr-3">3</span>
                お見積もり・提案書作成
              </li>
              <li class="flex items-center">
                <span class="w-6 h-6 bg-blue-600 text-white text-xs font-bold rounded-full flex items-center justify-center mr-3">4</span>
                契約・プロジェクト開始
              </li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
