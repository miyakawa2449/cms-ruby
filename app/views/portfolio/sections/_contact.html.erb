<div class="py-20 bg-gray-900 text-white">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto">
      <!-- ヘッダー -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">
          <%= content['title'] || 'Contact' %>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          <%= content['description'] || 'プロジェクトのご相談やご質問がございましたら、お気軽にお問い合わせください。' %>
        </p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- お問い合わせフォーム -->
        <div>
          <h3 class="text-2xl font-bold mb-8">お問い合わせフォーム</h3>
          
          <form action="/contact" method="post" class="space-y-6">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            
            <div>
              <label for="name" class="block text-sm font-medium text-gray-300 mb-2">お名前 *</label>
              <input type="text" id="name" name="name" required
                     class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-white placeholder-gray-400"
                     placeholder="山田太郎">
            </div>
            
            <div>
              <label for="email" class="block text-sm font-medium text-gray-300 mb-2">メールアドレス *</label>
              <input type="email" id="email" name="email" required
                     class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-white placeholder-gray-400"
                     placeholder="example@example.com">
            </div>
            
            <div>
              <label for="company" class="block text-sm font-medium text-gray-300 mb-2">会社名</label>
              <input type="text" id="company" name="company"
                     class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-white placeholder-gray-400"
                     placeholder="株式会社サンプル">
            </div>
            
            <div>
              <label for="subject" class="block text-sm font-medium text-gray-300 mb-2">件名 *</label>
              <select id="subject" name="subject" required
                      class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-white">
                <option value="">件名を選択してください</option>
                <option value="新規開発">新規システム開発</option>
                <option value="既存改修">既存システム改修</option>
                <option value="要件定義">要件定義支援</option>
                <option value="プロジェクト管理">プロジェクト管理支援</option>
                <option value="技術相談">技術相談</option>
                <option value="その他">その他</option>
              </select>
            </div>
            
            <div>
              <label for="message" class="block text-sm font-medium text-gray-300 mb-2">メッセージ *</label>
              <textarea id="message" name="message" rows="6" required
                        class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-white placeholder-gray-400"
                        placeholder="プロジェクトの詳細やご質問内容をお聞かせください"></textarea>
            </div>
            
            <div class="flex items-center">
              <input type="checkbox" id="privacy" name="privacy" required
                     class="w-4 h-4 text-blue-600 bg-gray-800 border-gray-700 rounded focus:ring-blue-500">
              <label for="privacy" class="ml-2 text-sm text-gray-300">
                <a href="/privacy" class="text-blue-400 hover:text-blue-300 underline">プライバシーポリシー</a>に同意します
              </label>
            </div>
            
            <button type="submit" 
                    class="w-full bg-blue-600 text-white font-semibold py-4 px-6 rounded-lg hover:bg-blue-700 transition-all duration-300 transform hover:scale-105">
              メッセージを送信
            </button>
          </form>
        </div>
        
        <!-- 連絡先情報 -->
        <div>
          <h3 class="text-2xl font-bold mb-8">連絡先情報</h3>
          
          <div class="space-y-8">
            <!-- メール -->
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-lg mb-1">メール</h4>
                <p class="text-gray-300 mb-2">お気軽にメールでお問い合わせください</p>
                <a href="mailto:<%= content['email'] || 'contact@miyakawa.code' %>" 
                   class="text-blue-400 hover:text-blue-300 transition-colors">
                  <%= content['email'] || 'contact@miyakawa.code' %>
                </a>
              </div>
            </div>
            
            <!-- 所在地 -->
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-green-600 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-lg mb-1">所在地</h4>
                <p class="text-gray-300">東京都内</p>
                <p class="text-gray-400 text-sm mt-1">リモートワーク中心で全国対応可能</p>
              </div>
            </div>
            
            <!-- レスポンス時間 -->
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-purple-600 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-lg mb-1">レスポンス時間</h4>
                <p class="text-gray-300">通常24時間以内にご返信します</p>
                <p class="text-gray-400 text-sm mt-1">営業時間: 平日 9:00-18:00</p>
              </div>
            </div>
          </div>
          
          <!-- ソーシャルリンク -->
          <div class="mt-12">
            <h4 class="font-semibold text-lg mb-6">SNS・その他</h4>
            <div class="flex space-x-4">
              <% if content['social_links'].present? && content['social_links'].is_a?(Array) %>
                <% content['social_links'].each do |link| %>
                  <a href="<%= link['url'] %>" target="_blank" rel="noopener"
                     class="w-12 h-12 bg-gray-800 rounded-full flex items-center justify-center hover:bg-gray-700 transition-colors">
                    <% case link['platform']&.downcase %>
                    <% when 'github' %>
                      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                      </svg>
                    <% when 'linkedin' %>
                      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                      </svg>
                    <% when 'twitter' %>
                      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                      </svg>
                    <% else %>
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                      </svg>
                    <% end %>
                  </a>
                <% end %>
              <% else %>
                <!-- デフォルトソーシャルリンク -->
                <a href="https://github.com/miyakawa2449" target="_blank" rel="noopener"
                   class="w-12 h-12 bg-gray-800 rounded-full flex items-center justify-center hover:bg-gray-700 transition-colors">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                </a>
                
                <a href="https://linkedin.com/in/miyakawa" target="_blank" rel="noopener"
                   class="w-12 h-12 bg-gray-800 rounded-full flex items-center justify-center hover:bg-gray-700 transition-colors">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
                
                <a href="https://twitter.com/miyakawa_dev" target="_blank" rel="noopener"
                   class="w-12 h-12 bg-gray-800 rounded-full flex items-center justify-center hover:bg-gray-700 transition-colors">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                  </svg>
                </a>
              <% end %>
            </div>
          </div>
          
          <!-- 追加情報 -->
          <div class="mt-12 p-6 bg-gray-800 rounded-xl">
            <h4 class="font-semibold text-lg mb-3">🚀 プロジェクト開始までの流れ</h4>
            <ol class="space-y-2 text-sm text-gray-300">
              <li class="flex items-center">
                <span class="w-6 h-6 bg-blue-600 text-white text-xs font-bold rounded-full flex items-center justify-center mr-3">1</span>
                お問い合わせフォーム送信
              </li>
              <li class="flex items-center">
                <span class="w-6 h-6 bg-blue-600 text-white text-xs font-bold rounded-full flex items-center justify-center mr-3">2</span>
                ヒアリング（オンライン・無料）
              </li>
              <li class="flex items-center">
                <span class="w-6 h-6 bg-blue-600 text-white text-xs font-bold rounded-full flex items-center justify-center mr-3">3</span>
                お見積もり・提案書作成
              </li>
              <li class="flex items-center">
                <span class="w-6 h-6 bg-blue-600 text-white text-xs font-bold rounded-full flex items-center justify-center mr-3">4</span>
                契約・プロジェクト開始
              </li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>