<div class="py-20 bg-gray-50">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto">
      <!-- ヘッダー -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          <%= content['title'] || 'Service' %>
        </h2>
        <p class="text-2xl text-gray-700 font-medium">
          提供できるサービス
        </p>
      </div>
      
      <!-- サービス一覧 -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% if content['services'].present? && content['services'].is_a?(Array) %>
          <% content['services'].each do |service| %>
            <div class="bg-gray-50 rounded-xl p-8 hover:bg-white hover:shadow-xl transition-all duration-300 border border-transparent hover:border-blue-200">
              <% if service['icon'].present? %>
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-6">
                  <!-- アイコンの実装は後で -->
                  <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                  </svg>
                </div>
              <% end %>
              
              <h3 class="text-xl font-bold text-gray-900 mb-4">
                <%= service['title'] %>
              </h3>
              
              <p class="text-gray-600 leading-relaxed mb-6">
                <%= service['description'] %>
              </p>
              
              <% if service['features'].present? && service['features'].is_a?(Array) %>
                <ul class="space-y-2">
                  <% service['features'].each do |feature| %>
                    <li class="flex items-center text-sm text-gray-600">
                      <svg class="w-4 h-4 text-blue-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      <%= feature %>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <!-- デフォルトサービス -->
          <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 text-center">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">要件定義・設計</h3>
            <p class="text-gray-600 leading-relaxed">
              上流工程の専門性を活かした詳細な要件定義と設計書作成
            </p>
          </div>
          
          <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 text-center">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">システム開発</h3>
            <p class="text-gray-600 leading-relaxed">
              フルスタック対応でのWebアプリケーション・システム開発
            </p>
          </div>
          
          <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 text-center">
            <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">AI・DXコンサル</h3>
            <p class="text-gray-600 leading-relaxed">
              最新技術を活用したデジタルトランスフォーメーション支援
            </p>
          </div>
        <% end %>
      </div>
      
      <!-- CTA -->
      <div class="text-center mt-16">
        <p class="text-lg text-gray-600 mb-6">
          プロジェクトのご相談やお見積もりは無料で承っています
        </p>
        <a href="#contact" class="bg-blue-600 text-white font-semibold py-4 px-8 rounded-lg hover:bg-blue-700 transition-colors">
          お問い合わせ
        </a>
      </div>
    </div>
  </div>
</div>