<div class="py-20 bg-white">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto">
      <!-- ヘッダー -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          <%= content['title'] || 'Services' %>
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          要件定義からプログラミングまで一人で完結できる強みを活かし、
          お客様のビジネス課題に最適なソリューションを提供します。
        </p>
      </div>
      
      <!-- サービス一覧 -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% if content['services'].present? && content['services'].is_a?(Array) %>
          <% content['services'].each do |service| %>
            <div class="bg-gray-50 rounded-xl p-8 hover:bg-white hover:shadow-xl transition-all duration-300 border border-transparent hover:border-blue-200">
              <% if service['icon'].present? %>
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-6">
                  <!-- アイコンの実装は後で -->
                  <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                  </svg>
                </div>
              <% end %>
              
              <h3 class="text-xl font-bold text-gray-900 mb-4">
                <%= service['title'] %>
              </h3>
              
              <p class="text-gray-600 leading-relaxed mb-6">
                <%= service['description'] %>
              </p>
              
              <% if service['features'].present? && service['features'].is_a?(Array) %>
                <ul class="space-y-2">
                  <% service['features'].each do |feature| %>
                    <li class="flex items-center text-sm text-gray-600">
                      <svg class="w-4 h-4 text-blue-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      <%= feature %>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <!-- デフォルトサービス -->
          <div class="bg-gray-50 rounded-xl p-8 hover:bg-white hover:shadow-xl transition-all duration-300 border border-transparent hover:border-blue-200">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">要件定義・設計</h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              お客様のビジネス要件を正確に把握し、技術的な要件に落とし込みます。上流工程の専門家として最適なソリューションを設計します。
            </p>
            <ul class="space-y-2">
              <li class="flex items-center text-sm text-gray-600">
                <svg class="w-4 h-4 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                ビジネス要件分析
              </li>
              <li class="flex items-center text-sm text-gray-600">
                <svg class="w-4 h-4 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                システム設計書作成
              </li>
              <li class="flex items-center text-sm text-gray-600">
                <svg class="w-4 h-4 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                技術選定・アーキテクチャ設計
              </li>
            </ul>
          </div>
          
          <div class="bg-gray-50 rounded-xl p-8 hover:bg-white hover:shadow-xl transition-all duration-300 border border-transparent hover:border-blue-200">
            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">フルスタック開発</h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              フロントエンドからバックエンドまで一人で開発できます。Ruby on Railsを中心とした現代的な技術スタックで高品質なアプリケーションを構築します。
            </p>
            <ul class="space-y-2">
              <li class="flex items-center text-sm text-gray-600">
                <svg class="w-4 h-4 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Ruby on Rails開発
              </li>
              <li class="flex items-center text-sm text-gray-600">
                <svg class="w-4 h-4 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                データベース設計・最適化
              </li>
              <li class="flex items-center text-sm text-gray-600">
                <svg class="w-4 h-4 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                API設計・実装
              </li>
            </ul>
          </div>
          
          <div class="bg-gray-50 rounded-xl p-8 hover:bg-white hover:shadow-xl transition-all duration-300 border border-transparent hover:border-blue-200">
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">プロジェクト管理</h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              20年以上のプロジェクト管理経験を活かし、チーム統率から進捗管理まで包括的にサポートします。
            </p>
            <ul class="space-y-2">
              <li class="flex items-center text-sm text-gray-600">
                <svg class="w-4 h-4 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                アジャイル開発支援
              </li>
              <li class="flex items-center text-sm text-gray-600">
                <svg class="w-4 h-4 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                チーム統率・コーチング
              </li>
              <li class="flex items-center text-sm text-gray-600">
                <svg class="w-4 h-4 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                リスク管理・品質保証
              </li>
            </ul>
          </div>
        <% end %>
      </div>
      
      <!-- CTA -->
      <div class="text-center mt-16">
        <p class="text-lg text-gray-600 mb-6">
          プロジェクトのご相談やお見積もりは無料で承っています
        </p>
        <a href="#contact" class="bg-blue-600 text-white font-semibold py-4 px-8 rounded-lg hover:bg-blue-700 transition-colors">
          お問い合わせ
        </a>
      </div>
    </div>
  </div>
</div>