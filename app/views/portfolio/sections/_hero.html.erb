<div class="min-h-screen flex items-center justify-center relative overflow-hidden"
     style="background: linear-gradient(135deg, #1e3a8a 0%, #3730a3 50%, #581c87 100%);">
  
  <!-- 背景画像（管理画面でアップロードされた場合） -->
  <% if section.active_content&.hero_image&.attached? %>
    <div class="absolute inset-0">
      <%= image_tag section.active_content.hero_image, 
          class: "w-full h-full object-cover",
          alt: "Hero background" %>
    </div>
    <div class="absolute inset-0 bg-black opacity-40"></div>
  <% else %>
    <!-- デフォルト背景装飾 -->
    <div class="absolute inset-0 bg-black opacity-20"></div>
  <% end %>
  
  <!-- 装飾要素 -->
  <div class="absolute inset-0">
    <div class="absolute top-1/4 left-1/4 w-72 h-72 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/3 right-1/4 w-96 h-96 bg-blue-400/20 rounded-full blur-3xl"></div>
  </div>
  
  <div class="container mx-auto px-6 text-center relative z-10">
    <div class="max-w-4xl mx-auto">
      <!-- メインメッセージ -->
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
        <% if section.active_content&.main_message.present? %>
          <%= simple_format(section.active_content.main_message, {}, wrapper_tag: nil) %>
        <% else %>
          パソコン講師→SE/PM→AIエンジニア<br>
          要件定義から実装まで<br>
          <span class="text-yellow-300">一人でできる理由がある</span>
        <% end %>
      </h1>
      
      <!-- サブメッセージ -->
      <p class="text-xl md:text-2xl text-blue-100 mb-4 leading-relaxed">
        <%= section.active_content&.sub_message.presence || '30年のキャリアで培った独自のスキルセット' %>
      </p>
      
      <!-- キャリア説明 -->
      <div class="text-lg text-blue-200 mb-8">
        <%= section.active_content&.career_description.presence || '講師経験 × SE/PM 16年 × プログラミング × AI活用' %>
      </div>
      
      <!-- CTAボタン -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <% if section.active_content&.cta_primary_text.present? %>
          <a href="<%= section.active_content.cta_primary_url.presence || '/my-story' %>" 
             class="bg-yellow-400 text-blue-900 font-bold py-4 px-8 rounded-lg hover:bg-yellow-300 transition-all duration-300 transform hover:scale-105 shadow-lg">
            <%= section.active_content.cta_primary_text %>
          </a>
        <% end %>
        
        <% if section.active_content&.cta_secondary_text.present? %>
          <a href="<%= section.active_content.cta_secondary_url.presence || '#contact' %>" 
             class="border-2 border-white text-white font-semibold py-4 px-8 rounded-lg hover:bg-white hover:text-blue-600 transition-all duration-300">
            <%= section.active_content.cta_secondary_text %>
          </a>
        <% else %>
          <a href="#contact" 
             class="border-2 border-white text-white font-semibold py-4 px-8 rounded-lg hover:bg-white hover:text-blue-600 transition-all duration-300">
            お問い合わせ
          </a>
        <% end %>
      </div>
      
      <!-- スクロール促進アニメーション -->
      <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
        <a href="#about" class="text-white opacity-75 hover:opacity-100 transition-opacity">
          <svg class="w-8 h-8 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
          <p class="text-sm mt-2">Scroll</p>
        </a>
      </div>
    </div>
  </div>
</div>