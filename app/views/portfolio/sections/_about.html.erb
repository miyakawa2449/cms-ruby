<div class="py-20 bg-gray-50">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">About</h2>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
        <!-- プロフィール画像セクション -->
        <div class="flex justify-center lg:justify-end">
          <div class="relative">
            <% if section.active_content&.profile_image&.attached? %>
              <div class="w-80 h-80 rounded-full overflow-hidden shadow-xl bg-gradient-to-br from-blue-100 to-blue-200">
                <%= image_tag section.active_content.profile_image, 
                    class: "w-full h-full object-cover",
                    alt: "宮川剛のプロフィール" %>
              </div>
            <% else %>
              <!-- プレースホルダー -->
              <div class="w-80 h-80 bg-gradient-to-br from-blue-100 to-blue-200 rounded-full overflow-hidden shadow-xl">
                <div class="w-full h-full flex items-center justify-center">
                  <div class="text-8xl font-bold text-blue-400">宮</div>
                </div>
              </div>
            <% end %>
            <!-- 装飾要素 -->
            <div class="absolute -top-4 -right-4 w-24 h-24 bg-blue-500/20 rounded-full blur-xl"></div>
            <div class="absolute -bottom-4 -left-4 w-32 h-32 bg-purple-500/20 rounded-full blur-xl"></div>
          </div>
        </div>
        
        <!-- メインコンテンツ -->
        <div class="lg:col-span-2 space-y-8">
          <!-- プロフィールセクション -->
          <div>
            <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">About Me</h2>
            
            <div class="text-lg text-gray-600 leading-relaxed mb-8">
              <% if section.active_content&.profile_text.present? %>
                <%= simple_format(section.active_content.profile_text) %>
              <% else %>
                <p>
                  システムエンジニア・プロジェクトマネージャとして20年以上の経験を持つエンジニアです。
                  要件定義から実装まで一貫して担当できる幅広いスキルを持っています。
                </p>
                <p>
                  特に上流工程の専門家として、ビジネス要件の分析から技術的な解決策の提案まで、
                  プロジェクト全体を見渡した最適なソリューションを提供します。
                </p>
              <% end %>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="#my-story" class="bg-blue-600 text-white font-semibold py-3 px-6 rounded-lg hover:bg-blue-700 transition-colors text-center">
                💡 My Storyを見る
              </a>
              <a href="#works" class="border border-blue-600 text-blue-600 font-semibold py-3 px-6 rounded-lg hover:bg-blue-50 transition-colors text-center">
                実績を見る
              </a>
            </div>
          </div>
          
          <!-- スキルセクション -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Frontend Skills -->
            <div class="bg-blue-50 rounded-xl p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                <span class="text-2xl mr-3">💻</span>
                Frontend
              </h3>
              <div class="flex flex-wrap gap-2">
                <% if section.active_content&.frontend_skills.present? %>
                  <% section.active_content.frontend_skills.split(',').map(&:strip).reject(&:blank?).each do |skill| %>
                    <span class="inline-block bg-blue-200 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
                      <%= skill %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="inline-block bg-blue-200 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">Ruby/Rails</span>
                  <span class="inline-block bg-blue-200 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">Python</span>
                  <span class="inline-block bg-blue-200 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">JavaScript</span>
                <% end %>
              </div>
            </div>
            
            <!-- Backend Skills -->
            <div class="bg-green-50 rounded-xl p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                <span class="text-2xl mr-3">⚙️</span>
                Backend
              </h3>
              <div class="flex flex-wrap gap-2">
                <% if section.active_content&.backend_skills.present? %>
                  <% section.active_content.backend_skills.split(',').map(&:strip).reject(&:blank?).each do |skill| %>
                    <span class="inline-block bg-green-200 text-green-800 px-3 py-1 rounded-full text-sm font-medium">
                      <%= skill %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="inline-block bg-green-200 text-green-800 px-3 py-1 rounded-full text-sm font-medium">PostgreSQL</span>
                  <span class="inline-block bg-green-200 text-green-800 px-3 py-1 rounded-full text-sm font-medium">AWS</span>
                  <span class="inline-block bg-green-200 text-green-800 px-3 py-1 rounded-full text-sm font-medium">Docker</span>
                <% end %>
              </div>
            </div>
          </div>
          
          <!-- Core Skills & Experience -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Core Skills -->
            <div>
              <h3 class="text-2xl font-bold text-gray-900 mb-4 flex items-center">
                <span class="text-2xl mr-3">🎯</span>
                Core Skills
              </h3>
              <div class="text-gray-600">
                <% if section.active_content&.core_skills.present? %>
                  <%= simple_format(section.active_content.core_skills) %>
                <% else %>
                  <ul class="space-y-2">
                    <li class="flex items-center"><span class="text-blue-500 mr-2">▪</span>要件定義・設計</li>
                    <li class="flex items-center"><span class="text-blue-500 mr-2">▪</span>プロジェクト管理</li>
                    <li class="flex items-center"><span class="text-blue-500 mr-2">▪</span>技術選定</li>
                    <li class="flex items-center"><span class="text-blue-500 mr-2">▪</span>チームリード</li>
                  </ul>
                <% end %>
              </div>
            </div>
            
            <!-- Experience -->
            <div>
              <h3 class="text-2xl font-bold text-gray-900 mb-4 flex items-center">
                <span class="text-2xl mr-3">📈</span>
                Experience
              </h3>
              <div class="text-gray-600">
                <% if section.active_content&.experience_text.present? %>
                  <%= simple_format(section.active_content.experience_text) %>
                <% else %>
                  <p class="mb-3"><strong>20+ years</strong> in IT industry</p>
                  <p>Large-scale system development</p>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>