<div class="py-20 bg-white">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto">
      <!-- ヘッダー -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          <%= content['title'] || 'Blog' %>
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          <%= content['description'] || '技術情報やプロジェクトの進捗を発信しています。最新の技術トレンドや開発ノウハウをお届けします。' %>
        </p>
      </div>
      
      <!-- 最新記事 -->
      <% if @recent_articles.present? %>
        <div class="max-w-4xl mx-auto space-y-8 mb-12">
          <% @recent_articles.each do |article| %>
            <article class="bg-white rounded-lg border border-gray-200 hover:shadow-lg transition-all duration-300 overflow-hidden">
              <div class="p-8">
                <!-- ヘッダー情報 -->
                <div class="flex items-center justify-between mb-4">
                  <div class="flex items-center space-x-4">
                    <!-- 公開日 -->
                    <time datetime="<%= article.published_at&.iso8601 %>" class="text-sm text-gray-500">
                      <%= article.published_at&.strftime('%Y年%m月%d日') %>
                    </time>
                    
                    <!-- カテゴリ -->
                    <% if article.categories.any? %>
                      <div class="flex flex-wrap gap-2">
                        <% article.categories.each do |category| %>
                          <span class="text-xs font-medium px-2.5 py-0.5 rounded text-white"
                                style="background-color: <%= category.color || '#3B82F6' %>;">
                            <%= category.name %>
                          </span>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                  
                  <!-- 読了時間（旧: ハードコードの「5分で読める」。S1-7 P3-3で実測値に） -->
                  <span class="text-sm text-gray-400">約<%= article.reading_time_minutes %>分で読める</span>
                </div>
                
                <!-- タイトル -->
                <h3 class="text-2xl font-bold text-gray-900 mb-4 leading-tight">
                  <a href="/blog/<%= article.slug %>" class="hover:text-blue-600 transition-colors">
                    <%= article.title %>
                  </a>
                </h3>
                
                <!-- 抜粋（軽量プレーンテキスト。Markdownレンダリングは行わない） -->
                <div class="text-gray-700 leading-relaxed mb-6 text-lg prose max-w-none">
                  <%= article.plain_text_excerpt %>
                </div>
                
                <!-- 技術スタック -->
                <%= render 'shared/tech_stack', article: article, tag_class: 'bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded', margin_class: 'mb-4' %>
                
                <!-- フッター情報 -->
                <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                  <!-- タグ -->
                  <div class="flex items-center">
                    <%# limit/countはプリロード済みでも追加クエリを発行するため first/size を使う（N+1回避） %>
                    <% if article.tags.any? %>
                      <div class="flex flex-wrap gap-2">
                        <% article.tags.first(4).each do |tag| %>
                          <span class="bg-gray-100 text-gray-600 text-xs px-2 py-1 rounded-md">
                            #<%= tag.name %>
                          </span>
                        <% end %>
                        <% if article.tags.size > 4 %>
                          <span class="text-gray-400 text-xs">+<%= article.tags.size - 4 %></span>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                  
                  <!-- 続きを読む -->
                  <a href="/blog/<%= article.slug %>" 
                     class="inline-flex items-center text-blue-600 hover:text-blue-700 font-medium text-sm group">
                    続きを読む
                    <svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <!-- 記事がない場合の表示（偽の記事カードは出さない） -->
        <div class="max-w-4xl mx-auto mb-12">
          <div class="bg-white rounded-lg border border-gray-200 p-12 text-center">
            <p class="text-gray-500 text-lg">記事はまだありません</p>
            <p class="text-gray-400 text-sm mt-2">公開された記事がここに表示されます</p>
          </div>
        </div>
      <% end %>
      
      <!-- ブログの特徴 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">技術記事</h3>
          <p class="text-gray-600 text-sm">最新の技術トレンドや開発ノウハウを分かりやすく解説</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">プロジェクト事例</h3>
          <p class="text-gray-600 text-sm">実際のプロジェクトから得た知見や課題解決のアプローチ</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">学習記録</h3>
          <p class="text-gray-600 text-sm">継続的な学習の記録と新しい技術への取り組み</p>
        </div>
      </div>
      
      <!-- CTA -->
      <div class="text-center">
        <p class="text-lg text-gray-600 mb-6">
          すべての記事を見る
        </p>
        <a href="/blog" class="bg-blue-600 text-white font-semibold py-4 px-8 rounded-lg hover:bg-blue-700 transition-colors">
          ブログページへ
        </a>
      </div>
    </div>
  </div>
</div>