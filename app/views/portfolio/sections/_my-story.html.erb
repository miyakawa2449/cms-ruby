<div class="py-20 relative overflow-hidden <% unless section.active_content&.background_image&.attached? %>bg-gradient-to-br from-blue-50 to-indigo-100<% end %>">
  <% if section.active_content&.background_image&.attached? %>
    <!-- 背景画像 -->
    <div class="absolute inset-0">
      <%= lazy_image_tag section.active_content.background_image,
          class: "w-full h-full object-cover",
          alt: "My Story background" %>
    </div>
    <div class="absolute inset-0 bg-black opacity-40"></div>
  <% end %>
  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-4xl mx-auto">
      <!-- ヘッダー -->
      <div class="text-center mb-16">
        <% if section.active_content&.badge_text.present? %>
          <div class="inline-block bg-blue-100 text-blue-800 px-4 py-2 rounded-full text-sm font-semibold mb-4">
            <%= section.active_content.badge_text %>
          </div>
        <% end %>
        
        <h2 class="text-4xl md:text-5xl font-bold <% if section.active_content&.background_image&.attached? %>text-white<% else %>text-gray-900<% end %> mb-6">
          <%= section.active_content&.main_title.presence || 'My Story' %>
        </h2>
        
        <p class="text-xl <% if section.active_content&.background_image&.attached? %>text-gray-200<% else %>text-gray-600<% end %>">
          <%= section.active_content&.sub_title.presence || 'なぜ要件定義から実装まで一人でできるのか' %>
        </p>
      </div>
      
      <!-- ストーリータイムライン（グリッドレイアウト） -->
      <div class="relative">
        <!-- タイムライン線（PC表示時のみ） -->
        <div class="hidden md:block absolute top-10 left-0 right-0 h-1 bg-gradient-to-r from-green-400 via-blue-400 to-purple-400"></div>
        
        <div class="grid md:grid-cols-3 gap-8">
          <!-- Phase 1 -->
          <div class="text-center scroll-reveal">
            <div class="w-20 h-20 bg-green-500 rounded-full mx-auto mb-6 flex items-center justify-center text-white font-bold text-xl shadow-lg relative z-10">
              <%= section.active_content&.phase1_year.presence || '1' %>
            </div>
            <div class="bg-white rounded-xl p-6 shadow-lg border-t-4 border-green-500">
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                第1フェーズ: <%= section.active_content&.phase1_title.presence || 'パソコンスクール講師時代' %>
              </h3>
              <p class="text-green-600 font-medium text-sm mb-3">
                <%= section.active_content&.phase1_period.presence || '1994-2005年（11年間）' %>
              </p>
              <p class="text-gray-600 text-sm leading-relaxed">
                <%= section.active_content&.phase1_description.presence || '人材育成・プロジェクト管理基礎力の形成。20名規模クラス運営による統率力・課題解決力習得。' %>
              </p>
            </div>
          </div>
          
          <!-- Phase 2 -->
          <div class="text-center scroll-reveal">
            <div class="w-20 h-20 bg-blue-500 rounded-full mx-auto mb-6 flex items-center justify-center text-white font-bold text-xl shadow-lg relative z-10">
              <%= section.active_content&.phase2_year.presence || '2' %>
            </div>
            <div class="bg-white rounded-xl p-6 shadow-lg border-t-4 border-blue-500">
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                第2フェーズ: <%= section.active_content&.phase2_title.presence || 'SE/PM・ビジネス分析者時代' %>
              </h3>
              <p class="text-blue-600 font-medium text-sm mb-3">
                <%= section.active_content&.phase2_period.presence || '2005-2021年（16年間）' %>
              </p>
              <p class="text-gray-600 text-sm leading-relaxed">
                <%= section.active_content&.phase2_description.presence || '上流工程専門家として大規模プロジェクトリード。ビジネス要件分析・設計文書化・チーム管理。' %>
              </p>
            </div>
          </div>
          
          <!-- Phase 3 -->
          <div class="text-center scroll-reveal">
            <div class="w-20 h-20 bg-purple-500 rounded-full mx-auto mb-6 flex items-center justify-center text-white font-bold text-xl shadow-lg relative z-10">
              <%= section.active_content&.phase3_year.presence || '3' %>
            </div>
            <div class="bg-white rounded-xl p-6 shadow-lg border-t-4 border-purple-500">
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                第3フェーズ: <%= section.active_content&.phase3_title.presence || 'AI活用エンジニア時代' %>
              </h3>
              <p class="text-purple-600 font-medium text-sm mb-3">
                <%= section.active_content&.phase3_period.presence || '2022年-現在' %>
              </p>
              <p class="text-gray-600 text-sm leading-relaxed">
                <%= section.active_content&.phase3_description.presence || 'ChatGPT登場を機に50代でプログラミング本格開始。SE/PM経験 × AI技術 × プログラミングスキルの統合。' %>
              </p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- 詳細ストーリー -->
      <div class="mt-16 bg-white rounded-xl p-8 shadow-lg">
        <h3 class="text-2xl font-bold text-gray-900 mb-6">30年間の3フェーズキャリアの真価</h3>
        <div class="prose prose-lg max-w-none text-gray-600 space-y-4">
          <p>
            多くのエンジニアは技術的なスキルに特化していますが、私は30年間のキャリアを通じて、
            <strong>人材育成力</strong>、<strong>ビジネス分析力</strong>、<strong>最新技術力</strong>の3つの核となる能力を段階的に習得してきました。
          </p>
          <p>
            第1フェーズで培った<strong>教育・指導力</strong>により、複雑な技術的課題を分かりやすく説明し、
            ステークホルダーとの円滑なコミュニケーションを可能にしています。
          </p>
          <p>
            第2フェーズで培った<strong>上流工程の専門知識</strong>により、単なるコーディングではなく、
            ビジネス価値を最大化する技術ソリューションを設計できます。
          </p>
          <p>
            第3フェーズで習得した<strong>AI活用とプログラミング力</strong>により、
            設計から実装まで一人で完結できる希少な存在になりました。
          </p>
          <p class="font-semibold text-gray-900">
            この3つのフェーズが統合されることで、要件定義から実装まで一貫したクオリティで提供できる、
            唯一無二のエンジニアとしての価値を実現しています。
          </p>
        </div>
      </div>
      
      <!-- CTA -->
      <div class="text-center mt-12 space-x-4">
        <% if section.active_content&.cta_button_text.present? %>
          <a href="/my-story" class="bg-blue-600 text-white font-semibold py-4 px-8 rounded-lg hover:bg-blue-700 transition-colors inline-block">
            <%= section.active_content.cta_button_text %>
          </a>
        <% else %>
          <a href="/my-story" class="bg-blue-600 text-white font-semibold py-4 px-8 rounded-lg hover:bg-blue-700 transition-colors inline-block">
            🚀 詳細なストーリーを見る
          </a>
        <% end %>
        
        <a href="#contact" class="bg-gray-600 text-white font-semibold py-4 px-8 rounded-lg hover:bg-gray-700 transition-colors inline-block">
          プロジェクト相談をする
        </a>
      </div>
      
      <% if section.active_content&.cta_description.present? %>
        <div class="text-center mt-4">
          <p class="text-gray-600">
            <%= section.active_content.cta_description %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>