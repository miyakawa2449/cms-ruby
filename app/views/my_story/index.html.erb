<% content_for :title, @page_title %>
<% content_for :meta_tags, my_story_meta_tags(@page_title, @page_description) %>

<div class="bg-gray-50">
  <%= render 'shared/header', variant: 'story' %>

  <!-- Breadcrumb Navigation -->
  <div class="bg-white border-b border-gray-200 pt-20">
    <div class="container mx-auto px-6 py-4">
      <nav class="text-sm text-gray-500">
        <%= link_to "ホーム", root_path, class: "hover:text-blue-600" %> > 
        <span class="text-gray-900">My Story</span>
      </nav>
    </div>
  </div>

  <!-- Hero Section -->
  <% if @hero_section %>
    <section class="hero-bg text-white py-20" 
             style="<%= @hero_section.has_background_image? ? 
                      "background-image: linear-gradient(135deg, rgba(102, 126, 234, 0.8), rgba(118, 75, 162, 0.8)), url('#{url_for(@hero_section.background_image)}'); background-size: cover; background-position: center;" : 
                      'background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);' %>">
      <div class="container mx-auto px-6 text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">
          <%= raw @hero_section.title %>
        </h1>
        <% if @hero_section.subtitle.present? %>
          <p class="text-xl md:text-2xl mb-8 text-blue-100">
            <%= @hero_section.subtitle %>
          </p>
        <% end %>
        <% if @hero_section.content.present? %>
          <div class="max-w-2xl mx-auto text-blue-100">
            <%= simple_format(@hero_section.content) %>
          </div>
        <% end %>
      </div>
    </section>
  <% else %>
    <!-- Fallback Hero Section -->
    <section class="hero-bg text-white py-20" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
      <div class="container mx-auto px-6 text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">
          なぜ要件定義から実装まで<br>
          <span class="text-yellow-300">一人でできる</span>のか？
        </h1>
        <p class="text-xl md:text-2xl mb-8 text-blue-100">
          宮川 剛のキャリアストーリー
        </p>
        <div class="max-w-2xl mx-auto text-blue-100">
          <p>パソコンスクール講師からSE/PM、そしてAIエンジニアへ。3つの転機がどのように組み合わさって、現在の独自のスキルセットを形成したかをご紹介します。</p>
        </div>
      </div>
    </section>
  <% end %>

  <!-- Timeline Overview -->
  <% if @timeline_section %>
    <section class="py-20 bg-white">
      <div class="container mx-auto px-6">
        <h2 class="text-3xl font-bold text-center mb-16"><%= @timeline_section.title %></h2>
        <% if @timeline_section.subtitle.present? %>
          <p class="text-center text-gray-600 mb-8"><%= @timeline_section.subtitle %></p>
        <% end %>
        <div class="max-w-6xl mx-auto">
          <div class="timeline-line mb-12" style="background: linear-gradient(90deg, #10b981, #3b82f6, #8b5cf6); height: 4px;"></div>
          <div class="grid md:grid-cols-3 gap-8 -mt-8">
            <% @timeline_section.timeline_years.each do |year_data| %>
              <div class="text-center scroll-reveal">
                <div class="w-20 h-20 bg-<%= year_data['color'] %>-500 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-bold text-lg">
                  <%= year_data['year'] %>
                </div>
                <h3 class="text-xl font-bold mb-2"><%= year_data['title'] %></h3>
                <p class="text-gray-600 mb-4"><%= year_data['period'] %></p>
                <div class="text-sm text-<%= year_data['color'] %>-600 font-semibold"><%= year_data['skills'] %></div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  <% else %>
    <!-- Fallback Timeline -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-6">
        <h2 class="text-3xl font-bold text-center mb-16">キャリアタイムライン</h2>
        <div class="max-w-6xl mx-auto">
          <div class="timeline-line mb-12" style="background: linear-gradient(90deg, #3b82f6, #10b981, #8b5cf6); height: 4px;"></div>
          <div class="grid md:grid-cols-3 gap-8 -mt-8">
            <div class="text-center scroll-reveal">
              <div class="w-20 h-20 bg-green-500 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-bold text-lg">
                1994
              </div>
              <h3 class="text-xl font-bold mb-2">パソコンスクール講師</h3>
              <p class="text-gray-600 mb-4">20人近い受講生を取りまとめ、PM基礎力を形成</p>
              <div class="text-sm text-green-600 font-semibold">人材育成・プロジェクト管理基礎</div>
              <div class="text-xs text-gray-500 mt-2">1994-2005</div>
            </div>
            <div class="text-center scroll-reveal">
              <div class="w-20 h-20 bg-blue-500 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-bold text-lg">
                2005
              </div>
              <h3 class="text-xl font-bold mb-2">SE/PM・ビジネス分析者</h3>
              <p class="text-gray-600 mb-4">16年間、上流工程の専門家として大規模プロジェクトをリード</p>
              <div class="text-sm text-blue-600 font-semibold">ビジネス理解力・プロジェクト推進力</div>
              <div class="text-xs text-gray-500 mt-2">2005-2021</div>
            </div>
            <div class="text-center scroll-reveal">
              <div class="w-20 h-20 bg-purple-500 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-bold text-lg">
                2022
              </div>
              <h3 class="text-xl font-bold mb-2">AI活用エンジニア</h3>
              <p class="text-gray-600 mb-4">AI登場を機にプログラミングを習得、全スキルを統合</p>
              <div class="text-sm text-purple-600 font-semibold">AI × プログラミング × PM経験</div>
              <div class="text-xs text-gray-500 mt-2">2022-現在</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  <% end %>

  <!-- Dynamic Chapter Sections -->
  <% @chapter_sections.each do |section| %>
    <% if section %>
      <%= render 'chapter_section', section: section %>
    <% end %>
  <% end %>

  <!-- Skills Integration Section -->
  <% if @skills_integration_section %>
    <section class="py-20" style="background: linear-gradient(135deg, #1e3a8a 0%, #312e81 100%);">
      <div class="container mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-white mb-6"><%= @skills_integration_section.title %></h2>
        </div>
        
        <div class="max-w-6xl mx-auto">
          <!-- Skills Cards Grid -->
          <div class="grid md:grid-cols-4 gap-6 mb-12">
            <% @skills_integration_section.additional_data['skill_cards']&.each do |card| %>
              <div class="bg-gray-800 rounded-lg p-6 text-center scroll-reveal">
                <div class="text-4xl mb-4"><%= card['icon'] %></div>
                <h3 class="text-lg font-bold text-white mb-4"><%= card['title'] %></h3>
                <ul class="space-y-2 text-sm text-gray-300">
                  <% card['skills'].each do |skill| %>
                    <li>・<%= skill %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
          
          <!-- Summary -->
          <% if @skills_integration_section.additional_data['summary'].present? %>
            <div class="bg-blue-600 rounded-lg p-8 text-center scroll-reveal">
              <p class="text-xl text-white leading-relaxed">
                <%= @skills_integration_section.additional_data['summary'] %>
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <!-- Projects Section -->
  <% if @projects_section %>
    <section class="py-20 bg-gray-50">
      <div class="container mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-6"><%= @projects_section.title %></h2>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
          <% @recent_works.limit(3).each do |work| %>
            <div class="bg-white rounded-xl overflow-hidden shadow-lg scroll-reveal">
              <% if work.thumbnail_image.attached? %>
                <div class="h-48 bg-gradient-to-br from-gray-100 to-gray-200">
                  <%= image_tag work.thumbnail_image, 
                      alt: work.title, 
                      class: "w-full h-full object-cover" %>
                </div>
              <% else %>
                <div class="h-48 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                  <span class="text-gray-500">プロジェクト画像</span>
                </div>
              <% end %>
              
              <div class="p-6">
                <h3 class="text-xl font-bold mb-3"><%= work.title %></h3>
                <div class="text-gray-600 leading-relaxed mb-4">
                  <%= truncate(strip_tags(safe_markdown(work.excerpt.presence || work.content)), length: 120) %>
                </div>
                
                <div class="flex justify-between items-center text-sm text-gray-500">
                  <span>期間: 6ヶ月</span>
                  <span>規模: 中規模</span>
                </div>
                
                <% if work.tech_stack.present? %>
                  <div class="mt-4">
                    <div class="flex flex-wrap gap-2">
                      <% work.tech_stack_list.each do |tech| %>
                        <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded">
                          <%= tech %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        
        <div class="text-center mt-8">
          <%= link_to "/blog?category=works", 
                      class: "bg-blue-600 text-white font-semibold py-3 px-8 rounded-lg hover:bg-blue-700 transition-colors" do %>
            詳細な事例を見る
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <!-- CTA Section -->
  <% if @cta_section %>
    <section class="py-20" style="background: linear-gradient(90deg, #2563eb 0%, #9333ea 100%);">
      <div class="container mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-white mb-6"><%= @cta_section.title %></h2>
        <% if @cta_section.subtitle.present? %>
          <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
            <%= @cta_section.subtitle %>
          </p>
        <% end %>
        <div class="space-x-4">
          <% @cta_section.additional_data['buttons']&.each do |button| %>
            <%= link_to button['url'], 
                        class: "inline-block #{
                          button['style'] == 'primary' ? 
                            'bg-white text-blue-600 hover:bg-gray-100' : 
                            'border-2 border-white text-white hover:bg-white hover:text-blue-600'
                        } px-8 py-3 rounded-lg font-semibold transition-colors" do %>
              <%= button['text'] %>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>
  <% else %>
    <!-- Fallback CTA Section -->
    <section class="py-20" style="background: linear-gradient(90deg, #eff6ff 0%, #faf5ff 100%);">
      <div class="container mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold mb-6">この希少なスキルセットで<br>あなたのプロジェクトをサポートします</h2>
        <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
          要件定義から実装まで一貫して対応できる経験豊富なエンジニアをお探しですか？
        </p>
        <div class="space-x-4">
          <%= link_to root_path, class: "inline-block bg-blue-900 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-800 transition-colors" do %>
            ポートフォリオを見る
          <% end %>
          <a href="#contact" class="inline-block border-2 border-blue-900 text-blue-900 px-8 py-3 rounded-lg font-semibold hover:bg-blue-900 hover:text-white transition-colors">
            お問い合わせ
          </a>
        </div>
      </div>
    </section>
  <% end %>

  <!-- Navigation -->
  <div class="bg-white py-6 border-t border-gray-200">
    <div class="container mx-auto px-6 text-center">
      <%= link_to root_path, class: "text-blue-600 hover:text-blue-700 font-medium" do %>
        ← ポートフォリオに戻る
      <% end %>
    </div>
  </div>

  <%= render 'shared/footer', variant: 'story' %>
</div>

<style>
  .scroll-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s ease;
  }
  .scroll-reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // スクロールアニメーション
  function revealOnScroll() {
    const reveals = document.querySelectorAll('.scroll-reveal');
    
    reveals.forEach(element => {
      const windowHeight = window.innerHeight;
      const elementTop = element.getBoundingClientRect().top;
      const elementVisible = 150;
      
      if (elementTop < windowHeight - elementVisible) {
        element.classList.add('revealed');
      }
    });
  }

  window.addEventListener('scroll', revealOnScroll);
  
  // 初期表示時もチェック
  document.addEventListener('DOMContentLoaded', revealOnScroll);
</script>