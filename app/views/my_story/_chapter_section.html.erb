<% 
  # Determine chapter styling based on section type
  case section.section_type
  when 'chapter_1'
    chapter_color = 'green'
    chapter_number = '第1章'
    section_class = ''
  when 'chapter_2'
    chapter_color = 'blue'
    chapter_number = '第2章'
    section_class = 'bg-white'
  when 'chapter_3'
    chapter_color = 'purple'
    chapter_number = '第3章'
    section_class = ''
  else
    chapter_color = 'gray'
    chapter_number = section.section_type_label
    section_class = ''
  end
%>

<section class="py-20 <%= section_class %>">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16 scroll-reveal">
        <div class="inline-block bg-<%= chapter_color %>-100 text-<%= chapter_color %>-800 px-4 py-2 rounded-full text-sm font-semibold mb-4">
          <%= chapter_number %>
        </div>
        <h2 class="text-3xl font-bold mb-4"><%= section.title %></h2>
        <% if section.additional_data['period'].present? %>
          <p class="text-gray-600 mb-2"><%= section.additional_data['period'] %> | <%= section.subtitle %></p>
        <% elsif section.subtitle.present? %>
          <p class="text-gray-600"><%= section.subtitle %></p>
        <% end %>
      </div>
      
      <div class="grid md:grid-cols-2 gap-12 items-center mb-12">
        <!-- Chapter Image -->
        <div class="<%= section.section_type == 'chapter_3' ? 'order-2 md:order-1' : '' %> scroll-reveal">
          <% if section.has_chapter_image? %>
            <%= image_tag section.chapter_image, 
                class: "w-full h-80 object-cover rounded-lg shadow-lg" %>
          <% else %>
            <div class="bg-gray-200 rounded-lg h-80 flex items-center justify-center">
              <span class="text-gray-500">
                <%= case section.section_type
                    when 'chapter_1' then 'パソコンスクール・教室のイメージ'
                    when 'chapter_2' then 'プロジェクト管理・会議のイメージ'
                    when 'chapter_3' then 'AI開発・コーディングのイメージ'
                    else 'Chapter Image'
                    end %>
              </span>
            </div>
          <% end %>
        </div>
        
        <!-- Chapter Content -->
        <div class="<%= section.section_type == 'chapter_3' ? 'order-1 md:order-2' : '' %> scroll-reveal">
          <!-- Main Title -->
          <% if section.additional_data['main_title'].present? %>
            <h3 class="text-2xl font-bold mb-4 text-gray-900"><%= section.additional_data['main_title'] %></h3>
          <% end %>
          
          <!-- Main Content -->
          <% if section.content.present? %>
            <div class="prose max-w-none text-gray-700 mb-6">
              <%= simple_format(section.content) %>
            </div>
          <% end %>
          
          <!-- Skills List -->
          <% if section.chapter_skills.any? %>
            <div class="mt-8">
              <h4 class="text-xl font-bold mb-4 text-gray-900">身につけたスキル</h4>
              <ul class="space-y-2 text-gray-700">
                <% section.chapter_skills.each do |skill| %>
                  <li class="flex items-start space-x-2">
                    <span class="w-2 h-2 bg-<%= chapter_color %>-500 rounded-full mt-2 flex-shrink-0"></span>
                    <span><%= skill %></span>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
          
          <!-- Achievements -->
          <% if section.additional_data['achievements_title'].present? && section.additional_data['achievements'].present? %>
            <div class="mt-8">
              <h4 class="text-xl font-bold mb-4 text-gray-900"><%= section.additional_data['achievements_title'] %></h4>
              <p class="text-gray-700"><%= section.additional_data['achievements'] %></p>
            </div>
          <% end %>
          
          <!-- Strength (for Chapter 3) -->
          <% if section.additional_data['strength_title'].present? && section.additional_data['strength'].present? %>
            <div class="mt-8">
              <h4 class="text-xl font-bold mb-4 text-gray-900"><%= section.additional_data['strength_title'] %></h4>
              <p class="text-gray-700"><%= section.additional_data['strength'] %></p>
            </div>
          <% end %>
        </div>
      </div>
      
      <!-- Chapter Quote -->
      <% if section.chapter_quote.present? %>
        <div class="chapter-quote bg-<%= chapter_color %>-50 p-6 rounded-lg scroll-reveal" 
             style="border-left: 4px solid <%= 
               case chapter_color
               when 'green' then '#10b981'
               when 'blue' then '#3b82f6' 
               when 'purple' then '#8b5cf6'
               else '#6b7280'
               end
             %>; font-style: italic;">
          <p class="text-gray-700 text-lg">
            「<%= section.chapter_quote %>」
          </p>
        </div>
      <% end %>
    </div>
  </div>
</section>