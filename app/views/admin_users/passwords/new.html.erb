<div class="animate-fadeIn w-full max-w-md mx-auto">
  <div class="login-card rounded-2xl p-8 shadow-2xl border border-white/20">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-800 mb-2">パスワードを忘れた場合</h1>
      <p class="text-gray-600 text-sm">
        登録されているメールアドレスにパスワードリセット手順をお送りします
      </p>
    </div>
    
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>
      <%= render "admin_users/shared/error_messages", resource: resource %>
      
      <div class="space-y-4">
        <div>
          <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.email_field :email, 
                            autofocus: true,
                            autocomplete: "email",
                            placeholder: "メールアドレスを入力",
                            class: "input-focus w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all duration-200" %>
        </div>
      </div>
      
      <div style="display: block; margin-top: 1.5rem;">
        <%= f.submit "パスワードリセット手順を送信",
                     class: "login-button w-full text-white font-semibold py-3 px-4 rounded-lg cursor-pointer",
                     style: "display: block !important; width: 100% !important; opacity: 1 !important; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%) !important;" %>
      </div>
    <% end %>
    
    <div class="text-center mt-6 pt-6 border-t border-gray-200">
      <%= link_to "← ログイン画面に戻る", new_admin_user_session_path,
                  class: "text-blue-600 hover:text-blue-800 text-sm font-medium transition-colors" %>
    </div>
  </div>
</div>
