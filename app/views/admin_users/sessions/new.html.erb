<!-- ログインカード -->
<div class="login-card w-full max-w-md rounded-2xl shadow-2xl p-8 animate-fadeIn">
  <!-- ロゴ -->
  <div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-600 rounded-2xl mb-4">
      <span class="text-white font-bold text-2xl">M</span>
    </div>
    <h1 class="text-2xl font-bold text-gray-800">管理画面ログイン</h1>
    <p class="text-sm text-gray-600 mt-1">Portfolio CMS</p>
  </div>

  <!-- エラーメッセージ -->
  <% if alert.present? %>
    <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
      <div class="flex items-center">
        <svg class="w-5 h-5 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-sm text-red-600"><%= alert %></p>
      </div>
    </div>
  <% end %>

  <!-- 成功メッセージ -->
  <% if notice.present? %>
    <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg">
      <div class="flex items-center">
        <svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-sm text-green-600"><%= notice %></p>
      </div>
    </div>
  <% end %>

  <!-- ログインフォーム -->
  <%= form_with(model: resource, as: resource_name, url: session_path(resource_name), local: true) do |form| %>
    <div class="space-y-4">
      <!-- メールアドレス -->
      <div>
        <%= form.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.email_field :email, 
            autofocus: true,
            autocomplete: "email",
            placeholder: "admin@example.com",
            class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 input-focus transition-colors" %>
      </div>

      <!-- パスワード -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <%= form.label :password, "パスワード", class: "block text-sm font-medium text-gray-700" %>
          <%= link_to "パスワードをお忘れですか？", new_password_path(resource_name), 
                      class: "text-sm text-blue-600 hover:text-blue-700 hover:underline" %>
        </div>
        <%= form.password_field :password,
            autocomplete: "current-password",
            placeholder: "••••••••",
            class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 input-focus transition-colors" %>
      </div>

      <!-- ログイン状態を保持 -->
      <% if devise_mapping.rememberable? %>
        <div class="flex items-center">
          <%= form.check_box :remember_me, 
                            class: "w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" %>
          <%= form.label :remember_me, "ログイン状態を保持する", 
                        class: "ml-2 text-sm text-gray-700" %>
        </div>
      <% end %>
    </div>

    <!-- ログインボタン -->
    <%= form.submit "ログイン", 
                    class: "login-button w-full mt-6 py-3 text-white font-semibold rounded-lg cursor-pointer border-0" %>
  <% end %>

  <!-- セキュリティ情報 -->
  <div class="mt-8 pt-6 border-t border-gray-200">
    <div class="flex items-center justify-center text-xs text-gray-500 space-x-4">
      <div class="flex items-center">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
        SSL暗号化通信
      </div>
      <div class="flex items-center">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
        セキュリティ保護
      </div>
    </div>
  </div>
</div>
