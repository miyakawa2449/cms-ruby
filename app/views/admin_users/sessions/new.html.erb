<div class="animate-fadeIn w-full max-w-md mx-auto">
  <div class="login-card rounded-2xl p-8 shadow-2xl border border-white/20">
    <!-- ロゴエリア -->
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold login-text-gradient mb-2">Portfolio CMS</h1>
      <p class="text-gray-600 text-sm">管理画面にログイン</p>
    </div>
    
    <!-- ログインフォーム -->
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
      <!-- メールアドレス -->
      <div class="space-y-2">
        <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, 
                          autofocus: true, 
                          autocomplete: "email",
                          placeholder: "admin@example.com",
                          class: "input-focus w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all duration-200" %>
      </div>
      
      <!-- パスワード -->
      <div class="space-y-2">
        <%= f.label :password, "パスワード", class: "block text-sm font-medium text-gray-700" %>
        <%= f.password_field :password, 
                            autocomplete: "current-password",
                            placeholder: "パスワードを入力",
                            class: "input-focus w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all duration-200" %>
      </div>

      <!-- 二要素認証コード -->
      <div class="space-y-2">
        <%= f.label :otp_attempt, "認証コード（2FA有効時）", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :otp_attempt,
                         autocomplete: "one-time-code",
                         inputmode: "numeric",
                         placeholder: "000000 / バックアップコード",
                         class: "input-focus w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all duration-200" %>
      </div>
      
      <!-- ログイン状態を保持 -->
      <% if devise_mapping.rememberable? %>
        <div class="flex items-center">
          <%= f.check_box :remember_me, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded cursor-pointer" %>
          <%= f.label :remember_me, "ログイン状態を保持する", class: "ml-2 block text-sm text-gray-700 cursor-pointer select-none" %>
        </div>
      <% end %>
      
      <!-- エラーメッセージ -->
      <% if flash[:alert] %>
        <div class="animate-shake bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">
          <%= flash[:alert] %>
        </div>
      <% end %>
      
      <!-- ログインボタン -->
      <%= f.submit "ログイン", 
                   class: "login-button w-full text-white font-semibold py-3 px-4 rounded-lg cursor-pointer",
                   data: { disable_with: "ログイン中..." } %>
    <% end %>

    <!-- パスキーログイン（S1-6） -->
    <div class="mt-4"
         data-controller="passkey-login"
         data-passkey-login-options-url-value="<%= passkey_session_options_path %>"
         data-passkey-login-login-url-value="<%= passkey_session_path %>">
      <div class="relative my-4">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-gray-300"></div></div>
        <div class="relative flex justify-center text-sm"><span class="px-2 bg-white text-gray-500">または</span></div>
      </div>
      <button type="button" data-action="passkey-login#login"
              class="w-full flex justify-center items-center gap-2 border border-gray-300 rounded-lg py-3 px-4 text-gray-700 font-semibold hover:bg-gray-50">
        🔑 パスキーでログイン
      </button>
      <div data-passkey-login-target="error" class="hidden mt-2 text-sm text-red-600 text-center"></div>
    </div>

    <!-- パスワードリセットリンク -->
    <div class="text-center mt-6 space-y-2">
      <%= link_to "パスワードをお忘れですか？", new_admin_user_password_path,
                  class: "text-sm text-blue-600 hover:text-blue-800 transition-colors" %>
    </div>
    
    <!-- セキュリティ注意書き -->
    <div class="mt-8 pt-6 border-t border-gray-200">
      <p class="text-xs text-center text-gray-500">
        このページは管理者専用です。<br>
        不正なアクセスは記録されます。
      </p>
    </div>
  </div>
</div>
