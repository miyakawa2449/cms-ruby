<% content_for :title, "Blog" %>
<% content_for :head do %>
  <%= tag.link rel: "alternate", type: "application/rss+xml", title: "RSS Feed", href: feed_rss_url(format: :rss) %>
  <%= tag.link rel: "alternate", type: "application/atom+xml", title: "Atom Feed", href: feed_atom_url(format: :atom) %>
<% end %>

<div class="min-h-screen bg-gray-50">
  <%= render 'shared/header', variant: 'blog' %>

  <!-- Blog Header -->
  <header class="bg-white shadow-sm border-b border-gray-200 pt-20">
    <div class="container mx-auto px-6 py-8">
      <!-- パンくずナビゲーション -->
      <nav class="text-sm text-gray-500 mb-6" aria-label="パンくずナビゲーション">
        <ol class="flex items-center space-x-2 flex-wrap">
          <li>
            <%= link_to "ホーム", root_path, class: "hover:text-blue-600 transition-colors" %>
          </li>
          <li class="text-gray-400">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
            </svg>
          </li>
          <% if @selected_category && params[:q].blank? && params[:tag_id].blank? %>
            <li>
              <%= link_to "Blog", blog_path, class: "hover:text-blue-600 transition-colors" %>
            </li>
            <li class="text-gray-400">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
              </svg>
            </li>
            <li>
              <span class="text-gray-900 font-medium"><%= @selected_category.name %></span>
            </li>
          <% else %>
            <li>
              <span class="text-gray-900 font-medium">Blog</span>
            </li>
          <% end %>
        </ol>
      </nav>

      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Miyakawa Codes Blog
        </h1>
        <p class="text-xl text-gray-600">
          技術情報とプロジェクトの進捗をお届け
        </p>
      </div>
    </div>
  </header>

  <div class="container mx-auto px-6 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- メインコンテンツ -->
      <main class="lg:col-span-3">
        <% if params[:q].present? %>
          <!-- 検索エリア（検索時のみ表示） -->
          <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
            <h2 class="text-lg font-semibold mb-4 flex items-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              記事を検索
            </h2>

            <%= form_with url: blog_path, method: :get, local: true do |f| %>
              <div class="mb-4">
                <div class="flex gap-2">
                  <%= f.text_field :q,
                      value: params[:q],
                      placeholder: "キーワードを入力...",
                      class: "flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
                  <%= f.submit "検索", class: "px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 cursor-pointer transition-colors" %>
                </div>
              </div>

              <div class="flex flex-wrap gap-4 items-center text-sm">
                <span class="text-gray-600 font-medium">絞り込み:</span>

                <%= f.select :category_id,
                    options_for_select([['すべてのカテゴリ', '']] + @categories.map { |c| [c.name, c.id] }, params[:category_id]),
                    {},
                    class: "pl-3 pr-8 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 cursor-pointer appearance-none bg-white bg-[url('data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2012%2012%22%3E%3Cpath%20fill%3D%22%236B7280%22%20d%3D%22M2%204l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-no-repeat bg-[right_0.5rem_center]",
                    onchange: "this.form.requestSubmit()" %>

                <%= f.select :tag_id,
                    options_for_select([['すべてのタグ', '']] + @tags.map { |t| [t.name, t.id] }, params[:tag_id]),
                    {},
                    class: "pl-3 pr-8 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 cursor-pointer appearance-none bg-white bg-[url('data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2012%2012%22%3E%3Cpath%20fill%3D%22%236B7280%22%20d%3D%22M2%204l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-no-repeat bg-[right_0.5rem_center]",
                    onchange: "this.form.requestSubmit()" %>
              </div>
            <% end %>

            <div class="mt-4 pt-4 border-t">
              <div class="flex items-center justify-between flex-wrap gap-2">
                <div class="text-gray-700">
                  「<span class="font-semibold text-blue-600"><%= params[:q] %></span>」の検索結果:
                  <span class="font-semibold"><%= @articles.total_count %></span>件

                  <div class="inline-flex gap-2 ml-2">
                    <% if @selected_category %>
                      <%= link_to blog_path(q: params[:q], tag_id: params[:tag_id]),
                          class: "inline-flex items-center px-2 py-1 bg-blue-100 text-blue-800 rounded text-xs hover:bg-blue-200 transition-colors" do %>
                        カテゴリ: <%= @selected_category.name %>
                        <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                      <% end %>
                    <% end %>

                    <% if @selected_tag %>
                      <%= link_to blog_path(q: params[:q], category_id: params[:category_id]),
                          class: "inline-flex items-center px-2 py-1 bg-green-100 text-green-800 rounded text-xs hover:bg-green-200 transition-colors" do %>
                        タグ: <%= @selected_tag.name %>
                        <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                      <% end %>
                    <% end %>
                  </div>
                </div>

                <%= link_to blog_path, class: "text-blue-600 hover:underline text-sm font-medium" do %>
                  ✕ すべてクリア
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <!-- 記事一覧 -->
        <% if @articles.any? %>
          <div class="space-y-8">
            <% @articles.each do |article| %>
              <article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <!-- サムネイル画像 -->
                <% if article.thumbnail_image.attached? %>
                  <%= link_to blog_article_path(article.slug), class: "block" do %>
                    <div class="bg-gray-200 overflow-hidden" style="aspect-ratio: 4 / 3;">
                      <%= lazy_image_tag article.thumbnail_image,
                          alt: article.title,
                          class: "w-full h-full object-cover hover:scale-105 transition-transform duration-300" %>
                    </div>
                  <% end %>
                <% else %>
                  <%= link_to blog_article_path(article.slug), class: "block" do %>
                    <div class="h-48 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                      <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                    </div>
                  <% end %>
                <% end %>

                <div class="p-6">
                  <!-- カテゴリ -->
                  <% if article.categories.any? %>
                    <div class="flex flex-wrap gap-2 mb-3">
                      <% article.categories.each do |category| %>
                        <%= link_to blog_path(category_id: category.id),
                                    class: "text-sm font-medium px-3 py-1 rounded-full transition-colors text-white hover:opacity-80",
                                    style: "background-color: #{category.color || '#3B82F6'};" do %>
                          <%= category.name %>
                        <% end %>
                      <% end %>
                    </div>
                  <% end %>

                  <!-- タイトル -->
                  <h2 class="text-2xl font-bold text-gray-900 mb-3 hover:text-blue-600 transition-colors">
                    <%= link_to blog_article_path(article.slug) do %>
                      <% if @query.present? %>
                        <%= highlight_keywords(article.title, @query) %>
                      <% else %>
                        <%= article.title %>
                      <% end %>
                    <% end %>
                  </h2>

                  <!-- 抜粋 -->
                  <% if article.excerpt.present? %>
                    <div class="text-gray-600 leading-relaxed mb-4">
                      <% if @query.present? %>
                        <%= highlight_keywords(strip_tags(safe_markdown(article.excerpt)), @query) %>
                      <% else %>
                        <%= strip_tags(safe_markdown(article.excerpt)) %>
                      <% end %>
                    </div>
                  <% else %>
                    <p class="text-gray-600 leading-relaxed mb-4">
                      <% if @query.present? %>
                        <%= truncate_with_highlight(strip_tags(safe_markdown(article.content)), @query, length: 200) %>
                      <% else %>
                        <%= truncate(strip_tags(safe_markdown(article.content)), length: 200) %>
                      <% end %>
                    </p>
                  <% end %>

                  <!-- 技術スタック -->
                  <%= render 'shared/tech_stack', article: article, tag_class: 'bg-green-100 text-green-800 text-sm font-medium px-3 py-1 rounded-full', margin_class: 'mb-4' %>

                  <!-- メタ情報 -->
                  <div class="flex items-center justify-between text-sm text-gray-500 mb-4">
                    <div class="flex items-center space-x-4">
                      <time datetime="<%= article.published_at&.iso8601 %>">
                        <%= article.published_at&.strftime('%Y年%m月%d日') %>
                      </time>
                      <span>読了時間: 約<%= (strip_tags(article.content).length / 500).ceil %>分</span>
                    </div>
                    <%= link_to "続きを読む →", blog_article_path(article.slug),
                                class: "text-blue-600 hover:text-blue-700 font-medium" %>
                  </div>

                  <!-- タグ -->
                  <% if article.tags.any? %>
                    <div class="flex flex-wrap gap-2">
                      <% article.tags.each do |tag| %>
                        <%= link_to blog_path(tag_id: tag.id),
                                    class: "bg-gray-200 text-gray-600 text-sm px-2 py-1 rounded hover:bg-gray-300 transition-colors" do %>
                          #<%= tag.name %>
                        <% end %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>

          <!-- ページネーション -->
          <% if @articles.respond_to?(:total_pages) && @articles.total_pages > 1 %>
            <div class="mt-8 flex justify-center">
              <nav class="inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                <%= paginate @articles %>
              </nav>
            </div>
          <% end %>

        <% else %>
          <!-- 記事なしの場合 -->
          <div class="text-center py-16 bg-white rounded-lg shadow-sm">
            <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <p class="text-lg font-medium text-gray-700 mb-2">記事が見つかりませんでした</p>
            <p class="text-sm text-gray-500 mb-4">検索条件を変更してお試しください</p>
            <%= link_to "すべての記事を見る", blog_path,
                class: "inline-block px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors" %>
          </div>
        <% end %>
      </main>

      <!-- サイドバー -->
      <aside class="lg:col-span-1">
        <%= render 'sidebar' %>
      </aside>
    </div>
  </div>

  <!-- Blog Footer -->
  <footer class="bg-gray-900 text-gray-300 py-8 mt-16">
    <div class="container mx-auto px-6 text-center">
      <p>&copy; 2025 Miyakawa Codes Blog. All rights reserved.</p>
    </div>
  </footer>
</div>
