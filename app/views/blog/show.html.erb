<% content_for :title, @article.title %>
<% content_for :meta_tags, article_meta_tags(@article) %>

<div class="min-h-screen bg-gray-50">
  <%= render 'shared/header', variant: 'blog' %>

  <!-- Article Header -->
  <header class="bg-white shadow-sm border-b border-gray-200 pt-20">
    <div class="container mx-auto px-6 py-6">
      <!-- パンくずナビゲーション -->
      <nav class="text-sm text-gray-500 mb-4" aria-label="パンくずナビゲーション">
        <ol class="flex items-center space-x-2 flex-wrap">
          <li>
            <%= link_to "ホーム", root_path, class: "hover:text-blue-600 transition-colors" %>
          </li>
          <li class="text-gray-400">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
            </svg>
          </li>
          <li>
            <%= link_to "Blog", blog_path, class: "hover:text-blue-600 transition-colors" %>
          </li>
          <% if @article.categories.any? %>
            <li class="text-gray-400">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
              </svg>
            </li>
            <li>
              <%= link_to @article.categories.first.name,
                          blog_path(category_id: @article.categories.first.id),
                          class: "hover:text-blue-600 transition-colors" %>
            </li>
          <% end %>
          <li class="text-gray-400">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
            </svg>
          </li>
          <li>
            <span class="text-gray-900 font-medium"><%= truncate(@article.title, length: 30) %></span>
          </li>
        </ol>
      </nav>
      
      <%# フルワイドヒーロー構成（2026-07-16 A案採用）:
          旧構成は4カラムグリッドの3列分+空のスペーサーdivで、広い画面で右上に
          大きな余白ができていた。ヘッダーは全幅を使い、サイドバーは本文から始める %>

      <!-- カテゴリ -->
      <% if @article.categories.any? %>
        <div class="flex flex-wrap gap-2 mb-4">
          <% @article.categories.each do |category| %>
            <%= link_to blog_path(category_id: category.id),
                        class: "text-sm font-medium px-3 py-1 rounded-full transition-colors text-white hover:opacity-80",
                        style: "background-color: #{category.color || '#3B82F6'};" do %>
              <%= category.name %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <!-- タイトル -->
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4 leading-tight max-w-4xl">
        <%= @article.title %>
      </h1>

      <!-- 抜粋 -->
      <% if @article.excerpt.present? %>
        <div class="text-xl text-gray-600 mb-8 leading-relaxed prose prose-xl max-w-3xl">
          <%= safe_markdown(@article.excerpt) %>
        </div>
      <% end %>

      <!-- ヒーロー画像（全幅・OGP比率1.91:1。既存の4:3画像はobject-coverで上下が自動トリミングされる） -->
      <% if @article.thumbnail_image.attached? %>
        <div class="mb-6">
          <div class="relative rounded-xl overflow-hidden shadow-lg" style="aspect-ratio: 1200 / 630;">
            <%= image_tag @article.thumbnail_image,
                alt: @article.title,
                class: "w-full h-full object-cover" %>
          </div>
        </div>
      <% end %>

      <!-- メタ情報 -->
      <div class="flex items-center space-x-6 text-sm text-gray-500">
        <time datetime="<%= @article.published_at&.iso8601 %>">
          公開: <%= @article.published_at&.strftime('%Y年%m月%d日') %>
        </time>
        <span>読了時間: 約<%= (strip_tags(@article.content).length / 500).ceil %>分</span>
        <% if @article.updated_at > @article.created_at + 1.day %>
          <time datetime="<%= @article.updated_at.iso8601 %>">
            更新: <%= @article.updated_at.strftime('%Y年%m月%d日') %>
          </time>
        <% end %>
      </div>
    </div>
  </header>

  <div class="container mx-auto px-6 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- メインコンテンツ -->
      <main class="lg:col-span-3">
        <article class="bg-white rounded-xl p-8 shadow-sm">
          <!-- 記事本文 -->
          <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl prose-p:text-gray-700 prose-strong:text-gray-900 prose-code:bg-gray-100 prose-code:px-2 prose-code:py-1 prose-code:rounded prose-code:text-sm prose-pre:bg-gray-100 prose-pre:p-4 prose-pre:rounded-lg prose-table:border prose-th:border prose-td:border prose-blockquote:border-l-4 prose-blockquote:border-blue-500 prose-blockquote:pl-4 prose-blockquote:italic">
            <%= markdown_with_ogp_cards(@article.content) %>
          </div>
          
          <!-- タグ -->
          <% if @article.tags.any? %>
            <div class="mt-8 pt-8 border-t border-gray-200">
              <h3 class="text-lg font-semibold text-gray-900 mb-3">タグ</h3>
              <div class="flex flex-wrap gap-2">
                <% @article.tags.each do |tag| %>
                  <%= link_to blog_path(tag_id: tag.id),
                              class: "bg-gray-200 text-gray-700 text-sm px-3 py-1 rounded-full hover:bg-blue-100 hover:text-blue-700 transition-colors" do %>
                    #<%= tag.name %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
          
          <!-- SNSシェア -->
          <div class="mt-8 pt-8 border-t border-gray-200">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">この記事をシェア</h3>
            <div class="flex space-x-4">
              <a href="https://twitter.com/intent/tweet?url=<%= request.original_url %>&text=<%= @article.title %>" 
                 target="_blank" 
                 class="bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition-colors">
                Twitter
              </a>
              <a href="https://www.facebook.com/sharer/sharer.php?u=<%= request.original_url %>" 
                 target="_blank"
                 class="bg-blue-700 text-white px-4 py-2 rounded-lg hover:bg-blue-800 transition-colors">
                Facebook
              </a>
              <button type="button"
                      data-controller="clipboard"
                      data-clipboard-text-value="<%= request.original_url %>"
                      data-clipboard-message-value="URLをコピーしました！"
                      data-action="click->clipboard#copy"
                      class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition-colors">
                URLコピー
              </button>
            </div>
          </div>
        </article>
        
        <!-- 関連記事 -->
        <% if @related_articles.any? %>
          <section class="mt-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">関連記事</h2>
            <div class="grid grid-cols-1 md:grid-cols-<%= [@related_articles.count, 3].min %> gap-6">
              <% @related_articles.each do |article| %>
                <article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                  <!-- サムネイル画像 -->
                  <% if article.thumbnail_image.attached? %>
                    <%= link_to blog_article_path(article.slug), class: "block" do %>
                      <div class="h-32 bg-gray-200 overflow-hidden">
                        <%= lazy_image_tag article.thumbnail_image,
                            alt: article.title,
                            class: "w-full h-full object-cover hover:scale-105 transition-transform duration-300" %>
                      </div>
                    <% end %>
                  <% else %>
                    <!-- プレースホルダー画像 -->
                    <%= link_to blog_article_path(article.slug), class: "block" do %>
                      <div class="h-32 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                        <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                      </div>
                    <% end %>
                  <% end %>
                  
                  <div class="p-6">
                    <% if article.categories.any? %>
                      <div class="flex gap-2 mb-3">
                        <% article.categories.first(1).each do |category| %>
                          <span class="text-xs font-medium px-2 py-1 rounded text-white"
                                style="background-color: <%= category.color || '#3B82F6' %>;">
                            <%= category.name %>
                          </span>
                        <% end %>
                      </div>
                    <% end %>
                    
                    <h3 class="text-lg font-semibold text-gray-900 mb-2 hover:text-blue-600 transition-colors">
                      <%= link_to article.title, blog_article_path(article.slug) %>
                    </h3>
                    
                    <div class="text-gray-600 text-sm mb-3">
                      <%= truncate(strip_tags(safe_markdown(article.content)), length: 100) %>
                    </div>
                    
                    <time class="text-xs text-gray-500">
                      <%= article.published_at&.strftime('%Y年%m月%d日') %>
                    </time>
                  </div>
                </article>
              <% end %>
            </div>
          </section>
        <% end %>
        
        <!-- ナビゲーション -->
        <div class="mt-8 flex justify-between">
          <%= link_to blog_path, class: "text-blue-600 hover:text-blue-700 font-medium" do %>
            ← Miyakawa Codes Blog
          <% end %>
          
          <%= link_to root_path, class: "text-blue-600 hover:text-blue-700 font-medium" do %>
            ポートフォリオに戻る →
          <% end %>
        </div>
      </main>
      
      <!-- サイドバー -->
      <aside class="lg:col-span-1">
        <!-- 目次 (簡易版) -->
        <div class="bg-white rounded-xl p-6 shadow-sm mb-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">記事情報</h3>
          <dl class="space-y-2 text-sm">
            <dt class="font-medium text-gray-700">公開日</dt>
            <dd class="text-gray-600"><%= @article.published_at&.strftime('%Y年%m月%d日') %></dd>
            
            <dt class="font-medium text-gray-700">読了時間</dt>
            <dd class="text-gray-600">約<%= (strip_tags(@article.content).length / 500).ceil %>分</dd>
            
            <% if @article.categories.any? %>
              <dt class="font-medium text-gray-700">カテゴリ</dt>
              <dd class="text-gray-600">
                <% @article.categories.each do |category| %>
                  <%= link_to category.name, blog_path(category_id: category.id),
                              class: "hover:text-blue-600" %>
                <% end %>
              </dd>
            <% end %>
            
            <% if @article.tech_stack.present? %>
              <dt class="font-medium text-gray-700">技術スタック</dt>
              <dd>
                <div class="flex flex-wrap gap-1 mt-1">
                  <% @article.tech_stack_list.each do |tech| %>
                    <span class="bg-green-100 text-green-800 text-xs font-medium px-2 py-0.5 rounded">
                      <%= tech %>
                    </span>
                  <% end %>
                </div>
              </dd>
            <% end %>
          </dl>
        </div>
        
        <!-- 著者情報 -->
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">著者について</h3>
          <div class="text-center">
            <% if about_section&.active_content&.profile_image&.attached? %>
              <div class="w-16 h-16 rounded-full overflow-hidden shadow-lg mx-auto mb-3">
                <%= lazy_image_tag about_section.active_content.profile_image,
                    alt: "宮川剛のプロフィール写真",
                    class: "w-16 h-16 object-cover rounded-full" %>
              </div>
            <% else %>
              <div class="w-16 h-16 bg-gradient-to-br from-blue-100 to-blue-200 rounded-full flex items-center justify-center mx-auto mb-3">
                <span class="text-xl font-bold text-blue-600">宮</span>
              </div>
            <% end %>
            <h4 class="font-semibold text-gray-900">宮川 剛</h4>
            <p class="text-sm text-gray-600 mt-2">
              要件定義からプログラミングまで一人でできるエンジニア
            </p>
            <div class="mt-4">
              <%= link_to "プロフィールを見る", root_path(anchor: "about"), 
                          class: "text-blue-600 hover:text-blue-700 text-sm font-medium" %>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
  
  <!-- Blog Footer -->
  <footer class="bg-gray-900 text-gray-300 py-8 mt-16">
    <div class="container mx-auto px-6 text-center">
      <p>&copy; 2025 Miyakawa Codes Blog. All rights reserved.</p>
    </div>
  </footer>
</div>
