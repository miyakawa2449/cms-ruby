<% unless params[:q].present? %>
  <!-- 検索ボックス（通常時のみ表示） -->
  <div class="bg-white rounded-lg shadow-sm p-4 mb-6">
    <%= form_with url: blog_path, method: :get, local: true do |f| %>
      <div class="flex flex-col gap-2">
        <%= f.text_field :q,
            placeholder: "記事を検索...",
            class: "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        <%= f.submit "検索", class: "w-full px-4 py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700 cursor-pointer transition-colors lg:hidden" %>
      </div>
    <% end %>
  </div>
<% end %>

<!-- カテゴリ一覧 -->
<div class="bg-white rounded-lg shadow-sm p-6 mb-6">
  <h3 class="font-bold text-lg mb-4">カテゴリ</h3>

  <div class="space-y-1">
    <%= link_to blog_path,
        class: "block px-4 py-2 rounded-lg transition #{params[:category_id].blank? && params[:q].blank? && params[:tag_id].blank? ? 'bg-blue-50 border-l-4 border-blue-500 text-blue-700 font-medium' : 'hover:bg-gray-50 text-gray-700'}" do %>
      <div class="flex items-center justify-between">
        <span>すべての記事</span>
        <span class="text-sm text-gray-500">(<%= @published_articles_count %>)</span>
      </div>
    <% end %>

    <% @categories.each do |category| %>
      <%= link_to blog_path(category_id: category.id),
          class: "block px-4 py-2 rounded-lg transition #{params[:category_id] == category.id.to_s && params[:q].blank? && params[:tag_id].blank? ? 'bg-blue-50 border-l-4 border-blue-500 text-blue-700 font-medium' : 'hover:bg-gray-50 text-gray-700'}" do %>
        <div class="flex items-center justify-between">
          <span><%= category.name %></span>
          <span class="text-sm text-gray-500">(<%= category.article_count.to_i %>)</span>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if params[:category_id].present? && params[:q].blank? && params[:tag_id].blank? %>
    <div class="mt-4 pt-4 border-t">
      <%= link_to blog_path,
          class: "block text-center px-4 py-2 text-blue-600 hover:bg-blue-50 rounded-lg text-sm font-medium transition-colors" do %>
        ✕ カテゴリをクリア
      <% end %>
    </div>
  <% end %>

  <% if params[:q].present? || params[:tag_id].present? %>
    <div class="mt-4 p-3 bg-blue-50 border border-blue-200 rounded-lg text-xs text-blue-800">
      <p class="font-medium mb-1">ℹ️ 検索中</p>
      <p>カテゴリをクリックすると検索条件がクリアされます</p>
    </div>
  <% end %>
</div>

<!-- RSS購読 -->
<div class="bg-white rounded-lg shadow-sm p-6 mb-6">
  <h3 class="font-bold text-lg mb-4">購読する</h3>
  <div class="space-y-2">
    <%= link_to feed_rss_path(format: :rss),
        class: "flex items-center gap-3 px-4 py-3 bg-orange-50 hover:bg-orange-100 rounded-lg transition-colors group",
        target: "_blank",
        rel: "noopener" do %>
      <svg class="w-5 h-5 text-orange-500" fill="currentColor" viewBox="0 0 20 20">
        <path d="M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3z"/>
        <path d="M4 9a1 1 0 011-1 7 7 0 017 7 1 1 0 11-2 0 5 5 0 00-5-5 1 1 0 01-1-1z"/>
        <circle cx="5" cy="15" r="2"/>
      </svg>
      <span class="text-gray-700 group-hover:text-orange-700 font-medium">RSS Feed</span>
    <% end %>
    <%= link_to feed_atom_path(format: :atom),
        class: "flex items-center gap-3 px-4 py-3 bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors group",
        target: "_blank",
        rel: "noopener" do %>
      <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/>
      </svg>
      <span class="text-gray-700 group-hover:text-blue-700 font-medium">Atom Feed</span>
    <% end %>
  </div>
</div>

<!-- 人気タグ -->
<div class="bg-white rounded-lg shadow-sm p-6">
  <h3 class="font-bold text-lg mb-4">人気タグ</h3>
  <div class="flex flex-wrap gap-2">
    <% @tags.first(15).each do |tag| %>
      <%= link_to blog_path(tag_id: tag.id),
          class: "bg-gray-100 text-gray-700 text-sm px-3 py-1 rounded-full hover:bg-blue-100 hover:text-blue-700 transition-colors #{params[:tag_id] == tag.id.to_s && params[:q].blank? && params[:category_id].blank? ? 'bg-blue-100 text-blue-700 font-medium' : ''}" do %>
        #<%= tag.name %> (<%= tag.article_count.to_i %>)
      <% end %>
    <% end %>
  </div>

  <% if params[:tag_id].present? && params[:q].blank? && params[:category_id].blank? %>
    <div class="mt-4 pt-4 border-t">
      <%= link_to blog_path,
          class: "block text-center px-4 py-2 text-blue-600 hover:bg-blue-50 rounded-lg text-sm font-medium transition-colors" do %>
        ✕ タグをクリア
      <% end %>
    </div>
  <% end %>
</div>
