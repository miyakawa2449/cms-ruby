#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  echo "Preparing database..."
  ./bin/rails db:prepare
  
  # Run idempotent seeds when initial data is missing
  # (seeds.rb uses find_or_create_by so re-running is safe)
  if ! ./bin/rails runner "exit (AdminUser.any? && Section.any?) ? 0 : 1" 2>/dev/null; then
    echo "Running database seeds..."
    ./bin/rails db:seed
  fi
fi

exec "${@}"