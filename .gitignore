# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

/app/assets/builds/*
!/app/assets/builds/.keep

/node_modules

# Ignore all daily reports (personal work logs)
/reports/

# Ignore development documentation and planning files
/docs/

# Ignore test files and directories for production deployment
/spec/
/test/

# Ignore development and test backup files
*.backup
*.old
*.new
backup_*.sql
backup_*.json
test_data_backup.json
TOMORROW_*.md
RESTORE_INSTRUCTIONS.md

# Ignore development templates and documentation
/rails_templates/
README.md
CLAUDE.md

# Ignore development config backups
/config/*.backup
/config/*.old
/config/*.new
/docker-compose*.backup
/docker-compose*.old
/docker-compose*.prod.yml
/entrypoint.sh.backup

# Ignore gem and dependency backups
gem_list_*.txt
Gemfile.lock.*.backup

# Ignore development log files in root
*.log

# Ignore key files for decrypting credentials and more.
/config/*.key

.env.production

# ClaudeOnRails
.claude-on-rails/
.claude/
.claude-swarm/
claude-swarm.log
claude-swarm.yml

# Kiro and development tools
.mcp.json
KIRO.md

# Backups
/backups/

# Personal blog drafts
blog_*.md

# macOS
.DS_Store
