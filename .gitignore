# Ruby on Rails .gitignore

# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all environment files (dotenv).
/.env
/.env.*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/credentials/*.key

# Ignore application configuration
/config/application.yml
/config/database.yml
!/config/database.yml.example

# Ignore precompiled assets.
/public/packs
/public/packs-test
/public/assets

# Ignore yarn files
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Ignore Byebug command history file.
.byebug_history

# Ignore node_modules
node_modules/
npm-debug.log*

# Ignore uploads
/public/uploads

# Ignore coverage reports
/coverage/

# Ignore SimpleCov resultset files
/coverage/.resultset.json

# Ignore Spring files.
/spring/*.pid

# Ignore .sass-cache
.sass-cache

# Ignore Capistrano deployment artifacts
/config/deploy/*

# Ignore pow environment settings
.powenv

# Ignore Vagrant
.vagrant

# Ignore RubyMine
/.idea
.idea/

# Ignore vim/neovim files
*.swp
*.swo
*~
.*.swp
.*.swo

# Ignore TextMate
*.tmproj
.tm_properties

# Ignore Sublime Text
*.sublime-workspace
*.sublime-project

# Ignore VS Code
.vscode/
*.code-workspace

# Ignore Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Ignore OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore Docker files
.dockerignore
docker-compose.override.yml

# ===== PROJECT SPECIFIC =====

# API Keys and Secrets (CRITICAL SECURITY)
# Never commit these files containing sensitive information
/config/secrets.yml
/config/application.yml
/config/credentials/production.yml.enc
/config/credentials/staging.yml.enc

# OpenAI API Configuration
/config/openai.yml
/config/ai_settings.yml

# Slack Integration
/config/slack.yml
/config/webhooks.yml

# Email Configuration
/config/email.yml
/config/smtp.yml

# AWS/S3 Configuration
/config/aws.yml
/config/storage.yml

# Google Analytics
/config/analytics.yml

# Backup Files
/backups/*
!/backups/.keep
/db/backups/*
!/db/backups/.keep

# Media Library Uploads (Development)
/public/media/*
!/public/media/.keep
/app/assets/images/uploads/*
!/app/assets/images/uploads/.keep

# Logs and Monitoring
/log/sidekiq.log
/log/openai.log
/log/slack.log
/log/performance.log

# Temporary Build Files
/tmp/build/*
/tmp/cache/*

# Development Database
/db/*.sqlite3
/db/*.sqlite3-*

# Test Files
/spec/tmp/*
/spec/fixtures/files/*
!/spec/fixtures/files/.keep

# Rails 8.0 Specific
/config/importmap.rb.backup
/app/assets/builds/*
/node_modules/

# Tailwind CSS
/app/assets/stylesheets/tailwind.css
/public/assets/tailwind.css

# JavaScript Build
/app/javascript/builds/*

# CLAUDE.md (project memory) - Keep this tracked
# CLAUDE.md should be committed for project continuity

# Documentation exports
/docs/exports/*
!/docs/exports/.keep

# Analysis temporary files
/docs/analysis/temp/*

# Prototype exports (optional - these are tracked)
# /docs/wireframes/ - we want to keep these

# Editor temporary files
*.tmp
*.temp
.#*

# Local environment overrides
/.env.local
/.env.*.local

# Misc
*.log
*.pid
*.seed
*.pid.lock
*.dat
*.out
.rvmrc

# ===== PRODUCTION SPECIFIC =====
# These files contain sensitive production data
/config/production.rb.backup
/config/environments/production.rb.backup

# SSL Certificates (if stored locally)
/config/ssl/*
!/config/ssl/.keep

# Production uploads (should use S3)
/public/production_uploads/*

# ===== NEVER COMMIT =====
# These patterns ensure critical files are never accidentally committed
**/secret*
**/private*
**/*_key*
**/*_secret*
**/*_token*
**/*api_key*
**/*webhook*
**/password*
**/credentials*

# Exclude example files - these should be committed
!**/*.example
!**/*.sample
!**/*.template