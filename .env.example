# ========================================
# DATABASE CONFIGURATION
# ========================================

# PostgreSQL接続設定（Docker環境用）
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_password

# 本番環境用データベース名
PORTFOLIO_DB_NAME=portfolio_production

# データベース完全接続URL（本番環境用）
# DATABASE_URL=postgresql://user:password@host:5432/portfolio_production

# 本番環境SSL証明書（本番環境でのみ必要）
# POSTGRES_SSL_CERT=/path/to/client-cert.pem
# POSTGRES_SSL_KEY=/path/to/client-key.pem
# POSTGRES_SSL_ROOT_CERT=/path/to/ca-cert.pem

# Redis設定
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=your_redis_password_here

# ========================================
# RAILS APPLICATION SETTINGS
# ========================================

# Rails設定
SECRET_KEY_BASE=your_secret_key_base_here
RAILS_MAX_THREADS=20
WEB_CONCURRENCY=2
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true

# ========================================
# AI INTEGRATION SERVICES
# ========================================

# OpenAI API（AI機能用）
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MONTHLY_BUDGET=50

# ========================================
# NOTIFICATION & COMMUNICATION
# ========================================

# Slack Webhook（通知用）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#general
SLACK_ENABLE_NOTIFICATIONS=true

# メール送信設定（SMTP）
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_DOMAIN=localhost
MAIL_FROM=noreply@example.test

# AWS SES v2 API Configuration
AWS_SES_ACCESS_KEY_ID=your_aws_ses_access_key_here
AWS_SES_SECRET_ACCESS_KEY=your_aws_ses_secret_access_key_here
AWS_SES_REGION=ap-northeast-1
MAIL_FROM=noreply@example.test
ADMIN_EMAIL=contact@example.test
CONTACT_EMAIL=contact@example.test
ADMIN_PASSWORD=your_admin_password_here
ADMIN_RESET_PASSWORD=your_admin_reset_password_here
APP_HOST=example.test

# ========================================
# CLOUD STORAGE & CDN
# ========================================

# AWS S3（画像アップロード用）
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-northeast-1
S3_BUCKET_NAME=portfolio-media-files

# ========================================
# SECURITY & MONITORING
# ========================================

# Google reCAPTCHA（お問い合わせフォーム用）
RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here

# Sentry（エラー監視）
SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id

# 管理画面設定
ADMIN_PATH=admin  # 管理画面のパス（セキュリティのため変更可能）

# ========================================
# ANALYTICS & SEO
# ========================================

# Google Analytics（アクセス解析）
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_SEARCH_CONSOLE_KEY=your_search_console_key

# ========================================
# PERFORMANCE & CACHING
# ========================================

# キャッシュ設定
CACHE_ENABLE=true
CACHE_EXPIRES_IN=3600

# Sidekiq設定
SIDEKIQ_CONCURRENCY=5
SIDEKIQ_QUEUES=default,mailers,ai_processing,image_processing

# ========================================
# DEVELOPMENT TOOLS
# ========================================

# Letter Opener（開発環境メール確認）
LETTER_OPENER_ENABLE=true

# デバッグ設定
DEBUG_ENABLE=false
BULLET_ENABLE=true  # N+1クエリ検出
